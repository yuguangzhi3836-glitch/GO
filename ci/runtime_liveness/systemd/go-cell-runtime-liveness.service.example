[Unit]
Description=GO Cell external orchestrator liveness probe
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=go-cell-monitor
Group=go-cell-monitor
EnvironmentFile=/etc/go-cell-runtime-liveness.env
ExecStart=/usr/bin/python3 /opt/go-cell-orchestrator/current/ci/runtime_liveness/probe_external_orchestrator.py --state-file /var/lib/go-cell-runtime-liveness/state.json --timeout-seconds 10 --max-snapshot-age-seconds 30 --max-heartbeat-age-seconds 120
StateDirectory=go-cell-runtime-liveness
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/go-cell-runtime-liveness

