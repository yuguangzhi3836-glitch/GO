        with tempfile.NamedTemporaryFile() as baseline:
          baseline.write(canonical(valid)); baseline.flush(); self.assertEqual(load_baseline(baseline.name)["image_id"],valid["image_id"])
          valid["image_id"]="not-an-image"; baseline.seek(0); baseline.truncate(); baseline.write(canonical(valid)); baseline.flush()
          with self.assertRaises(Reject): load_baseline(baseline.name)
      def test_ambiguous_push_recovery_fails_closed(self):
