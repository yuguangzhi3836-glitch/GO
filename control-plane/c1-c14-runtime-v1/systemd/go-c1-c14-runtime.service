[Unit]
Description=GO C1-C14 Runtime Supervisor
After=network.target

[Service]
Type=simple
User=go-runtime
Group=go-runtime
WorkingDirectory=/opt/go/c1-c14-runtime
ExecStart=/usr/bin/python3 /opt/go/c1-c14-runtime/runner_service.py --db /var/lib/go-c-runtime/runtime.db --tick 5 --watchdog-every 12
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/go-c-runtime

[Install]
WantedBy=multi-user.target
