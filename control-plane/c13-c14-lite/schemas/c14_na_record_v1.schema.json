{
  "$id": "https://go.local/c13c14-lite/c14_na_record_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The NOT_APPLICABLE variant of the C14 record: same record type, verdict fixed to NOT_APPLICABLE, and the scope / basis / rule-version stanza mandatory.",
  "properties": {
    "C14_ROOT": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ai_called": {
      "type": "boolean"
    },
    "ai_execution_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "ai_model": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "ai_provider": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "application_tree": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "authority_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": [
        "string",
        "null"
      ]
    },
    "authorizes_any_action": {
      "const": false
    },
    "blocking_issues": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "candidate_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "cell_id": {
      "const": "C14"
    },
    "decision_origin": {
      "enum": [
        "AI_REVIEW",
        "DETERMINISTIC_PRECHECK"
      ]
    },
    "failure_class": {
      "enum": [
        "QUALITY_FAIL",
        "RULE_FAIL",
        "INFRA_FAILURE",
        "AI_PROVIDER_FAILURE",
        "AI_QUOTA_EXHAUSTED",
        "BLOCKED",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "MAJOR",
              "MINOR",
              "INFO"
            ]
          },
          "statement": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "severity",
          "statement"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "github_run_attempt": {
      "minimum": 1,
      "type": "integer"
    },
    "github_run_id": {
      "minimum": 1,
      "type": "integer"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "issue_number": {
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "issued_at": {
      "format": "date-time",
      "type": "string"
    },
    "ledger_reference": {
      "additionalProperties": false,
      "properties": {
        "cell_id": {
          "enum": [
            "C13",
            "C14"
          ]
        },
        "round_id": {
          "minLength": 1,
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "round_id",
        "cell_id",
        "task_id"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "nonce": {
      "minLength": 16,
      "type": "string"
    },
    "not_applicable": {
      "additionalProperties": false,
      "properties": {
        "applicable_rule_set": {
          "minLength": 1,
          "type": "string"
        },
        "applicable_rule_version": {
          "minLength": 1,
          "type": "string"
        },
        "basis": {
          "minLength": 1,
          "type": "string"
        },
        "review_scope": {
          "minLength": 1,
          "type": "string"
        },
        "why_not_applicable": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "review_scope",
        "basis",
        "applicable_rule_set",
        "applicable_rule_version",
        "why_not_applicable"
      ],
      "type": "object"
    },
    "opinion_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "principal_id": {
      "minLength": 1,
      "type": "string"
    },
    "prompt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "remediation_status": {
      "enum": [
        "OPEN",
        "PARTIAL",
        "CLOSED",
        "NOT_REQUIRED"
      ]
    },
    "review_execution_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "rule_input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "rule_review_scope_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "rule_sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "git_blob_sha": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          },
          "repository_path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "repository_path",
          "git_blob_sha",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "go.c13c14.lite.c14_bundle.v1"
    },
    "task_id": {
      "minLength": 1,
      "type": "string"
    },
    "verdict": {
      "const": "NOT_APPLICABLE"
    },
    "workflow_ref": {
      "minLength": 1,
      "type": "string"
    },
    "workflow_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    }
  },
  "required": [
    "C14_ROOT",
    "ai_called",
    "ai_execution_id",
    "ai_model",
    "ai_provider",
    "application_tree",
    "authority_commit",
    "authorizes_any_action",
    "blocking_issues",
    "candidate_sha",
    "cell_id",
    "decision_origin",
    "failure_class",
    "findings",
    "github_run_attempt",
    "github_run_id",
    "input_sha256",
    "issue_number",
    "issued_at",
    "ledger_reference",
    "nonce",
    "not_applicable",
    "opinion_sha256",
    "principal_id",
    "prompt_sha256",
    "remediation_status",
    "review_execution_id",
    "rule_input_sha256",
    "rule_review_scope_sha256",
    "rule_sources",
    "schema_version",
    "task_id",
    "verdict",
    "workflow_ref",
    "workflow_sha"
  ],
  "title": "go.c13c14.lite.c14_na_record.v1",
  "type": "object"
}
