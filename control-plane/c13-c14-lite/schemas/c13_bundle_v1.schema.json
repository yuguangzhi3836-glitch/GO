{
  "$id": "https://go.local/c13c14-lite/go.c13c14.lite.c13_bundle.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Sealed C13 quality acceptance: machine-test evidence plus one fresh AI review.",
  "properties": {
    "C13_ROOT": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ai_execution_id": {
      "minLength": 1,
      "type": "string"
    },
    "ai_model": {
      "minLength": 1,
      "type": "string"
    },
    "ai_provider": {
      "minLength": 1,
      "type": "string"
    },
    "application_tree": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "authorizes_any_action": {
      "const": false
    },
    "c14_prerequisite": {
      "additionalProperties": false,
      "properties": {
        "c14_candidate_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "c14_remediation_closed": {
          "type": "boolean"
        },
        "c14_root": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "c14_rule_scope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "c14_verdict": {
          "enum": [
            "PASS_SCOPED",
            "FAIL",
            "BLOCKED",
            "NOT_APPLICABLE"
          ]
        }
      },
      "required": [
        "c14_root",
        "c14_verdict",
        "c14_candidate_sha",
        "c14_rule_scope_sha256",
        "c14_remediation_closed"
      ],
      "type": "object"
    },
    "candidate_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "cell_id": {
      "const": "C13"
    },
    "failure_class": {
      "enum": [
        "QUALITY_FAIL",
        "RULE_FAIL",
        "INFRA_FAILURE",
        "AI_PROVIDER_FAILURE",
        "AI_QUOTA_EXHAUSTED",
        "BLOCKED",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "github_run_attempt": {
      "minimum": 1,
      "type": "integer"
    },
    "github_run_id": {
      "minimum": 1,
      "type": "integer"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "issue_number": {
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "issued_at": {
      "format": "date-time",
      "type": "string"
    },
    "junit_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ledger_reference": {
      "additionalProperties": false,
      "properties": {
        "cell_id": {
          "enum": [
            "C13",
            "C14"
          ]
        },
        "round_id": {
          "minLength": 1,
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "round_id",
        "cell_id",
        "task_id"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "machine_job": {
      "additionalProperties": false,
      "properties": {
        "docker_used": {
          "type": "boolean"
        },
        "junit_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "postgres_version": {
          "minLength": 1,
          "type": "string"
        },
        "runner": {
          "minLength": 1,
          "type": "string"
        },
        "runner_os": {
          "minLength": 1,
          "type": "string"
        },
        "stdout_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "test_inventory_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "runner",
        "runner_os",
        "postgres_version",
        "docker_used",
        "test_inventory_sha256",
        "junit_sha256",
        "stdout_sha256",
        "manifest_sha256"
      ],
      "type": "object"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "nonce": {
      "minLength": 16,
      "type": "string"
    },
    "opinion_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "principal_id": {
      "minLength": 1,
      "type": "string"
    },
    "prompt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "quality_findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "MAJOR",
              "MINOR",
              "INFO"
            ]
          },
          "statement": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "severity",
          "statement"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "quality_test_scope_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "remaining_risks": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "review_execution_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "go.c13c14.lite.c13_bundle.v1"
    },
    "stdout_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "type": "string"
    },
    "verdict": {
      "enum": [
        "PASS_SCOPED",
        "FAIL",
        "BLOCKED"
      ]
    },
    "workflow_ref": {
      "minLength": 1,
      "type": "string"
    },
    "workflow_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    }
  },
  "required": [
    "C13_ROOT",
    "ai_execution_id",
    "ai_model",
    "ai_provider",
    "application_tree",
    "authorizes_any_action",
    "c14_prerequisite",
    "candidate_sha",
    "cell_id",
    "failure_class",
    "github_run_attempt",
    "github_run_id",
    "input_sha256",
    "issue_number",
    "issued_at",
    "junit_sha256",
    "ledger_reference",
    "machine_job",
    "manifest_sha256",
    "nonce",
    "opinion_sha256",
    "principal_id",
    "prompt_sha256",
    "quality_findings",
    "quality_test_scope_sha256",
    "remaining_risks",
    "review_execution_id",
    "schema_version",
    "stdout_sha256",
    "task_id",
    "verdict",
    "workflow_ref",
    "workflow_sha"
  ],
  "title": "go.c13c14.lite.c13_bundle.v1",
  "type": "object"
}
