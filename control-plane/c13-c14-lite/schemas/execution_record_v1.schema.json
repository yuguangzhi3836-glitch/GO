{
  "$id": "https://go.local/c13c14-lite/go.c13c14.lite.execution_record.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "How one execution of a cell task is identified: cell + existing task + this GitHub run.",
  "properties": {
    "ai_execution_id": {
      "minLength": 1,
      "type": "string"
    },
    "application_tree": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "id": {
          "minimum": 1,
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "id",
        "digest"
      ],
      "type": "object"
    },
    "authorizes_any_action": {
      "const": false
    },
    "candidate_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "cell_id": {
      "enum": [
        "C13",
        "C14"
      ]
    },
    "evidence_path": {
      "minLength": 1,
      "type": "string"
    },
    "failure_class": {
      "enum": [
        "QUALITY_FAIL",
        "RULE_FAIL",
        "INFRA_FAILURE",
        "AI_PROVIDER_FAILURE",
        "AI_QUOTA_EXHAUSTED",
        "BLOCKED",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "github_run_attempt": {
      "minimum": 1,
      "type": "integer"
    },
    "github_run_id": {
      "minimum": 1,
      "type": "integer"
    },
    "issue_number": {
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "issued_at": {
      "format": "date-time",
      "type": "string"
    },
    "ledger_reference": {
      "additionalProperties": false,
      "properties": {
        "cell_id": {
          "enum": [
            "C13",
            "C14"
          ]
        },
        "round_id": {
          "minLength": 1,
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "round_id",
        "cell_id",
        "task_id"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "principal_id": {
      "minLength": 1,
      "type": "string"
    },
    "review_execution_id": {
      "minLength": 1,
      "type": "string"
    },
    "root_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "go.c13c14.lite.execution_record.v1"
    },
    "task_id": {
      "minLength": 1,
      "type": "string"
    },
    "verdict": {
      "enum": [
        "PASS_SCOPED",
        "FAIL",
        "BLOCKED",
        "NOT_APPLICABLE"
      ]
    },
    "workflow_ref": {
      "minLength": 1,
      "type": "string"
    },
    "workflow_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    }
  },
  "required": [
    "ai_execution_id",
    "application_tree",
    "artifact",
    "authorizes_any_action",
    "candidate_sha",
    "cell_id",
    "evidence_path",
    "failure_class",
    "github_run_attempt",
    "github_run_id",
    "issue_number",
    "issued_at",
    "ledger_reference",
    "principal_id",
    "review_execution_id",
    "root_hash",
    "schema_version",
    "task_id",
    "verdict",
    "workflow_ref",
    "workflow_sha"
  ],
  "title": "go.c13c14.lite.execution_record.v1",
  "type": "object"
}
