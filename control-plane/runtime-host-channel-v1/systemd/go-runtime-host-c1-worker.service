[Unit]
Description=GO Runtime Host C1 AI worker (claims AI_WORK_V1 only; Runtime -> GitHub -> Runtime)
# Deliberately NOT installed inside /opt/go/runtime-host-agent. The Management Agent's
# executor_sha256 is computed over every *.py in that directory and is bound by the
# registration, so adding files there changes the Agent's identity and makes it refuse
# to start with local_executor_mismatch until a new registration is issued. The C1 line
# is its own installation, so the Agent's manifest keeps covering exactly what the Agent
# runs, and nothing here needs a registration rotation.
ConditionPathExists=/opt/go/runtime-host-c1-worker/c1_worker.py
# Fail closed on the credential too: without it the worker could only claim a task it
# cannot execute, which would burn one of that task's attempts. Inactive is correct.
ConditionPathExists=/etc/go-runtime-c1/github-token
After=go-c1-c14-runtime.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=go-runtime
Group=go-runtime
WorkingDirectory=/opt/go/runtime-host-c1-worker
ExecStart=/usr/bin/python3 -B /opt/go/runtime-host-c1-worker/c1_worker.py
Restart=on-failure
RestartSec=5
UMask=0077

# The GitHub dispatch credential, read from a path only this account can reach. It is a
# GitHub credential and NOT a model credential: OPENAI_API_KEY stays a repository secret
# and must never exist on this host.
Environment=C1_GITHUB_TOKEN_PATH=/etc/go-runtime-c1/github-token

# This is the ONE runtime-host component with outbound network access, and it exists only
# to reach api.github.com. The agent and the bridge keep their own restrictions; the
# bridge in particular stays at PrivateNetwork=true. Nothing here listens.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateDevices=true

# Reads the installed Runtime source. Writes only the Runtime state directory (the task
# lease and its Evidence) and its own dispatch outbox. Nothing else is writable.
ReadOnlyPaths=/opt/go/c1-c14-runtime
ReadWritePaths=/var/lib/go-c-runtime /var/lib/go-runtime-c1

[Install]
WantedBy=multi-user.target
