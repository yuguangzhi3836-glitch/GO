AUTHORIZATION_MODE = "request"
GO_REPOSITORY = "git@github.com:yuguangzhi3836-glitch/GO.git"
PR_RESOLVER_KEY = "/etc/go-command-center/keys/github-go-pr-resolver"
# Both already exist and are read-only: the evidence reader was provisioned for the
# evidence repository, and the GO resolver for the candidate pointer. Neither is new
# authority, and neither can write anything.
EVIDENCE_REPO = "git@github.com:chenzhenxi1-sudo/go-control-evidence.git"
EVIDENCE_READER_KEY = "/etc/go-command-center/keys/github-evidence-reader"
EVIDENCE_NAME_RE = re.compile(r"^evidence/[A-Za-z0-9][A-Za-z0-9._-]{0,127}-[A-Za-z0-9_-]{1,128}\.json$")
COMMIT_SHA_RE = re.compile(r"^[0-9a-f]{40}$")
PR_NUMBER_RE = re.compile(r"^[1-9][0-9]{0,8}$")
# A branch name that may be handed to git as an argument.  It is stated by the remote,
# so it is validated before use: a name beginning with `-` would otherwise be read as
# an option rather than as a ref.
DEFAULT_BRANCH_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$")

Reject = deploy_gate.Reject

# --------------------------------------------------------------------------- #
# The automatic post-action VERIFY
# --------------------------------------------------------------------------- #
# Pinned from the executor that produces them: `hk-staging/source/executor/runtime/
# rollback_runtime.py` returns exactly these seven names on success.  A VERIFY derived
# from a rollback whose own gates did not all pass would be derived from a state the
# executor never claimed, so they are asserted rather than the looser "every value is
# PASS" -- the rollback Evidence carries record ids and the source task id beside the
# gates, and the loose rule would refuse every real rollback.
ROLLBACK_RESULT_GATES = ("rollback_source", "lineage", "target_derivation", "fresh_drift",
                         "rollback_record", "fixed_scope", "postcheck")
POST_VERIFY_ACTIONS = (deploy_gate.ACTION, deploy_gate.ROLLBACK_ACTION)
POST_VERIFY_RESULT = {deploy_gate.ACTION: "DEPLOY_OK",
                      deploy_gate.ROLLBACK_ACTION: "ROLLBACK_OK"}
POST_VERIFY_GATES = {deploy_gate.ACTION: deploy_gate.DEPLOY_GATES,
                     deploy_gate.ROLLBACK_ACTION: ROLLBACK_RESULT_GATES}
# Beside the ledger, not inside it.  The ledger's `requests` mapping is read by other
# units to decide which deployment a rollback undoes and which VERIFY is a deployment's
# preflight; a synthesised Task in there would be offered to both, and a post-action
# VERIFY must never be mistaken for either.
POST_VERIFY_STORE = "post-action-verifies.json"
# The Evidence has to still describe the host.  An action that finished longer ago than
# this has a successor, and publishing a VERIFY that asserts the older state would
# manufacture a failure instead of reporting one.
POST_VERIFY_MAX_AGE = dt.timedelta(seconds=1800)
POST_VERIFY_TASK_LIFE = dt.timedelta(minutes=20)
IMAGE_ID = re.compile(r"^sha256:[0-9a-f]{64}$")

def canonical(value): return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()
def now(): return dt.datetime.now(dt.timezone.utc)
def iso(value): return value.isoformat().replace("+00:00", "Z")
def parse_time(value):
    if not isinstance(value, str): raise Reject("requested_at_not_string")
    try: return dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as exc: raise Reject("invalid_requested_at") from exc

def validate_request(raw, at=None):
    if len(raw) > POLICY["max_bytes"]: raise Reject("request_oversized")
    try: request = deploy_gate.parse_json(raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc: raise Reject("malformed_json") from exc
    if not isinstance(request, dict): raise Reject("schema_fields")
    action=request.get('action_id')
    if not isinstance(action,str): raise Reject('action')
    # DEPLOY carries the five common fields and nothing else.  A plan_id used to name a
    # plan a human had written; the plan is derived now, so a caller-chosen name would
    # only be a caller-chosen deployment.  A Request that still carries one is refused by
    # the exact-set comparison below rather than being read as if the field were ignored.
    fields = TEST_ALLOWED if action == TEST_ACTION else ALLOWED
    if set(request) != fields: raise Reject("schema_fields")
    if request["schema_version"] != POLICY["schema_version"]: raise Reject("schema_version")
    if not isinstance(request["request_id"], str) or not REQUEST_ID_RE.fullmatch(request["request_id"]): raise Reject("request_id")
    if request["action_id"] not in {POLICY["action_id"], TEST_ACTION, deploy_gate.ACTION, deploy_gate.ROLLBACK_ACTION, CANARY_ACTION, HEALTH_ACTION}: raise Reject("action")
    if request["environment"] != POLICY["environment"]: raise Reject("environment")
    when = parse_time(request["requested_at"])
    at = at or now()
    if when.tzinfo is None or when > at + dt.timedelta(seconds=60) or at - when > dt.timedelta(seconds=POLICY["max_age_seconds"]): raise Reject("stale_or_future_request")
    if request["action_id"] == TEST_ACTION and (not isinstance(request["pr_number"],str) or not PR_NUMBER_RE.fullmatch(request["pr_number"])): raise Reject("pr_number")
    return request

def load_baseline(path=BASELINE_CONFIG):
    value=json.loads(pathlib.Path(path).read_text())
    required={"version","environment","image_id","evidence_task_id","evidence_commit","evidence_path"}
    if set(value) != required or value["version"] != 1 or value["environment"] != POLICY["environment"]: raise Reject("invalid_authoritative_baseline")
    if not re.fullmatch(r"sha256:[0-9a-f]{64}",value["image_id"]): raise Reject("invalid_authoritative_baseline")
    if not all(isinstance(value[x],str) and value[x] for x in ("evidence_task_id","evidence_commit","evidence_path")): raise Reject("invalid_authoritative_baseline")
    return value
def admitted_canary_binding(admission=None, verify_baseline=None):
    """The candidate binding a CANARY Request may not influence.

    A canary Task names a candidate image, that candidate's sealed package, and the
    image the canary expects to be current.  None of the three may come from a
    Request: the Request is an untrusted proposal and the canary is evidence.

    They are not read from an authority of their own either.  Until this revision the
    canary had its own root-owned candidate file, written by the operator, while DEPLOY
    read the admission record -- two records answering one question, and two answers can
    disagree.  A canary run against a stale record executes a candidate the plan is not
    about, and its Evidence, which is the very thing a deployment plan must cite, then
    describes an image nobody is deploying.  So there is one answer: the canary resolves
    from the admission record DEPLOY resolves its own candidate from, and takes its
    "expected current" from the same join of that record with the root-owned live
    baseline.  A canary can therefore only ever be about a candidate DEPLOY would accept.

    Fail closed, by reusing the DEPLOY gate's existing refusals rather than restating
    them: an admission record that is missing, of the wrong shape, or not a converged
    candidate; a record the live baseline disagrees with; a candidate that does not name
    the signed TEST_PR it was admitted from.  Each raises, so the polling tick reports a
    rejection instead of dying.
    """
    block=plan_derivation.admission_block(read_admission() if admission is None else admission)
    candidate=plan_derivation.candidate_from_admission(block)
    expected=plan_derivation.expected_current_from(block,load_baseline() if verify_baseline is None else verify_baseline)
    plan_derivation.test_pr_task_id(block)
    image=candidate["image_id"]; package=candidate["package_sha256"]
    # The old canary authority refused a malformed image or package rather than sign a
    # Task naming one.  The refusal is kept, with the token the operator already knows,
    # because it is still the canary that would otherwise carry a value it cannot vouch
    # for: the reason moved, the property did not.
    if not deploy_gate.IMAGE.fullmatch(image): raise Reject("invalid_canary_authority")
    if not deploy_gate.SHA.fullmatch(package): raise Reject("invalid_canary_authority")
    return {"candidate_image_id":image,"candidate_package_sha256":package,
            "expected_current_image_id":expected}

def verify_current_image(records,read_evidence=None,authority_key=None,hk_key=None,at=None):
    """The image a manual VERIFY asserts: derived, not hand-kept.

    A VERIFY states a fact -- "the host is running X" -- and asks the host to confirm or
    refute it.  Until this revision that X was read from the root-owned static baseline,
    a hand-kept copy of something the Command Center already derives from signed bytes
    for its own automatic post-action VERIFY.  Two copies of one fact are two answers,
    and the static one has no writer: nothing advances it after a deployment, so it goes
    on describing the image the host ran *before* that deployment, and the next manual
    VERIFY asserts a state the host has already left.  That is the whole of CCV1-308 --
    the host was on e1049b5c, the baseline still said 3652b1d6, the Request produced a
    Task asserting 3652, and the executor refused it, correctly, on the fact it was
    handed.

    The image now comes from where the automatic VERIFY takes it: the newest published
    DEPLOY or ROLLBACK and its signed Evidence, verified against the authority and Hong
    Kong keys.  The static file is demoted to the bootstrap value and is read only when
    no mutating action has ever been published -- the one case with no signed bytes to
    derive from.  It is never preferred over a signed record, and advancing it is no
    longer a step of any deployment.

    There is deliberately no freshness window: `post_verify_target` applies one for the
    automatic VERIFY, where a stale source manufactures a failure about a host the
    action no longer describes, but the question here is "which image is the newest
    signed mutation about", and an older answer is still the newest answer.  A source
    that exists and cannot be turned into an image is refused rather than papered over
    with the static value: asserting the older file is the defect this replaces.
    """
    # The keys are only needed once there is a record to verify, and loading them can
    # fail on a host that has none -- a fresh environment must still be able to serve a
    # VERIFY from its bootstrap value.
    if newest_mutating(records) is None: return load_baseline()["image_id"]
    if read_evidence is None: read_evidence=globals()["read_evidence"]
    if authority_key is None or hk_key is None: authority_key,hk_key=deploy_gate.load_keys()
    _task,_action,image,reason=post_verify_target(records,read_evidence,authority_key,hk_key,at or now(),max_age=None)
    if image is not None: return image
    raise Reject("verify_current_image_unresolved")

def derive(request, image, at=None):
    """The VERIFY Task asserting `image`, the one `verify_current_image` derived.

    Pure: it names the image it was handed and derives nothing.  The image used to be
    read here, from a file, which is how a stale file became a Task asserting the state
    a deployment had already replaced.
    """
    at = at or now(); stamp = at.strftime("%Y%m%dT%H%M%SZ")
    # Seconds alone are insufficient for a persistent channel: two independent
    # PRs can be accepted in one poll.  The request-id digest makes task and
    # release identity deterministic per request without granting caller input
    # control over any deployment parameter.
    suffix=hashlib.sha256(request["request_id"].encode()).hexdigest()[:12]
    unique_stamp=stamp+"-"+suffix
    return {"schema_version":"1", "task_id":"go-boss-request-verify-" + unique_stamp,
      "nonce":secrets.token_urlsafe(24), "issued_at":iso(at), "expires_at":iso(at + dt.timedelta(minutes=15)),
      "authority":"GO-COMMAND-CENTER", "environment":POLICY["environment"], "action_id":POLICY["action_id"],
      "parameters":{"release_id":"boss-request-verify-" + unique_stamp, "candidate_image_id":image, "expected_current_image_id":image}}

def derive_canary(request, baseline, at=None):
    """A candidate canary Task. It takes nothing at all from the Request.

    The Request schema for this action is the five common fields -- no image, no
    package, no service, no path, no env, no command, no plan, no pr_number -- so
    there is no caller-controlled field to pass through.  Every parameter is copied
    from the admitted candidate binding -- the same admission record DEPLOY derives its
    own candidate from -- so two Requests against the same admission can differ only in
    identity and timing, and a canary can never name a candidate DEPLOY would refuse.

    The canary runs the candidate image in an isolated container (no network, read-only
    root, dropped capabilities) and asserts the pre-migration Alembic head.  It mutates
    no business runtime, which is why it does not need the deploy switch.
    """
    at = at or now(); stamp = at.strftime("%Y%m%dT%H%M%SZ")
    suffix = hashlib.sha256(request["request_id"].encode()).hexdigest()[:12]
    unique_stamp = stamp + "-" + suffix
    return {"schema_version":"1", "task_id":"go-boss-request-canary-" + unique_stamp,
      "nonce":secrets.token_urlsafe(24), "issued_at":iso(at), "expires_at":iso(at + dt.timedelta(minutes=15)),
      "authority":"GO-COMMAND-CENTER", "environment":POLICY["environment"], "action_id":CANARY_ACTION,
      "parameters":{"release_id":"boss-request-canary-" + unique_stamp,
                    "candidate_image_id":baseline["candidate_image_id"],
                    "candidate_package_sha256":baseline["candidate_package_sha256"],
                    "expected_current_image_id":baseline["expected_current_image_id"]}}

def sign(task, key_path):
    key = serialization.load_pem_private_key(pathlib.Path(key_path).read_bytes(), password=None)
    signed = dict(task); signed["signature"] = key.sign(canonical(task)).hex(); return signed

def readonly_env(key_path):
    """A git environment that authenticates with one dedicated read-only Deploy Key."""
    env={"PATH":"/usr/bin:/bin","LC_ALL":"C","GIT_TERMINAL_PROMPT":"0","GIT_CONFIG_NOSYSTEM":"1","GIT_CONFIG_GLOBAL":"/dev/null"}
    env["GIT_SSH_COMMAND"]="ssh -i %s -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes" % key_path
    return env

def pr_resolver_env():
    """The GO resolver uses only its dedicated read-only Deploy Key."""
    return readonly_env(PR_RESOLVER_KEY)

def resolve_pr(number):
    if not isinstance(number,str) or not PR_NUMBER_RE.fullmatch(number): raise Reject("pr_number")
    ref="refs/pull/%s/head" % number
    try: lines=git(pr_resolver_env(),"ls-remote",GO_REPOSITORY,ref).stdout.splitlines()
    except (OSError,subprocess.SubprocessError) as exc: raise Reject("pr_resolution_unavailable") from exc
    if len(lines)!=1: raise Reject("pr_head_not_found")
    parts=lines[0].split("\t")
    if len(parts)!=2 or parts[1]!=ref or not COMMIT_SHA_RE.fullmatch(parts[0]): raise Reject("pr_head_invalid")
    return parts[0]

def remote_default_branch(env, repo):
    """The branch a reader gets by default -- asked of the remote, never assumed.

    The Bridge reads two remotes that do not agree on a name, and one of them does not
    carry `main` at all.  Hard-coding the branch here meant the evidence remote could
    never be read: its publication branch is whatever `git clone` checks out for the
    agent that writes it, and that agent's own contract leaves the branch untouched, so
    the name is a property of the remote rather than a constant of this program.  It is
    therefore resolved from the remote and validated before it is passed to git.
    """
    for line in git(env,"ls-remote","--symref",repo,"HEAD").stdout.splitlines():
        parts=line.split("\t")
        if len(parts)==2 and parts[1]=="HEAD" and parts[0].startswith("ref: refs/heads/"):
            name=parts[0][len("ref: refs/heads/"):]
            if DEFAULT_BRANCH_RE.fullmatch(name): return name
    raise Reject("readable_file_unavailable")

def read_repo_file(repo, key_path, path):
    """One file out of a read-only remote, by shallow filtered fetch.

    `--filter=blob:none` keeps the transfer to commits and trees, which is what makes
    this work at all against the GO repository: it carries more than a gigabyte of
    history, and a shallow fetch of it without the filter does not finish inside a poll
    tick.  The single blob this function is actually after is then fetched on demand by
    the `show` below.  No working tree is kept, and the branch is the remote's own
    default rather than a name guessed here.
    """
    work=pathlib.Path(tempfile.mkdtemp(prefix="go-cc-read-")); env=readonly_env(key_path)
    try:
        branch=remote_default_branch(env,repo)
        git(env,"init","-q",str(work)); git(env,"-C",str(work),"remote","add","origin",repo)
        git(env,"-C",str(work),"fetch","-q","--depth","1","--filter=blob:none","origin",branch)
        got=subprocess.run(["/usr/bin/git","-C",str(work),"show","FETCH_HEAD:"+path],
                           env=env,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL)
        if got.returncode!=0: raise Reject("readable_file_unavailable")
        return got.stdout
    except (OSError,subprocess.SubprocessError) as exc:
        raise Reject("readable_file_unavailable") from exc
    finally: subprocess.run(["/usr/bin/rm","-rf",str(work)],check=True)

# --------------------------------------------------------------------------- #
# the local authoritative override (CCV1-121)
# --------------------------------------------------------------------------- #
# Both pointers below are published by the GO repository and read over the network, from
# whatever canonical main says at the moment of the read.  The host's own record of what it
# is running is kept here, root-owned, and for the one environment this Bridge serves that
# record is preferred -- because "which candidate may be deployed" is a fact about this
# environment, established by the signed TEST_PR and the root-owned live baseline, not by
# the branch a pointer happens to sit on.
#
# This is not a bypass, and it is shaped so that it cannot become one:
#
#   * it applies to ONE environment.  Any other environment takes the network read, and
#     therefore takes the network read's refusals.
#   * the file must be root-owned, not a symlink, and not writable by any other identity.
#     A file another identity could rewrite is not an authority.
#   * the candidate digest is RECOMPUTED from the fact itself by the candidate admission
#     component's own implementation -- imported, never re-implemented here, and pinned by
#     content address, so a substituted module is refused rather than used.
#   * a file that is absent, unreadable, of the wrong shape, about another environment, or
#     whose stated digest does not recompute from its own block is IGNORED.  The caller then
#     takes the original path, which refuses exactly as it did before this revision.
#
# Nothing else moves.  The migration graph, the expected current image, the TEST_PR
# binding, the approval join and every other gate read what they always read.
LOCAL_OVERRIDE_DIR = "/etc/go-command-center"
LOCAL_CANDIDATE_OVERRIDE = LOCAL_OVERRIDE_DIR + "/current-candidate-override-v1.json"
LOCAL_RUNTIME_OVERRIDE = LOCAL_OVERRIDE_DIR + "/current-hk-runtime-override-v1.json"
LOCAL_OVERRIDE_ENVIRONMENT = "HK-STAGING-01"
LOCAL_OVERRIDE_VERSION = 1
# The candidate admission component's implementation of the converged digest.  Imported
# rather than copied, and pinned: this host is not allowed to grow a second implementation
# of a rule that already has one.
LOCAL_CANDIDATE_FACT_MODULE = "/usr/local/libexec/candidate_fact.py"
LOCAL_CANDIDATE_FACT_SHA256 = "b378a4724633a963526409ed98dfbfa90a1ab601aa123771edcf4c6567cde0fd"
ADMISSION_POINTER_SCHEMA = "go.depth48.current-candidate.v1"

_LOCAL_CANDIDATE_FACT = None


def _local_candidate_fact():
    """The candidate admission component's own implementation, or raise."""
    global _LOCAL_CANDIDATE_FACT
    if _LOCAL_CANDIDATE_FACT is None:
        raw_module = pathlib.Path(LOCAL_CANDIDATE_FACT_MODULE).read_bytes()
        if hashlib.sha256(raw_module).hexdigest() != LOCAL_CANDIDATE_FACT_SHA256:
            raise Reject("local_override_module_not_authoritative")
        import importlib.util
        spec = importlib.util.spec_from_file_location("_cc_local_candidate_fact",
                                                     LOCAL_CANDIDATE_FACT_MODULE)
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        _LOCAL_CANDIDATE_FACT = module
    return _LOCAL_CANDIDATE_FACT


def _local_override_document(path):
    """A root-owned local override, parsed, or None if it may not be used at all."""
    if POLICY.get("environment") != LOCAL_OVERRIDE_ENVIRONMENT:
        return None
    import stat
    try:
        descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except OSError:
        return None
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode):
            return None
        if info.st_uid != 0:
            return None
        if info.st_mode & 0o022:
            return None
        payload = os.read(descriptor, 1 << 20)
    except OSError:
        return None
    finally:
        os.close(descriptor)
    try:
        document = json.loads(payload.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        return None
    if not isinstance(document, dict):
        return None
    if document.get("version") != LOCAL_OVERRIDE_VERSION:
        return None
    if document.get("environment") != LOCAL_OVERRIDE_ENVIRONMENT:
        return None
    return document


def local_admission_override():
    """The candidate admission record this host states for itself, or None.

    The stated digest is not trusted.  It is recomputed from the block by the candidate
    admission component's own implementation and the two must agree, or the file is not
    used: a record whose digest describes a different candidate than its own block is
    exactly the self-contradictory authority record this refuses to carry.
    """
    document = _local_override_document(LOCAL_CANDIDATE_OVERRIDE)
    if document is None:
        return None
    if document.get("schema") != ADMISSION_POINTER_SCHEMA:
        return None
    block = document.get("release_candidate_v1")
    if not isinstance(block, dict):
        return None
    stated = document.get("candidate_contract_sha256")
    if not isinstance(stated, str) or deploy_gate.SHA.fullmatch(stated) is None:
        return None
    try:
        module = _local_candidate_fact()
        kind = module.classify_document(block)
        module.validate_converged(block)
        recomputed = module.candidate_contract_sha256(block)
    except (OSError, ValueError, AttributeError):
        # Unreadable, unparsable or not a converged fact: the file is not usable, and the
        # original path decides from here.
        return None
    if kind != module.CandidateDigestKind.CONVERGED:
        return None
    if recomputed != stated:
        return None
    return document


def local_runtime_override():
    """The migration graph this host states for itself, or None."""
    document = _local_override_document(LOCAL_RUNTIME_OVERRIDE)
    if document is None:
        return None
    database = document.get("database")
    head = database.get("alembic_head") if isinstance(database, dict) else None
    if not isinstance(head, str) or not head:
        return None
    return document


def read_admission():
    """The candidate admission record, as the GO repository publishes it.

    For the one environment this Bridge serves, the host's own root-owned record is
    preferred over the published pointer; see the override block above for what makes that
    record usable and what happens when it is not (the published pointer, unchanged).
    """
    local = local_admission_override()
    if local is not None:
        return local
    return deploy_gate.parse_json(read_repo_file(
        GO_REPOSITORY, PR_RESOLVER_KEY, plan_derivation.ADMISSION_POINTER))

def read_supported_migration_head():
    """The migration graph the environment currently supports.

    Read from the canonical runtime pointer in the GO repository -- the same
    read-only resolver the candidate pointer already uses, and no new authority --
    rather than from the host or from the Request.  V1 executes no database
    migration, so the graph canonical main declares for this environment is the
    only graph a deployable candidate may declare for it.  A pointer that cannot be
    read, or that carries no head, raises rather than returning something benign:
    an unestablished environment graph must not let a candidate through.
    """
    local = local_runtime_override()
    if local is not None:
        return plan_derivation.environment_migration_head(local)
    return plan_derivation.environment_migration_head(deploy_gate.parse_json(
        read_repo_file(GO_REPOSITORY, PR_RESOLVER_KEY, plan_derivation.RUNTIME_POINTER)))

def read_evidence(task):
    """The signed Evidence of one published Task, addressed by the Task itself.

    The HK agent writes one file per execution named "<task_id>-<nonce>.json", so the
    Task the Bridge signed is what addresses its own result.  That is why the ledger
    holds no Evidence: the lookup key is already signed, and a substituted file cannot
    pass the gate, which re-verifies the signature and binds the content.
    """
    task_id=task.get("task_id"); nonce=task.get("nonce")
