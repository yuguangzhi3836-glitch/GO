def post_verify_path(ledger_root):
    return pathlib.Path(ledger_root)/POST_VERIFY_STORE

def load_post_verifies(ledger_root):
    """The Bridge's own record of the post-action VERIFYs it published.

    Durable for the same reason the ledger is: the act of publishing is what has to be
    remembered, not the intention to publish.  Written with the ledger's own discipline
    -- a mode-0600 temporary and a rename -- so a reader never sees it half-written.
    """
    path=post_verify_path(ledger_root)
    if not path.exists(): return {"version":1,"verifies":{}}
    try: value=deploy_gate.parse_json(path.read_bytes())
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise Reject("post_verify_store_unreadable") from exc
    if (not isinstance(value,dict) or set(value)!={"version","verifies"} or value["version"]!=1
            or not isinstance(value["verifies"],dict)):
        raise Reject("post_verify_store_invalid")
    return value

def save_post_verifies(ledger_root,value):
