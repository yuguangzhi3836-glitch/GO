    fd=os.open(temporary,os.O_WRONLY|os.O_CREAT|os.O_TRUNC|os.O_NOFOLLOW,0o600)
    with os.fdopen(fd,"wb") as stream:
        stream.write(canonical(value)); stream.flush(); os.fsync(stream.fileno())
    os.replace(temporary,path)

def newest_mutating(records):
    """The newest published DEPLOY or ROLLBACK the ledger holds, or None.

    Only the newest, and that is the point: a deployment a later action has replaced has
    no state of its own left to verify.  Asking the host about the older state would
    report a drift this process created, not one it found.
    """
    pairs=[]
    for action in POST_VERIFY_ACTIONS: pairs.extend(plan_derivation.published_pairs(records,action))
    pairs.sort(key=lambda pair:(str(pair[0].get("issued_at") or ""),str(pair[0].get("task_id") or "")),
               reverse=True)
    return pairs[0] if pairs else None

def action_result_proof(action,task,evidence,authority_key,hk_key):
    """What a finished action left behind, from bytes that both signatures cover.

    The DEPLOY half delegates to `deploy_gate.rollback_source_proof`, which already
    verifies a DEPLOY Task and its Evidence this way: the two objects are the same
    whether the next step is a rollback or a VERIFY, so the check is the same check and
    writing a second one could only make them disagree.  It has no freshness window,
    which is why `post_verify_target` applies one of its own.

    There was no equivalent for a ROLLBACK, because until now nothing consumed its
    result.  It is written here to the same shape and with the same steps: both
    signatures, the task/evidence binding, the parameter set the agent itself validates,
    the executor's own result string, the record ids it must have produced, and its own
    gates.  A rollback has no candidate image of its own -- it restores the state the
    source deployment replaced -- so the image is resolved by the caller from the
    source pair, and the record ids that identify that pair are returned here.
    """
    if action==deploy_gate.ACTION:
        proof=deploy_gate.rollback_source_proof(task,evidence,authority_key,hk_key)
        return {"image_id":proof["candidate_image_id"],"completed_at":proof["completed_at"],
                "record_id":proof["record_id"],"record_sha256":proof["record_sha256"]}
    if action!=deploy_gate.ROLLBACK_ACTION: raise Reject("post_verify_action_not_mutating")
    deploy_gate.verify_signed(task,authority_key,"hex")
    deploy_gate.verify_signed(evidence,hk_key,"base64")
    deploy_gate.exact(task,deploy_gate.TASK_FIELDS,"post_verify_task_fields")
    if task["schema_version"]!="1" or task["authority"]!="GO-COMMAND-CENTER":
        raise Reject("post_verify_task_authority")
    if task["action_id"]!=deploy_gate.ROLLBACK_ACTION or task["environment"]!=POLICY["environment"]:
        raise Reject("post_verify_rollback_scope")
    for name in ("task_id","nonce","action_id","environment"):
        if evidence.get(name)!=task[name]: raise Reject("post_verify_proof_binding")
    deploy_gate.exact(task["parameters"],deploy_gate.ROLLBACK_PARAMETERS,"post_verify_rollback_parameters")
    if evidence.get("release_id")!=task["parameters"]["release_id"]:
        raise Reject("post_verify_release_binding")
    source_id=task["parameters"]["source_deploy_task_id"]
    if evidence.get("source_deploy_task_id")!=source_id: raise Reject("post_verify_source_binding")
    if evidence.get("schema_version")!="1" or evidence.get("status")!="SUCCESS":
        raise Reject("post_verify_rollback_not_success")
    if evidence.get("executor_result")!="ROLLBACK_OK": raise Reject("post_verify_rollback_result")
    record_id,record_sha256=evidence.get("rollback_record_id"),evidence.get("rollback_record_sha256")
    source_record=evidence.get("source_deploy_record_id")
    source_record_sha256=evidence.get("source_deploy_record_sha256")
    for name,value in (("rollback_record_id",record_id),("rollback_record_sha256",record_sha256),
                       ("source_deploy_record_id",source_record),
                       ("source_deploy_record_sha256",source_record_sha256)):
        if not isinstance(value,str) or deploy_gate.SHA.fullmatch(value) is None:
            raise Reject("post_verify_record_binding")
    gates=evidence.get("gate_results")
    if not isinstance(gates,dict) or any(gates.get(name)!="PASS" for name in ROLLBACK_RESULT_GATES):
        raise Reject("post_verify_rollback_gate_failed")
    issued=deploy_gate.timestamp(task["issued_at"])
    started=deploy_gate.timestamp(evidence.get("started_at"))
    completed=deploy_gate.timestamp(evidence.get("completed_at"))
    # As with a deployment, `completed <= expires` is deliberately not asserted: the
    # window is the authorisation's, not the work's.
    if not issued<=started<=completed: raise Reject("post_verify_rollback_unbound_time")
    return {"image_id":None,"completed_at":completed,"record_id":record_id,
            "record_sha256":record_sha256,"source_deploy_task_id":source_id,
            "source_deploy_record_id":source_record,
            "source_deploy_record_sha256":source_record_sha256}

def post_verify_target(records,read_evidence,authority_key,hk_key,at,max_age=POST_VERIFY_MAX_AGE):
    """The newest finished action and the image a VERIFY of it would assert.

    Returns `(task, action, image, reason)`.  `image` is None when there is nothing to
    verify and `reason` says why: a pending Evidence is the next tick's work, while a
    superseded or stale action is a decision already taken.  Nothing here reads a
    Request, a caller, or a file this process chose -- the image comes out of the two
    signed objects and, for a rollback, out of the source deployment's own proof.

    `max_age` is the freshness window the *automatic* post-action VERIFY needs: there a
    stale source would manufacture a failure about a host the action no longer
    describes.  A caller that only wants to know which image the newest signed mutation
    is about passes None -- the answer to that question does not expire.
    """
    pair=newest_mutating(records)
    if pair is None: return None,None,None,"no_published_action"
    task,record=pair; action=task["action_id"]
    try: evidence=read_evidence(task)
    except Reject as exc: return task,action,None,"source_evidence_unavailable:%s" % exc
    if not isinstance(evidence,dict): return task,action,None,"source_evidence_unreadable"
    try: proof=action_result_proof(action,task,evidence,authority_key,hk_key)
    except Reject as exc: return task,action,None,"source_proof_refused:%s" % exc
    image=proof.get("image_id")
    if image is None:
        source_id=proof.get("source_deploy_task_id")
        try:
            source_task,_source_record=plan_derivation.pair_by_task_id(
                records,deploy_gate.ACTION,source_id,"post_verify_source_deploy_missing")
        except Reject as exc: return task,action,None,str(exc)
        recorded_sha256=record.get("source_deploy_task_sha256")
        if isinstance(recorded_sha256,str) and recorded_sha256!=deploy_gate.digest(source_task):
            return task,action,None,"source_deploy_task_changed"
        try: source_evidence=read_evidence(source_task)
        except Reject as exc: return task,action,None,"source_deploy_evidence_unavailable:%s" % exc
        try: source_proof=deploy_gate.rollback_source_proof(source_task,source_evidence,authority_key,hk_key)
        except Reject as exc: return task,action,None,"source_deploy_proof_refused:%s" % exc
        if (source_proof["record_id"]!=proof.get("source_deploy_record_id")
                or source_proof["record_sha256"]!=proof.get("source_deploy_record_sha256")):
            return task,action,None,"source_deploy_record_mismatch"
        image=source_proof["expected_current_image_id"]
    if not isinstance(image,str) or IMAGE_ID.fullmatch(image) is None:
        return task,action,None,"image_unresolved"
    if max_age is not None:
        age=at-proof["completed_at"]
        if age>max_age: return task,action,None,"source_stale_seconds:%d" % int(age.total_seconds())
    return task,action,image,None

def derive_post_action_verify(source_task,image,at=None):
    """The VERIFY Task for one finished action.  Pure; the caller signs and publishes it.

    Its parameters are the VERIFY contract's three names and nothing else, because the
    Hong Kong agent refuses any other set: no source task id, no approval, no service,
    no path, no command.  The binding is carried by the values -- `release_id` is derived
    from the action's own Task id, and the image is the one the action's verified bytes
    name -- so one action can only ever produce one VERIFY, and there is no field a
    caller could have supplied.
    """
    at=at or now()
    if not isinstance(image,str) or IMAGE_ID.fullmatch(image) is None: raise Reject("post_verify_image_invalid")
    if not isinstance(source_task,dict) or not isinstance(source_task.get("task_id"),str):
        raise Reject("post_verify_source_missing")
    if source_task.get("action_id") not in POST_VERIFY_ACTIONS: raise Reject("post_verify_action_not_mutating")
    suffix=hashlib.sha256(source_task["task_id"].encode()).hexdigest()[:12]
    release_id="post-%s-verify-%s" % (source_task["action_id"].split("_")[-1].lower(),suffix)
    return {"schema_version":"1","task_id":"go-boss-"+release_id,"nonce":secrets.token_urlsafe(24),
            "issued_at":iso(at),"expires_at":iso(at+POST_VERIFY_TASK_LIFE),
            "authority":"GO-COMMAND-CENTER","environment":POLICY["environment"],
            "action_id":POLICY["action_id"],
            "parameters":{"release_id":release_id,"candidate_image_id":image,
                          "expected_current_image_id":image}}

def adopt_published_verify(raw,authority_key,expected):
    """An already-published VERIFY under this name, if it is this Command Center's.

    A publish can succeed and the store write that records it can still be lost.  The
    Bus is then the authority, exactly as it is for a deployment: the file is accepted
    only if the task identity's own key produced it and it says what this reconciliation
    would have said.  Anything else is a name collision and needs a human.
    """
    try: value=deploy_gate.parse_json(raw)
    except (UnicodeDecodeError, json.JSONDecodeError): return None
    if not isinstance(value,dict) or not isinstance(expected,dict): return None
    if value.get("task_id")!=expected.get("task_id"): return None
    if value.get("parameters")!=expected.get("parameters"): return None
    try: unsigned=deploy_gate.verify_signed(value,authority_key,"hex")
    except Exception: return None
    if unsigned.get("action_id")!=POLICY["action_id"] or unsigned.get("environment")!=POLICY["environment"]:
        return None
    if unsigned.get("authority")!="GO-COMMAND-CENTER": return None
    if unsigned.get("schema_version")!="1" or not isinstance(unsigned.get("nonce"),str): return None
    return {"task_id":unsigned["task_id"],"nonce":unsigned["nonce"],
            "parameters":unsigned["parameters"],"task_sha256":hashlib.sha256(canonical(unsigned)).hexdigest()}

def reconcile_post_action_verifies(ledger_root,key_path,channel,read=None,publish=None,fetch=None,at=None):
    """Publish the one VERIFY the newest finished action still needs.  Idempotent.

    Ordinary outcomes are reported rather than raised: an action whose Evidence has not
    arrived is the next tick's work, and an action already verified must stay verified
    rather than be published again.  A refusal is raised only for a state that needs a
    human -- a Bus task under this name that this Command Center cannot account for.
    """
    read=read_evidence if read is None else read
    publish=publish_task if publish is None else publish
    fetch=remote_task if fetch is None else fetch
    if not isinstance(channel,dict) or channel.get("publish_enabled") is not True:
        raise Reject("post_verify_publish_disabled")
    if POLICY["action_id"] not in (channel.get("allowed_actions") or []):
        raise Reject("post_verify_action_not_enabled_in_channel")
    at=at or now()
    records=ledger_records(ledger_root); store=load_post_verifies(ledger_root)
    pair=newest_mutating(records)
    if pair is None: return {"status":"idle","reason":"no_published_action"}
    source_task,_source_record=pair; source_task_id=source_task["task_id"]
    recorded=store["verifies"].get(source_task_id)
    if isinstance(recorded,dict) and recorded.get("status")=="published":
        return {"status":"present","source_task_id":source_task_id,
                "task_id":recorded.get("task_id"),"image_id":recorded.get("image")}
    authority,hk=deploy_gate.load_keys()
    if isinstance(recorded,dict) and recorded.get("status")=="preparing":
        # A previous tick started this and did not finish recording it.
        existing=fetch(str(recorded.get("task_id") or ""))
        if existing is None:
            store["verifies"].pop(source_task_id,None); save_post_verifies(ledger_root,store)
        else:
            adopted=adopt_published_verify(existing,authority,recorded)
            if adopted is None: raise Reject("ambiguous_post_verify_publish_requires_operator_review")
            store["verifies"][source_task_id]={**recorded,"status":"published","reconciled":True,
                                               "nonce":adopted["nonce"],"task_sha256":adopted["task_sha256"]}
            save_post_verifies(ledger_root,store)
            return {"status":"published_reconciled","source_task_id":source_task_id,
                    "task_id":adopted["task_id"],"image_id":recorded.get("image")}
    task,action,image,reason=post_verify_target(records,read,authority,hk,at)
    if image is None:
        return {"status":"skipped","source_task_id":source_task_id,"source_action":action,"reason":reason}
    unsigned=derive_post_action_verify(task,image,at)
    record={"status":"preparing","task_id":unsigned["task_id"],"parameters":dict(unsigned["parameters"]),
            "image":image,"source_action":action,"source_task_sha256":deploy_gate.digest(task),
            "started_at":iso(at)}
    store["verifies"][source_task_id]=record; save_post_verifies(ledger_root,store)
    signed_task=sign(unsigned,key_path)
    try: commit=publish(signed_task)
    except Reject as exc:
        existing=fetch(unsigned["task_id"])
        if existing is None: raise
        adopted=adopt_published_verify(existing,authority,
                                       {"task_id":unsigned["task_id"],"parameters":unsigned["parameters"]})
        if adopted is None: raise Reject("ambiguous_post_verify_publish_requires_operator_review") from exc
        commit="reconciled"
    store=load_post_verifies(ledger_root)
    store["verifies"][source_task_id]={**record,"status":"published","task_commit":commit,
                                       "published_at":iso(now()),
                                       "task_sha256":hashlib.sha256(canonical(signed_task)).hexdigest()}
    save_post_verifies(ledger_root,store)
    return {"status":"published","source_task_id":source_task_id,"source_action":action,
            "task_id":signed_task["task_id"],"task_commit":commit,"image_id":image,
            "verifies":source_task_id}

def armed_process(number, head, ledger_root, key_path, arm_path):
    arm=load_arm(arm_path); ledger=Ledger(ledger_root); key="%s:%s"%(number,head)
    tx=ledger.transaction(); data=next(tx)
    try:
        existing=data["requests"].get(key)
        if existing:
            if existing.get("status") in {"prepared","publishing"}:
                actual=remote_task(existing["task"]["task_id"])
                if actual == canonical(existing["task"])+b"\n":
                    existing["status"]="published"; arm["state"]="DISARMED_CONSUMED"; arm["publish_enabled"]=False; save_arm(arm_path,arm); return {"status":"published_reconciled","task_id":existing["task"]["task_id"]}
                raise Reject("ambiguous_publish_requires_operator_review")
            return {"status":"already_seen","record":existing}
        proposal=read_pr(number,head)
        if proposal.get("ignored"):
            data["requests"][key]={"status":"ignored","reason":proposal["reason"]}; return {"status":"ignored"}
        request=validate_request(proposal["raw"])
        if request['action_id']!=POLICY['action_id']: raise Reject('legacy_mode_verify_only')
        if request["request_id"] != arm["expected_request_id"] or arm["state"] != "ARMED" or not arm["publish_enabled"]: raise Reject("request_not_currently_armed")
        if any(x.get("request_id")==request["request_id"] for x in data["requests"].values()): raise Reject("duplicate_request_id")
        task=sign(derive(request,verify_current_image(data["requests"])),key_path)
        data["requests"][key]={"status":"prepared","request_id":request["request_id"],"task":task,"task_sha256":hashlib.sha256(canonical(task)).hexdigest()}
    finally:
        try: next(tx)
        except StopIteration: pass
    tx=ledger.transaction(); data=next(tx)
    try: data["requests"][key]["status"]="publishing"
    finally:
        try: next(tx)
        except StopIteration: pass
    task=data["requests"][key]["task"]
    try: commit=publish_task(task)
    except Exception:
        actual=remote_task(task["task_id"])
        if actual != canonical(task)+b"\n": raise Reject("ambiguous_publish_requires_operator_review")
        commit="reconciled"
    actual=remote_task(task["task_id"])
    if actual != canonical(task)+b"\n": raise Reject("published_task_readback_mismatch")
    tx=ledger.transaction(); data=next(tx)
    try: data["requests"][key]["status"]="published"; data["requests"][key]["task_commit"]=commit; arm["state"]="DISARMED_CONSUMED"; arm["publish_enabled"]=False; save_arm(arm_path,arm)
    finally:
        try: next(tx)
        except StopIteration: pass
    return {"status":"published","task_id":task["task_id"],"task_commit":commit}

def derive_and_register_deployment(request,pr,approval_identity,records):
    """Derive this candidate's plan, validate it in memory, register it, read it back.

    Nothing here comes from an operator.  The plan is a join of the candidate admission
    record, the root-owned live baseline, the signed TEST_PR of that exact candidate, and
    the canary and preflight Tasks this Bridge published and signed -- plus the DEPLOY
    Request the authorised identity wrote, which is the approval itself.

    The bundle is validated in memory *before* it is written, so an invalid plan is never
    registered and a bad file never has to be cleaned up; and the context returned comes
    from reading the registered file back, so the Task cites the bytes that are actually
    on disk rather than the ones that happened to be in memory.
    """
    at=now(); approved_at=parse_time(pr["created_at"])
    request_sha256=deploy_gate.request_digest(request)
    plan_id,bundle=plan_derivation.derive(at=at,approval_identity=approval_identity,
        approved_at=approved_at,request_sha256=request_sha256,admission=read_admission(),
        verify_baseline=load_baseline(),
        supported_migration_head=read_supported_migration_head(),
        ledger_records=records,read_evidence=read_evidence)
    authority,hk=deploy_gate.load_keys()
    deploy_gate.validate_bundle(bundle,plan_id,authority,hk,at,approval_identity,request_sha256)
    plan_derivation.register(deploy_gate.STORE,plan_id,bundle)
    return deploy_gate.load_context(plan_id,now(),approval_identity,request_sha256)

def derive_and_register_rollback(request,pr,approval_identity,records):
    """Derive the rollback this Request authorises, from the deployments this Bridge signed.

    There is nothing to register on disk.  `derive_and_register_deployment` writes a plan
    because a plan is a separate object the executor is handed; a rollback's whole content
    is the source pair, which the ledger already holds as a signed Task and the evidence
    repository already holds as a signed Evidence.  Nothing is written here, so nothing
    can be left behind half-written, and the unit needs no new writable path.

    The one thing that cannot be re-derived later is the release id, and it is not
    authority -- it is the name the Task and its Evidence are addressed by.  It is derived
    once here, recorded in the ledger, and re-checked against the ledger before
    publication rather than being derived a second time.
    """
    at=now(); approved_at=parse_time(pr["created_at"])
    request_sha256=deploy_gate.request_digest(request)
    release_id='boss-rollback-'+secrets.token_hex(12)
    authority,hk=deploy_gate.load_keys()
    return plan_derivation.derive_rollback(release_id,request_sha256,approval_identity,
                                           approved_at,records,read_evidence,authority,hk,at)

def channel_v4(value):
    """The persistent channel contract, as a pure function.

    Split out of load_channel so the contract can be verified without a root-owned
    file: "the file must be root-owned and not writable by others" is a property of
    reading it, not of the contract. The action list is still compared for exact
    equality -- one fixed contract rather than a membership test -- so the health
    action cannot be enabled or disabled by hand-editing a field to something the
    Bridge would accept loosely.
    """
    deploy_gate.exact(value,{'version','mode','publish_enabled','allowed_actions','allowed_environment','deployment_authorization'},'channel_fields')
    if value['version']!=4 or value['mode']!='PERSISTENT' or value['publish_enabled'] is not True or value['allowed_environment']!=POLICY['environment']:
        raise Reject('invalid_channel_configuration')
    # The mode is read as a declaration, never as an authorisation, so a value this
    # revision does not implement is accepted here and refused by the DEPLOY path. The
    # split is deliberate: an emergency stop -- setting anything other than `request` --
    # must silence deployments without also silencing the read-only probes.
    if value['allowed_actions']!=CHANNEL_ACTIONS or not isinstance(value['deployment_authorization'],str) or not value['deployment_authorization']:
        raise Reject('invalid_channel_configuration')
    return value

def load_channel(path):
    try: value=deploy_gate.parse_json(pathlib.Path(path).read_bytes())
    except OSError as exc: raise Reject('channel_unavailable') from exc
    if not isinstance(value,dict): raise Reject('invalid_channel_configuration')
    if value.get('version')==4:
        return channel_v4(deploy_gate.parse_json(deploy_gate.read_secure(path)))
    if set(value)=={"version","mode","publish_enabled","allowed_actions","allowed_environment"}:
        if value["version"]!=3 or value["mode"]!="PERSISTENT" or value["publish_enabled"] is not True: raise Reject("invalid_channel_configuration")
        if value["allowed_environment"]!=POLICY["environment"] or value["allowed_actions"] != [POLICY["action_id"],TEST_ACTION]: raise Reject("invalid_channel_configuration")
        return value
    required={"version","mode","publish_enabled","allowed_action_id","allowed_environment"}
    if set(value) != required or value["version"] != 2 or value["mode"] != "PERSISTENT": raise Reject("invalid_channel_configuration")
    if value["publish_enabled"] is not True: raise Reject("persistent_publish_not_enabled")
    if value["allowed_action_id"] != POLICY["action_id"] or value["allowed_environment"] != POLICY["environment"]: raise Reject("invalid_channel_configuration")
    return value


def durable_ledger_records(ledger_root):
    """The durable ledger as it stands on disk right now, not a claim-time snapshot.

    The slot guard reconciles against what was actually published, and its cycle runs
    before the Request loop -- outside any transaction view -- so it has to read the
    document rather than be handed one. `Ledger.save` writes a temporary file and
    renames it over the target, so a reader never observes a partial ledger and needs
    no lock to read one.
    """
    try: return json.loads((pathlib.Path(ledger_root)/"ledger.json").read_text())["requests"]
    except (OSError,ValueError,TypeError,KeyError) as exc: raise Reject("ledger_unavailable") from exc


def slot_store(ledger_root):
    """The environment slot document, beside the ledger it is reconciled against."""
    return pathlib.Path(ledger_root)/deploy_gate.ENVIRONMENT_SLOT_NAME


def environment_slot_cycle(ledger_root):
    """Reconcile the per-environment mutation slots, under the ledger lock.

    Runs before the Request loop so an action that has just reached its terminal
    Evidence hands its environment back in the same tick it is noticed, and so the
    reservations the loop is about to make are checked against a document nothing
    else can be changing.  It publishes nothing and signs nothing: the only thing it
    writes is the slot document itself.
    """
    ledger=Ledger(ledger_root); at=now(); store=slot_store(ledger_root)
    with ledger.held():
        try: records=durable_ledger_records(ledger_root)
        except Reject as exc:
            # An unreadable ledger is not an empty ledger.  Reconciling against one
            # would read every reservation as "its record is gone" and release an
            # environment that may still be busy, so nothing is touched.
            return {"status":"unavailable","reason":str(exc)}
        slots=deploy_gate.load_environment_slots(store)
        if slots is None:
            slots=deploy_gate.activate_environment_guard(records,at,read_evidence)
            deploy_gate.save_environment_slots(slots,store)
            return {"status":"activated","guard_since":slots["guard_since"],
                    "environments":sorted(slots["environments"]),
                    "legacy_adopted":sorted(slots["legacy"].get("adopted") or []),
                    "legacy_ignored":len(slots["legacy"].get("ignored") or [])}
        changes=deploy_gate.reconcile_environment_slots(slots,at,records,read_evidence)
        if changes: deploy_gate.save_environment_slots(slots,store)
        return {"status":"reconciled","changes":changes,
                "held":sorted(name for name,slot in slots["environments"].items()
                              if slot.get("state")!="released")}


def persistent_process(number, head, ledger_root, key_path, channel_path):
    # The immutable root-owned channel config is intentionally checked on every
    # poll.  PR content never controls action, environment, image, or signing.
    channel=load_channel(channel_path); ledger=Ledger(ledger_root); key="%s:%s"%(number,head)
    tx=ledger.transaction(); data=next(tx)
    try:
        existing=data["requests"].get(key)
        if existing:
            if existing.get("status") in {"prepared","publishing"}:
                actual=remote_task(existing["task"]["task_id"])
                if actual == canonical(existing["task"])+b"\n":
                    existing["status"]="published"; existing["task_commit"]="reconciled"
                    return {"status":"published_reconciled","task_id":existing["task"]["task_id"]}
                raise Reject("ambiguous_publish_requires_operator_review")
            return {"status":"already_seen","record":existing}
        proposal=read_pr(number,head)
        if proposal.get("ignored"):
            data["requests"][key]={"status":"ignored","reason":proposal["reason"]}; return {"status":"ignored"}
        request=validate_request(proposal["raw"])
        allowed=channel.get('allowed_actions',[channel.get('allowed_action_id')])
        if request['action_id'] not in allowed: raise Reject('action_not_enabled_in_channel')
        if any(x.get("request_id")==request["request_id"] for x in data["requests"].values()): raise Reject("duplicate_request_id")
        extra={}
        if request['action_id'] in (deploy_gate.ACTION,deploy_gate.ROLLBACK_ACTION):
            # The authorisation is this Request. There is no switch to consult: the
            # configuration only declares the mode. The one declaration covers an
            # executed deployment and its undo alike, so the emergency stop silences
            # both and still leaves the read-only probes alone.
            if channel.get('deployment_authorization')!=AUTHORIZATION_MODE: raise Reject('deployment_authorization_mode_unsupported')
            if proposal['path']!='requests/'+request['request_id']+'.json': raise Reject('request_filename_binding')
            pr,approval_identity=check_deploy_pr(number,head)
        if request['action_id']==deploy_gate.ACTION:
            context=derive_and_register_deployment(request,pr,approval_identity,data['requests'])
            deploy_gate.ensure_unused(context,data['requests'])
            unsigned=derive_deployment(request,context)
            extra={k:v for k,v in context.items() if k not in {'deadline','parameters'}}
        elif request['action_id']==deploy_gate.ROLLBACK_ACTION:
            # Neither an operator nor a caller names the deployment to undo: it is the
            # newest one this Bridge published, read out of the ledger it wrote itself.
            context=derive_and_register_rollback(request,pr,approval_identity,data['requests'])
            deploy_gate.ensure_rollback_unused(data['requests'],context['source_deploy_task_id'])
            unsigned=derive_rollback_task(request,context)
            # `parameters` is kept, unlike the deployment's record: here the derived
            # block *is* the content, so the publish-time recheck compares it directly
            # instead of loading a plan file back.
            extra={k:v for k,v in context.items() if k not in {'deadline','action_id','completed_at'}}
        else: unsigned=derive_formal_task(request,data['requests'])
        task=sign(unsigned,key_path)
        if task['action_id'] in deploy_gate.MUTATING_ACTIONS:
            # One environment, one mutation.  The check and the reservation are here,
            # inside the ledger lock this function already holds, and BEFORE anything
            # is published: that ordering is what makes two ticks -- or two Requests in
            # one tick -- unable to both see an idle environment.  A reservation whose
            # Request never reaches the ledger is released by the next tick's
            # reconciliation, so a crash between these two writes cannot lock the host.
            # The candidate's identity is carried through as the converged content
            # address and is never interpreted here.
            slots=deploy_gate.load_environment_slots(slot_store(ledger_root))
            if slots is None: slots=deploy_gate.activate_environment_guard(data["requests"],now(),read_evidence)
            deploy_gate.ensure_environment_idle(slots,task['environment'])
            parameters=task['parameters']
            deploy_gate.reserve_environment(slots,task['environment'],now(),
                action=task['action_id'],request_key=key,request_id=request['request_id'],
                release_id=parameters.get('release_id'),approval_id=parameters.get('approval_id'),
                plan_id=extra.get('plan_id'),
                candidate_identity=parameters.get('candidate_contract_sha256'),
                candidate_image_id=parameters.get('candidate_image_id'),
                triggered_by=approval_identity)
            deploy_gate.save_environment_slots(slots,slot_store(ledger_root))
        data["requests"][key]={"status":"prepared","request_id":request["request_id"],"task":task,"task_sha256":hashlib.sha256(canonical(task)).hexdigest(),**extra}
    finally:
        try: next(tx)
        except StopIteration: pass
    tx=ledger.transaction(); data=next(tx)
    try: data["requests"][key]["status"]="publishing"
    finally:
        try: next(tx)
        except StopIteration: pass
    task=data["requests"][key]["task"]
    if task['action_id'] in (deploy_gate.ACTION,deploy_gate.ROLLBACK_ACTION):
        # Recheck the Request, the authorisation mode and the exact authorisation after
        # the durable claim, immediately before publication. Never re-sign on failure.
        # The mode is re-read from disk rather than taken from the claim, so suspending
        # deployments stops one that is already in flight.
        record=data['requests'][key]
        if load_channel(channel_path).get('deployment_authorization')!=AUTHORIZATION_MODE: raise Reject('deployment_authorization_mode_unsupported')
        pr_now,identity_now=check_deploy_pr(number,head)
        if identity_now!=record.get('approval_identity'): raise Reject('approval_identity_mismatch')
    if task['action_id']==deploy_gate.ACTION:
        current=deploy_gate.load_context(record['plan_id'],now(),record.get('approval_identity'),record.get('request_sha256'))
        if current['bundle_sha256']!=record['bundle_sha256']: raise Reject('approved_plan_changed')
    if task['action_id']==deploy_gate.ROLLBACK_ACTION:
        # Re-derived from the ledger as it stands now, not read back from a file this
        # process wrote: a deployment that arrived between the claim and the publication
        # changes which deployment is the newest, and a rollback of the older one would
        # no longer be the act the identity authorised.
        authority,hk=deploy_gate.load_keys()
        current=plan_derivation.derive_rollback(record['release_id'],record['request_sha256'],
            record['approval_identity'],parse_time(pr_now['created_at']),ledger_records(ledger_root),
            read_evidence,authority,hk,now())
        if (current['source_deploy_task_sha256']!=record['source_deploy_task_sha256']
            or current['source_deploy_evidence_sha256']!=record['source_deploy_evidence_sha256']
            or current['approval_id']!=record['approval_id']
            or current['parameters']!=record['parameters']):
            raise Reject('rollback_source_changed')
    if task['action_id'] in (deploy_gate.ACTION,deploy_gate.ROLLBACK_ACTION):
        if parse_time(task['expires_at'])<=now()+dt.timedelta(seconds=30): raise Reject('deployment_task_near_expiry')
    try: commit=publish_task(task)
    except Exception:
        actual=remote_task(task["task_id"])
        if actual != canonical(task)+b"\n": raise Reject("ambiguous_publish_requires_operator_review")
        commit="reconciled"
    if remote_task(task["task_id"]) != canonical(task)+b"\n": raise Reject("published_task_readback_mismatch")
    tx=ledger.transaction(); data=next(tx)
    try: data["requests"][key]["status"]="published"; data["requests"][key]["task_commit"]=commit
    finally:
        try: next(tx)
        except StopIteration: pass
    return {"status":"published","task_id":task["task_id"],"task_commit":commit}

def main():
    parser=argparse.ArgumentParser(); parser.add_argument("--once",action="store_true"); parser.add_argument("--ledger-root",default="/var/lib/go-command-center/boss-request-bridge-v1"); parser.add_argument("--key",default="/etc/go-command-center/keys/task-manifest-signing.pem"); parser.add_argument("--channel-config"); parser.add_argument("--environment-slots",action="store_true"); parser.add_argument("--self-test",action="store_true"); args=parser.parse_args()
    if args.self_test: return run_tests()
    if args.environment_slots:
        # Read-only: the same document the guard refuses on, printed for an operator.
        # It is the operator's only way to see who holds an environment, which version
        # they started, and why an abandoned slot has not been released.
        slots=deploy_gate.load_environment_slots(slot_store(args.ledger_root))
        if slots is None: print(json.dumps({"status":"guard_not_activated"},sort_keys=True))
        else: print(json.dumps(slots,sort_keys=True))
        return 0
    if not args.channel_config: raise Reject("persistent_channel_configuration_required")
    # The slot cycle runs BEFORE the Request loop: an action whose terminal Evidence
    # has arrived hands its environment back in the tick that notices it, and the
    # reservations the loop is about to make are checked against a document no other
    # tick can be changing.  A failure here is reported, never raised -- a defect in
    # the guard must not be able to stop every Request in the channel from being served.
    try: slots_cycle=environment_slot_cycle(args.ledger_root)
    except Reject as exc: slots_cycle={"status":"rejected","reason":str(exc)}
    except Exception as exc: slots_cycle={"status":"error","reason":type(exc).__name__}
    result=[]
    for number,head in sorted(discover_heads().items(), key=lambda v:int(v[0])):
        try: result.append({"pr":number,"head":head,**persistent_process(number,head,args.ledger_root,args.key,args.channel_config)})
        except Reject as exc:
            entry={"pr":number,"head":head,"status":"rejected","reason":str(exc)}
            # A refusal that names the environment holding the slot carries the detail
            # on the exception, so the tick says who is deploying and since when
            # without the reason token itself having to be a sentence.
            if getattr(exc,"payload",None) is not None: entry["detail"]=exc.payload
            result.append(entry)
    channel = load_channel(args.channel_config)
    # The post-action VERIFY runs after the Request loop, and a failure in it is reported
    # rather than raised.  It is additive and read-only: a defect here must not be able to
    # stop a DEPLOY or a ROLLBACK Request from being processed, which is what an exception
    # escaping this point would do to every later tick.
    try: post=reconcile_post_action_verifies(args.ledger_root,args.key,channel)
    except Reject as exc: post={"status":"rejected","reason":str(exc)}
    except Exception as exc: post={"status":"error","reason":type(exc).__name__}
    print(json.dumps({"bridge_version":"1.12.0-canary-admission-single-source", "channel_mode":channel["mode"],
                      "publish_enabled":channel["publish_enabled"],
                      "environment_slots":slots_cycle, "post_action_verify":post,
                      "results":result},sort_keys=True)); return 0

