        for extra in ("source_deploy_task_id","release_id","approval_id","image","image_id","candidate_image_id","service","services","path","env","command","plan_id","pr_number","parameters","compose_file","rollback_image","target","production","force_recreate"):
          with self.assertRaises(Reject): validate_request(self.rollback(**{extra:"x"}))
      def test_rollback_wrong_environment_and_unknown_action_are_rejected(self):
        with self.assertRaises(Reject): validate_request(self.rollback(environment="PRODUCTION"))
        with self.assertRaises(Reject): validate_request(self.rollback(action_id="rollback"))
      def test_rollback_task_carries_exactly_the_three_parameters_the_agent_validates(self):
