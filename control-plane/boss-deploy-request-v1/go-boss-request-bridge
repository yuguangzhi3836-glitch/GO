      def test_a_source_is_spent_by_any_published_rollback_that_cites_it(self):
        source="go-boss-deploy-"+"b"*24
        published={"1:"+"a"*40:{"status":"published","task":{"action_id":deploy_gate.ROLLBACK_ACTION,"parameters":{"source_deploy_task_id":source}}}}
        with self.assertRaises(Reject) as caught: deploy_gate.ensure_rollback_unused(published,source)
        self.assertEqual(str(caught.exception),"rollback_source_already_rolled_back")
      def test_an_unpublished_rollback_has_not_spent_its_source(self):
        # The ledger only knows what the Bridge published. A claim that never reached the
        # Bus cannot have reached the host, so it leaves the source usable.
        source="go-boss-deploy-"+"b"*24
        deploy_gate.ensure_rollback_unused({},source)
        for status in ("claiming","prepared","publishing"):
          deploy_gate.ensure_rollback_unused({"2:"+"c"*40:{"status":status,"task":{"action_id":deploy_gate.ROLLBACK_ACTION,"parameters":{"source_deploy_task_id":source}}}},source)
        deploy_gate.ensure_rollback_unused({"3:"+"d"*40:{"status":"published","task":{"action_id":deploy_gate.ACTION,"parameters":{"source_deploy_task_id":source}}}},source)
        deploy_gate.ensure_rollback_unused({"4:"+"e"*40:{"status":"published","task":{"action_id":deploy_gate.ROLLBACK_ACTION,"parameters":{"source_deploy_task_id":"go-boss-deploy-"+"9"*24}}}},source)
      def post_source(self, action=deploy_gate.ROLLBACK_ACTION, task_id=None):
        if task_id is None: task_id=("go-boss-deploy-" if action==deploy_gate.ACTION else "go-boss-rollback-")+"a"*24
        return {"schema_version":"1","task_id":task_id,"nonce":"synthetic-nonce","issued_at":iso(now()),
                "expires_at":iso(now()+dt.timedelta(minutes=5)),"authority":"GO-COMMAND-CENTER",
                "environment":"HK-STAGING-01","action_id":action,"parameters":{}}
      def test_a_post_action_verify_carries_only_the_verify_contract(self):
        image="sha256:"+"a"*64
        task=derive_post_action_verify(self.post_source(),image)
        self.assertEqual(task["action_id"],POLICY["action_id"])
        self.assertEqual(set(task["parameters"]),{"release_id","candidate_image_id","expected_current_image_id"})
        self.assertEqual(task["parameters"]["candidate_image_id"],image)
        self.assertEqual(task["parameters"]["expected_current_image_id"],image)
        self.assertEqual(task["authority"],"GO-COMMAND-CENTER")
        self.assertEqual(task["environment"],"HK-STAGING-01")
      def test_a_post_action_verify_is_structurally_identical_for_both_actions(self):
        # DEPLOY and ROLLBACK differ in which image they left current, not in what is
        # published: one builder, one contract, no branch a caller could steer.
        for action in POST_VERIFY_ACTIONS:
          task=derive_post_action_verify(self.post_source(action),"sha256:"+"b"*64)
          self.assertEqual(set(task["parameters"]),{"release_id","candidate_image_id","expected_current_image_id"})
          self.assertEqual(set(task),{"schema_version","task_id","nonce","issued_at","expires_at",
                                      "authority","environment","action_id","parameters"})
      def test_a_post_action_verify_cannot_name_its_own_image_source_or_service(self):
        for action in POST_VERIFY_ACTIONS:
          task=derive_post_action_verify(self.post_source(action),"sha256:"+"c"*64)
          for forbidden in ("source_deploy_task_id","approval_id","services","target","compose_file",
                            "env_file","executor_path","command","rollback_image","canary_evidence_id",
                            "plan_id","pr_number","candidate_package_sha256","release_candidate_v1"):
            self.assertNotIn(forbidden,task["parameters"])
      def test_one_action_yields_exactly_one_post_action_verify_name(self):
        # The name has to be a function of the action, or a second tick would publish a
        # second probe of the same state under a second name.
        source=self.post_source()
        first=derive_post_action_verify(source,"sha256:"+"d"*64,now())
        second=derive_post_action_verify(source,"sha256:"+"d"*64,now()+dt.timedelta(seconds=41))
        self.assertEqual(first["task_id"],second["task_id"])
        self.assertNotEqual(first["nonce"],second["nonce"])
        # The other direction: a different action leaves a different state behind, so it
        # must not collide onto the first action's name -- the store is keyed on the
        # source task, and one name per source is what keeps a tick from double-publishing.
        other=derive_post_action_verify(self.post_source(deploy_gate.ACTION),"sha256:"+"d"*64)
        self.assertNotEqual(first["task_id"],other["task_id"])
      def test_a_post_action_verify_refuses_an_image_that_is_not_a_digest(self):
        for bad in ("","6b92050e","sha256:zz","sha256:"+"a"*63,None,"sha256:"+"A"*64):
          with self.assertRaises(Reject): derive_post_action_verify(self.post_source(),bad)
      def test_a_post_action_verify_refuses_an_action_that_mutates_nothing(self):
        # Exactly two actions leave a state behind.  A VERIFY, a TEST_PR, a canary, a
        # liveness probe and an unknown name have no result to verify, so none of them
        # may reach the builder -- and the two that do are named in one place.
        self.assertEqual(set(POST_VERIFY_ACTIONS),{deploy_gate.ACTION,deploy_gate.ROLLBACK_ACTION})
        for action in (POLICY["action_id"],TEST_ACTION,CANARY_ACTION,HEALTH_ACTION,"HK_STAGING_DEPLOY_V2"):
          with self.assertRaises(Reject): derive_post_action_verify(self.post_source(action),"sha256:"+"a"*64)
