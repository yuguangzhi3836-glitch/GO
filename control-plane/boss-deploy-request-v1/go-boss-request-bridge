          tasks={}
          try:
            globals()["read_pr"]=lambda n,h:{"path":"requests/canary-hk-staging-987654.json","raw":self.canary()}
            globals()["load_channel"]=lambda p:{"version":4,"mode":"PERSISTENT","publish_enabled":True,"allowed_actions":CHANNEL_ACTIONS,"allowed_environment":"HK-STAGING-01","deployment_authorization":"suspended"}
            globals()["load_canary_baseline"]=lambda _orig=saved["load_canary_baseline"], _path=authority.name: _orig(_path)
            globals()["publish_task"]=lambda task:(tasks.setdefault(task["task_id"],canonical(task)+b"\n") and "commit")
            globals()["remote_task"]=lambda task_id:tasks.get(task_id)
            out=persistent_process("43","c"*40,root,key.name,"channel-not-read")
            self.assertEqual(out["status"],"published")
          finally:
            deploy_gate.load_context=original_context
            for name,value in saved.items(): globals()[name]=value
          ledger=json.loads(pathlib.Path(root,"ledger.json").read_text())
          record=ledger["requests"]["43:"+"c"*40]
          for field in ("plan_id","approval_identity","bundle_sha256","plan","approval"):
            self.assertNotIn(field,record)
          self.assertEqual(record["status"],"published")
      def rollback(self, **x):
        value={"schema_version":"1","request_id":"rollback-hk-staging-987654","action_id":deploy_gate.ROLLBACK_ACTION,"environment":"HK-STAGING-01","requested_at":iso(now())}; value.update(x); return canonical(value)
      def rollback_context(self):
        return {"deadline":now()+dt.timedelta(minutes=5),
                "parameters":{"release_id":"boss-rollback-"+"a"*24,
                              "source_deploy_task_id":"go-boss-deploy-"+"b"*24,
                              "approval_id":"approval-rollback-"+"c"*16}}
      def test_rollback_request_is_accepted_and_carries_nothing_else(self):
        request=validate_request(self.rollback()); self.assertEqual(request["action_id"],deploy_gate.ROLLBACK_ACTION)
        self.assertEqual(set(request),ALLOWED)
      def test_rollback_request_with_any_parameter_is_rejected(self):
        # A caller may name neither the deployment to undo nor anything the undo touches:
        # the source is derived from the ledger and the eight images come from the source
