    name addresses the run, the Task file and the Evidence file that reports it.
    """
    at = at or now(); release_id = context['parameters']['release_id']
    return {'schema_version':'1','task_id':'go-'+release_id,'nonce':secrets.token_urlsafe(24),
      'issued_at':iso(at),'expires_at':iso(context['deadline']),'authority':'GO-COMMAND-CENTER',
      'environment':POLICY['environment'],'action_id':deploy_gate.ROLLBACK_ACTION,
      'parameters':dict(context['parameters'])}

def check_deploy_pr(number,head):
    """Read PR metadata using a server-only, read-only request-repository token."""
    import urllib.request
    if not PR_NUMBER_RE.fullmatch(str(number)) or not COMMIT_SHA_RE.fullmatch(head): raise Reject('request_pr_identity')
    token=deploy_gate.read_secure('/etc/go-command-center/keys/github-requests-reader.token',4096).decode().strip()
    if not token or any(c.isspace() for c in token): raise Reject('request_reader_credential_invalid')
    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self,*args,**kwargs): raise Reject('request_api_redirect')
    request=urllib.request.Request('https://api.github.com/repos/chenzhenxi1-sudo/go-control-tasks/pulls/'+str(number),
        headers={'Authorization':'Bearer '+token,'Accept':'application/vnd.github+json','X-GitHub-Api-Version':'2022-11-28'})
    try:
        with urllib.request.build_opener(NoRedirect()).open(request,timeout=15) as response:
            raw=response.read(262145)
        if len(raw)>262144: raise Reject('request_metadata_oversized')
        value=deploy_gate.parse_json(raw)
    except Exception as exc: raise Reject('request_metadata_unavailable') from exc
    if (not isinstance(value,dict) or not all(isinstance(value.get(k),dict) and isinstance(value[k].get('repo'),dict) for k in ('head','base'))
        or value.get('state')!='open' or value.get('draft') is not False or value.get('merged') is not False
        or value.get('base',{}).get('ref')!='main' or value.get('base',{}).get('repo',{}).get('full_name')!='chenzhenxi1-sudo/go-control-tasks'
        or value.get('head',{}).get('repo',{}).get('full_name')!='chenzhenxi1-sudo/go-control-tasks'
        or value.get('head',{}).get('sha')!=head): raise Reject('request_pr_not_open_exact_head')
    # The approval authority is who GitHub says authored this pull request. The
    # reader token above reads GitHub's own answer, so an unauthorised author is
    # refused here and never reaches the plan.
    login=value.get('user',{}).get('login')
    if not isinstance(login,str) or login not in deploy_gate.APPROVAL_IDENTITIES:
        raise Reject('request_pr_author_not_authorised')
    # When the platform says the approval was given. This is a fact read from GitHub
    # rather than a timestamp an approver writes, which is what lets the approval window
    # stay exactly as strict as it was: the approval must still be younger than 15
    # minutes and later than both proofs.
    created=value.get('created_at')
    if not isinstance(created,str): raise Reject('request_pr_created_at_missing')
    try: moment=dt.datetime.fromisoformat(created.replace('Z','+00:00'))
    except ValueError as exc: raise Reject('request_pr_created_at_invalid') from exc
    if moment.tzinfo is None: raise Reject('request_pr_created_at_invalid')
    return value,login

class Ledger:
    def __init__(self, root): self.root = pathlib.Path(root); self.root.mkdir(mode=0o700, parents=True, exist_ok=True); self.path=self.root/"ledger.json"; self.lock=self.root/"ledger.lock"
    def transaction(self):
        handle=open(self.lock, "a+"); fcntl.flock(handle, fcntl.LOCK_EX)
        try:
            data=json.loads(self.path.read_text()) if self.path.exists() else {"version":1,"requests":{}}
            yield data
            self.save(data)
        finally: fcntl.flock(handle, fcntl.LOCK_UN); handle.close()
    def save(self,data):
        temp=self.root/'ledger.tmp'
        fd=os.open(temp,os.O_WRONLY|os.O_CREAT|os.O_TRUNC|os.O_NOFOLLOW,0o600)
        with os.fdopen(fd,'wb') as stream:
            stream.write(canonical(data));stream.flush();os.fsync(stream.fileno())
        os.replace(temp,self.path)
        fd=os.open(self.root,os.O_RDONLY|os.O_DIRECTORY)
        try: os.fsync(fd)
        finally: os.close(fd)
    @contextlib.contextmanager
    def held(self):
        """The ledger lock alone, without the read-modify-write.

        The environment slots are a second durable document that has to be read and
        written in the same critical section as the ledger, so that a slot cannot be
        reserved on a view of the world another tick has already changed.  It is the
        same lock file `transaction()` uses, so the two cannot overlap.
        """
        handle=open(self.lock, "a+"); fcntl.flock(handle, fcntl.LOCK_EX)
        try: yield
        finally: fcntl.flock(handle, fcntl.LOCK_UN); handle.close()

def git(env, *argv, cwd=None): return subprocess.run(["/usr/bin/git", *argv], cwd=cwd, env=env, check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)

def ledger_records(ledger_root):
    """The durable ledger as it stands on disk right now, not a claim-time snapshot.

    The publish-time recheck needs to see what the ledger actually holds: another
    deployment published between the claim and the publication is exactly the thing that
    changes which deployment a rollback would undo, and the snapshot this process loaded
    when it took the claim cannot show it.  `Ledger.save` writes a temporary file and
    renames it over the target, so a reader never observes a partial ledger and needs no
    lock to read one.
    """
    try: return json.loads((pathlib.Path(ledger_root)/"ledger.json").read_text())["requests"]
    except (OSError,ValueError,TypeError,KeyError) as exc: raise Reject("ledger_unavailable") from exc
def ssh_env():
    env=os.environ.copy(); env["GIT_SSH_COMMAND"]="ssh -i /etc/go-command-center/keys/github-tasks-writer -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes"; return env
def discover_heads():
    output=git(ssh_env(), "ls-remote", REPO, "refs/pull/*/head").stdout.splitlines(); heads={}
    for line in output:
        sha, ref=line.split("\t",1); number=ref.split("/")[2]; heads[number]=sha
    return heads
def request_path_from_changes(changes):
    """Accept only one added Request JSON file; every other PR diff is ignored."""
    if len(changes) != 1: return None
    parts=changes[0].split("\t")
    if len(parts) != 2 or parts[0] != "A" or not REQUEST_RE.fullmatch(parts[1]): return None
    return parts[1]
def read_pr(number, head):
    work=pathlib.Path(tempfile.mkdtemp(prefix="go-boss-request-")); env=ssh_env()
    try:
        git(env,"init","-q",str(work)); git(env,"-C",str(work),"remote","add","origin",REPO)
        git(env,"-C",str(work),"fetch","-q","--depth","128","origin","main:refs/bridge/main","refs/pull/%s/head:refs/bridge/head" % number)
        actual=git(env,"-C",str(work),"rev-parse","refs/bridge/head").stdout.strip()
        if actual != head or discover_heads().get(str(number)) != head: raise Reject("pr_head_changed")
        # Main may advance with unrelated formal Tasks after the Request fork.
        # Compare from the actual common ancestor; never misclassify them as PR deletions.
        base=git(env,'-C',str(work),'merge-base','refs/bridge/main','refs/bridge/head').stdout.strip()
        if not COMMIT_SHA_RE.fullmatch(base): raise Reject('request_merge_base_unavailable')
        changes=git(env,"-C",str(work),"diff","--name-status",base,'refs/bridge/head').stdout.splitlines()
        path=request_path_from_changes(changes)
        if not path: return {"ignored":True,"reason":"non_request_or_extra_files"}
        raw=git(env,"-C",str(work),"show","refs/bridge/head:"+path).stdout.encode()
        return {"path":path,"raw":raw}
    except (OSError,subprocess.SubprocessError) as exc: raise Reject('request_git_unavailable') from exc
    finally:
        __import__('shutil').rmtree(work)

def process(number, head, ledger_root, key_path, reader=read_pr):
    ledger=Ledger(ledger_root); key="%s:%s" % (number,head)
    tx=ledger.transaction(); data=next(tx)
    try:
        if key in data["requests"]:
            record=data["requests"][key]
            if record.get("status") == "claiming": raise Reject("ambiguous_claim_requires_operator_review")
            return {"status":"already_seen","record":record}
        proposal=reader(number,head)
        if proposal.get("ignored"):
            data["requests"][key]={"status":"ignored","reason":proposal["reason"]}; return {"status":"ignored"}
        if not REQUEST_RE.fullmatch(proposal["path"]): raise Reject("request_path")
        request=validate_request(proposal["raw"])
        if request['action_id']!=POLICY['action_id']: raise Reject('legacy_mode_verify_only')
        for record in data["requests"].values():
            if record.get("request_id")==request["request_id"]: raise Reject("duplicate_request_id")
        data["requests"][key]={"status":"claiming","request_id":request["request_id"]}
        temp=ledger.root/"ledger.tmp"; temp.write_bytes(canonical(data)); os.chmod(temp,0o600); os.replace(temp,ledger.path)
        preview=sign(derive(request,"sha256:"+"0"*64),key_path)
        data["requests"][key]={"status":"dry_run_consumed","request_id":request["request_id"],"task_id":preview["task_id"],"task_sha256":__import__("hashlib").sha256(canonical(preview)).hexdigest(),"publish_enabled":False}
        return {"status":"dry_run_consumed","task_id":preview["task_id"],"publish_enabled":False}
    finally:
        try: next(tx)
        except StopIteration: pass

