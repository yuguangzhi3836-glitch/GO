# the document
# --------------------------------------------------------------------------- #
def evaluate(control_state, go_repo, bundle_dir, at, generated_at):
    inputs = Inputs(control_state, go_repo, bundle_dir, at)
    gates = [gate_approved_candidate(inputs), gate_source_binding(inputs),
             gate_package_binding(inputs), gate_deployment_plan(inputs),
             gate_human_approval(inputs, at), gate_test_pr(inputs), gate_verify(inputs),
             gate_current_runtime(inputs), gate_live_deploy_mode(inputs),
             gate_deployment_authorization(inputs), gate_canary(inputs),
             gate_bridge_acceptance(inputs)]
    order = {name: index for index, name in enumerate(MANDATORY_GATES + ADVISORY_GATES)}
    gates.sort(key=lambda g: order[g["gate"]])

    mandatory = [g for g in gates if g["mandatory"]]
    failed = [g["gate"] for g in mandatory if g["state"] == "FAIL"]
    unknown = [g["gate"] for g in mandatory if g["state"] == "UNKNOWN"]
    advisory_failed = [g["gate"] for g in gates
                       if not g["mandatory"] and g["state"] != "PASS"]

    if failed:
        verdict, reason = "NO", ("mandatory gates failed: %s" % ", ".join(failed))
    elif unknown:
        # An unprovable mandatory gate is never an inferred yes.
        verdict, reason = "UNKNOWN", ("mandatory gates could not be established: %s"
                                      % ", ".join(unknown))
    else:
        verdict, reason = "YES", ("every mandatory gate passes; this is an observation about the "
                                  "evidence, not an approval, and it authorises nothing")

    blocking = [{"gate": g["gate"], "state": g["state"], "reason": g["reason"],
                 **({"observed": g["observed"]} if "observed" in g else {}),
                 **({"expected": g["expected"]} if "expected" in g else {})}
                for g in mandatory if g["state"] != "PASS"]
    advisories = [{"gate": g["gate"], "state": g["state"], "reason": g["reason"],
                   **({"observed": g["observed"]} if "observed" in g else {})}
                  for g in gates if not g["mandatory"] and g["state"] != "PASS"]

    return {
        "schema_version": "1",
        "contract": CONTRACT_NAME,
        "scope": "READ_ONLY_DEPLOY_READINESS",
        "authority": "DERIVED_NON_AUTHORITATIVE",
        "generated_at": iso(generated_at),
        "as_of": iso(at),
        "verdict": {"deploy_ready": verdict, "reason": reason,
                    "mandatory_gates": len(mandatory), "failed": failed, "unknown": unknown,
                    "advisory_failed": advisory_failed},
        "inputs": {"control_state": {
                       "repository": ((inputs.state.get("sources") or {}).get("go") or {}).get("repository"),
                       "ref": None,
                       "head_sha": None},
                   "go_repository": None if inputs.go_repo is None else inputs.go_repo.name,
                   "candidate_pointer": inputs.go_source.get("canonical_candidate_pointer"),
                   "runtime_pointer": inputs.go_source.get("canonical_runtime_pointer"),
                   "live_bundle": {"supplied": inputs.bundle is not None,
                                   "files": inputs.bundle_files,
                                   "plan_id": (inputs.plan_body() or {}).get("plan_id"),
                                   "note": ("live Command Center facts are read only from this "
                                            "operator-supplied bundle; the evaluator never contacts "
                                            "a host")}},
        "identity": inputs.identities.report(),
        "gates": gates,
        "blocking_reasons": blocking,
        "advisory_holds": advisories,
        "not_evaluated": {"rollback_readiness": "NOT_IN_SCOPE",
                          "note": ("CC V1-09 / #104 owns rollback eligibility. This evaluator "
                                   "answers deploy readiness only and says so instead of guessing")},
        "authority_boundary": dict(AUTHORITY_BOUNDARY),
        "notes": [
            "YES is not an approval. Human Approval is a separate named gate and it is the only "
            "thing in this document that can carry one.",
            "UNKNOWN is a first-class answer: a mandatory gate nobody could establish keeps the "
            "verdict out of YES rather than being rounded up.",
            "Every gate is mandatory. CANARY blocks the verdict because the live Bridge "
            "blocks on it: a readiness verdict that could say YES while the request would be "
            "refused is worse than no verdict.",
            "There is no RELEASE_GATES gate. The four product-release declarations the plan "
            "used to carry were removed from the deploy contract: they belong to the upstream "
            "side, no machine process here can produce them, and the live executor never read "
            "them. The deployability fact one of them named is now the sealed TEST_PR, which "
            "the ported TEST_PR proof checks.",
            "BRIDGE_ACCEPTANCE re-runs the live Bridge's own bundle rules. It exists so that YES "
            "means 'the request would be accepted', and it names the rule that would refuse "
            "otherwise.",
            "The Human Approval authority must be a different key from the Task signer. If the "
            "published identities express one key in both roles, no approval is reported as "
            "proven.",
            "There is no deploy switch, and no LIVE_SWITCH_PROVENANCE gate. A deployment is "
            "authorised by the authenticated DEPLOY Request, so DEPLOYMENT_AUTHORIZATION "
            "requires the plan's authorisation to be derived from an exact Request rather "
            "than chosen, and LIVE_DEPLOY_MODE reads whether the deployed configuration "
            "accepts request-authorised deployments at all. A standing authorisation is not "
            "expressible in this contract.",
            "Nothing here creates, signs or publishes a Task, and nothing here can grant a "
            "deployment authorisation.",
        ],
    }


