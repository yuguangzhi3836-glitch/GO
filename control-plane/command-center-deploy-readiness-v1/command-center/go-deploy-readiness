            encoding="utf-8")
        (go / "CURRENT_HK_RUNTIME.json").write_text(json.dumps(
            {"image_config_id": "sha256:" + "e" * 64, "image_tag": "synthetic",
             "host": "i-synthetic", "runtime_generation": "SYNTHETIC"}), encoding="utf-8")
        state = {
            "schema_version": "1", "contract": STATE_CONTRACT,
            "sources": {"go": {"repository": "yuguangzhi3836-glitch/GO",
                               "canonical_candidate_pointer":
                                   "docs/canonical-baseline/CURRENT_CANDIDATE.json",
                               "canonical_runtime_pointer":
                                   "docs/canonical-baseline/CURRENT_HK_RUNTIME.json",
                               "head_sha": "0" * 40}},
            "freshness": {"live_verification_window_seconds": 86400},
            "control_state": {
                "live_verified_runtime": {"state": "PROVEN", "value": {
                    "image_config_id": "sha256:" + "e" * 64, "age_seconds": 60,
                    "verified_at": "2026-09-15T00:30:00Z"}},
                "repository_runtime_pointer": {"value": {"image_config_id": "sha256:" + "e" * 64}},
                "runtime_verification_state": "MATCH"},
            "tasks": [{"task_id": "synthetic-test-pr", "action_id": "HK_STAGING_TEST_PR",
                       "issued_at": "2026-09-15T00:10:00Z", "lifecycle": "COMPLETE",
                       "parameters": {"source": {"commit_sha": commit}},
                       "evidence": {"status": "SUCCESS", "source": {"path": "evidence/t.json"}}}]}
        state_path = root / "CURRENT_CONTROL_STATE.json"
        state_path.write_text(json.dumps(state), encoding="utf-8")

        at = dt.datetime(2026, 9, 15, 1, 0, 0, tzinfo=dt.timezone.utc)
        generated = at + dt.timedelta(seconds=1)

        absent = root / "no-bundle"
        absent.mkdir()
        document = evaluate(state_path, None, None, at, generated)
        check("no_input_still_produces_a_document", document["contract"] == CONTRACT_NAME)
        check("no_input_is_never_yes", document["verdict"]["deploy_ready"] != "YES")
        check("no_repository_makes_the_candidate_unreadable",
              "APPROVED_CANDIDATE" in document["verdict"]["failed"])
        document = evaluate(state_path, root / "GO", None, at, generated)
        check("candidate_read_without_a_bundle_is_unknown_not_no",
              document["verdict"]["deploy_ready"] == "UNKNOWN"
              and document["verdict"]["failed"] == [],
              document["verdict"])
        check("every_gate_is_reported", len(document["gates"]) == len(MANDATORY_GATES))
        check("identity_absent_is_declared",
              document["identity"]["roles"]["TASK"]["binding"] != "BOUND")
        check("canary_blocks_when_unknown", "CANARY" in document["verdict"]["unknown"])

        channel_only = root / "channel-only"
        channel_only.mkdir()
        (channel_only / "channel.json").write_text(json.dumps(
            {"version": 4, "mode": "PERSISTENT", "publish_enabled": True,
             "allowed_actions": ["HK_STAGING_VERIFY", "HK_STAGING_TEST_PR", "HK_STAGING_DEPLOY"],
             "allowed_environment": ENVIRONMENT, "deployment_authorization": "request"}),
            encoding="utf-8")
        document = evaluate(state_path, None, channel_only, at, generated)
        mode = [g for g in document["gates"] if g["gate"] == "LIVE_DEPLOY_MODE"][0]
        authorization = [g for g in document["gates"]
                         if g["gate"] == "DEPLOYMENT_AUTHORIZATION"][0]
        check("the_mode_is_accepted_and_authorises_nothing", mode["state"] == "PASS"
              and authorization["state"] == "UNKNOWN")
        check("an_unestablished_authorization_can_never_be_yes",
              document["verdict"]["deploy_ready"] != "YES")

        # The retired switch change record is not a bundle file any more, so a directory
        # that still carries one names two candidate plans and is refused as ambiguous
        # rather than being read as if the switch still existed.
        retired = root / "retired-record"
        retired.mkdir()
        (retired / "channel.json").write_text(json.dumps(
            {"version": 4, "mode": "PERSISTENT", "publish_enabled": True,
             "allowed_actions": ["HK_STAGING_VERIFY", "HK_STAGING_TEST_PR", "HK_STAGING_DEPLOY"],
             "allowed_environment": ENVIRONMENT, "deployment_authorization": "request"}),
            encoding="utf-8")
        (retired / "switch-provenance.json").write_text(json.dumps(
            {"schema_version": "1", "field": "deployment_requests_enabled"}), encoding="utf-8")
        document = evaluate(state_path, None, retired, at, generated)
        check("the_retired_switch_record_is_no_longer_a_bundle_file",
              document["verdict"]["deploy_ready"] != "YES")

    if failures:
        print("SELFTEST FAILED: %s" % ", ".join(failures))
        return 1
    print("SELFTEST PASS")
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("command", choices=["evaluate", "selftest"])
    parser.add_argument("--control-state", help="the derived CURRENT_CONTROL_STATE.json")
    parser.add_argument("--go-repo", help="a GO checkout holding the canonical pointer files")
    parser.add_argument("--live-bundle",
                        help="operator-supplied read-only directory of live-host facts "
                             "(the registered plan bundle and channel.json)")
    parser.add_argument("--out", help="directory to write DEPLOY_READINESS.json into")
    parser.add_argument("--now", help="the instant to evaluate at, so the output is reproducible")
    args = parser.parse_args()
    if args.command == "selftest":
        return run_selftest()
    if not args.control_state or not args.out:
        parser.exit(2, "evaluate requires --control-state and --out\n")
    at = (parse_time(args.now, "now") if args.now
          else dt.datetime.now(dt.timezone.utc))
    generated_at = dt.datetime.now(dt.timezone.utc)
    try:
        document = evaluate(args.control_state, args.go_repo, args.live_bundle, at, generated_at)
    except Refuse as exc:
        parser.exit(3, "REFUSED: %s\n" % exc)
    out = pathlib.Path(args.out)
    out.mkdir(parents=True, exist_ok=True)
    (out / OUTPUT_NAME).write_text(json.dumps(document, indent=2, sort_keys=True) + "\n",
                                   encoding="utf-8", newline="\n")
    blocking = ",".join(entry["gate"] for entry in document["blocking_reasons"])
    print("DEPLOY_READY=%s" % document["verdict"]["deploy_ready"])
    print("BLOCKING=%s" % (blocking or "none"))
    print("ADVISORY=%s" % (",".join(document["verdict"]["advisory_failed"]) or "none"))
    print("OUT=%s" % (out / OUTPUT_NAME))
    return 0


if __name__ == "__main__":
    sys.exit(main())
