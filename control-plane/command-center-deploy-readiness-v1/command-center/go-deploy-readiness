def release_candidate_block(candidate):
    """The candidate's RELEASE_CANDIDATE_V1 block, or a reason it is unusable.

    Read-only and shape-only: the identity rules themselves live in the candidate
    admission component, and this evaluator refuses anything that is not a complete
    block rather than deciding a candidate is fine without one.
    """
    if not isinstance(candidate, dict):
        return None, "no_candidate"
    block = candidate.get(RELEASE_CANDIDATE_BLOCK)
    if block is None:
        return None, "release_candidate_absent"
    if not isinstance(block, dict):
        return None, "release_candidate_not_an_object"
    missing = sorted(set(RELEASE_CANDIDATE_FIELDS) - set(block))
    extra = sorted(set(block) - set(RELEASE_CANDIDATE_FIELDS))
    if missing or extra:
        return None, "release_candidate_fields:%s" % ",".join(missing + extra)
    return block, None


def gate_approved_candidate(inputs):
    candidate = inputs.candidate
    if candidate is None:
        return gate("APPROVED_CANDIDATE", "FAIL",
                    "no approved candidate is readable, so there is nothing to deploy: %s"
                    % inputs.candidate_error,
                    evidence=[inputs.go_source.get("canonical_candidate_pointer")])
    commit = candidate.get("source_commit")
    if not isinstance(commit, str) or not SHA40.fullmatch(commit):
        return gate("APPROVED_CANDIDATE", "FAIL",
                    "the candidate pointer declares no usable source_commit",
                    evidence=[inputs.go_source.get("canonical_candidate_pointer")])
    # A pointer that only names a commit is not a candidate the Command Center can
    # deploy: it has to be a RELEASE_CANDIDATE_V1, which is what defines the
    # version as deployable at all.
    block, problem = release_candidate_block(candidate)
    if problem:
        return gate("APPROVED_CANDIDATE", "FAIL",
                    "the approved candidate is not a RELEASE_CANDIDATE_V1: %s" % problem,
                    observed={"block": RELEASE_CANDIDATE_BLOCK,
                              "contract": RELEASE_CANDIDATE_CONTRACT},
                    evidence=[RELEASE_CANDIDATE_CONTRACT,
                              inputs.go_source.get("canonical_candidate_pointer")])
    return gate("APPROVED_CANDIDATE", "PASS",
                "an approved RELEASE_CANDIDATE_V1 %s exists at %s"
                % (block.get("candidate_id"), commit[:12]),
                observed={"source_commit": commit, "candidate_id": block.get("candidate_id"),
                          "candidate_pr": candidate.get("candidate_pr"),
                          "candidate_branch": candidate.get("candidate_branch")},
                evidence=[RELEASE_CANDIDATE_CONTRACT])


def gate_source_binding(inputs):
    candidate = inputs.candidate
    if candidate is None:
        return gate("SOURCE_BINDING", "FAIL", "no readable candidate to bind")
    required = {"source_commit": SHA40, "application_git_tree": SHA40,
                "source_tree_sha256": SHA64}
    missing, observed = [], {}
    for field, pattern in required.items():
        value = candidate.get(field)
        observed[field] = value
        if not isinstance(value, str) or not pattern.fullmatch(value):
            missing.append(field)
    if missing:
        return gate("SOURCE_BINDING", "FAIL",
                    "the candidate's own source identity is incomplete: %s" % ", ".join(missing),
                    observed=observed, evidence=["docs/canonical-baseline/CURRENT_CANDIDATE.json"])
    block, problem = release_candidate_block(candidate)
    if problem:
        return gate("SOURCE_BINDING", "FAIL",
                    "the candidate carries no RELEASE_CANDIDATE_V1 block to bind: %s" % problem,
                    observed=observed, evidence=[RELEASE_CANDIDATE_CONTRACT])
    # One candidate, one source identity: the block may not disagree with the
    # lineage pointer it came from.
    disagreement = [name for name, top in CANDIDATE_SOURCE_AGREEMENT
                    if block.get(name) != candidate.get(top)]
    if disagreement:
        return gate("SOURCE_BINDING", "FAIL",
                    "the candidate carries two source identities: the block disagrees with "
                    "the lineage pointer about %s" % ", ".join(disagreement),
                    observed={"fields": disagreement}, evidence=[RELEASE_CANDIDATE_CONTRACT])
    return gate("SOURCE_BINDING", "PASS",
                "candidate source identity is complete, and its RELEASE_CANDIDATE_V1 block "
                "agrees with the lineage pointer about commit, application tree and fingerprint",
                observed={"source_commit": candidate["source_commit"],
                          "application_git_tree": candidate["application_git_tree"],
                          "source_tree_sha256": candidate["source_tree_sha256"],
                          "candidate_id": block.get("candidate_id")},
                evidence=[RELEASE_CANDIDATE_CONTRACT,
                          "docs/canonical-baseline/CURRENT_CANDIDATE.json"])


def gate_package_binding(inputs):
    body, candidate = inputs.plan_body(), inputs.candidate
    if body is None or candidate is None:
        return gate("PACKAGE_BINDING", "UNKNOWN",
                    "the plan or the candidate is missing, so the candidate identity cannot be "
                    "compared with what the plan approves")
    block, problem = release_candidate_block(candidate)
    if problem:
        return gate("PACKAGE_BINDING", "FAIL",
                    "the candidate carries no RELEASE_CANDIDATE_V1 block, so what the plan "
                    "approves cannot be bound to a release candidate: %s" % problem,
                    evidence=[RELEASE_CANDIDATE_CONTRACT])
    # The plan and the candidate must agree about the artifact. A plan that approves
    # a different image than the candidate's RELEASE_CANDIDATE_V1 claims is the
    # conflict that would otherwise reach the executor.
    approved_image = (body.get("candidate") or {}).get("image_id")
    if approved_image != block["artifact_digest"]:
        return gate("PACKAGE_BINDING", "FAIL",
                    "the plan approves an artifact the candidate does not claim: the plan names "
                    "%s and the RELEASE_CANDIDATE_V1 artifact is %s"
                    % (approved_image, block["artifact_digest"]),
                    observed={"plan_image_id": approved_image,
                              "candidate_artifact_digest": block["artifact_digest"]},
                    evidence=[RELEASE_CANDIDATE_CONTRACT])
    fields = (("source_commit", SHA40), ("application_git_tree", SHA40),
              ("source_tree_sha256", SHA64))
    mismatches, observed = [], {}
    for field, _pattern in fields:
        approved = (body.get("candidate") or {}).get(field)
        declared = candidate.get(field)
        observed[field] = {"plan": approved, "candidate": declared}
        if approved != declared:
            mismatches.append(field)
    image_id = (body.get("candidate") or {}).get("image_id")
    repo_digest = (body.get("candidate") or {}).get("repo_digest")
    if not isinstance(image_id, str) or not IMAGE_ID.fullmatch(image_id):
        mismatches.append("image_id")
    if not isinstance(repo_digest, str) or not REPO_DIGEST.fullmatch(repo_digest):
        mismatches.append("repo_digest")
    elif isinstance(image_id, str) and not repo_digest.endswith(image_id[7:]):
        mismatches.append("repo_digest_suffix_must_equal_image_id")
    if mismatches:
        return gate("PACKAGE_BINDING", "FAIL",
                    "the plan does not approve what the candidate is: %s" % ", ".join(mismatches),
                    observed=observed, expected={f: candidate.get(f) for f, _ in fields})
    return gate("PACKAGE_BINDING", "PASS",
                "the plan approves this candidate's source identity and a self-consistent image",
                observed={"image_id": image_id, "repo_digest": repo_digest})


def gate_deployment_plan(inputs):
    bundle = inputs.bundle
    if bundle is None:
        return gate("DEPLOYMENT_PLAN", "UNKNOWN",
                    "the approved plan store is a live Command Center fact and no read-only "
                    "bundle was supplied, so no plan can be established")
    if inputs.plan() is None:
        return gate("DEPLOYMENT_PLAN", "FAIL",
                    "a bundle was supplied but no usable plan is in it: %s" % inputs.bundle_error,
                    evidence=inputs.bundle_files)
    body = inputs.plan_body()
    if body is None:
        return gate("DEPLOYMENT_PLAN", "FAIL", "the plan bundle has no plan object",
                    evidence=inputs.bundle_files)
    problems, detail = inputs.bridge()
    plan_level = [p for p in problems if p in (
        "bundle_fields", "plan_fields", "plan_scope", "plan_id", "fixed_topology_required",
        "protected_non_targets_required", "forbidden_operation", "release_gate_fields",
        "candidate_fields", "current_image") or p.startswith("release_gates_not_pass")
        or p.startswith("candidate_")]
    if plan_level:
        return gate("DEPLOYMENT_PLAN", "FAIL",
                    "the supplied plan would be refused by the live Bridge: %s"
                    % ", ".join(plan_level),
                    observed={"plan_id": body.get("plan_id")}, evidence=inputs.bundle_files)
    return gate("DEPLOYMENT_PLAN", "PASS",
                "an approved deploy plan for %s was supplied read-only and its own fields pass "
                "the live Bridge's plan rules" % body["plan_id"],
                observed={"plan_id": body["plan_id"], "deadline": detail.get("deadline")},
                evidence=inputs.bundle_files)


def gate_human_approval(inputs, at):
    body, approval = inputs.plan_body(), inputs.approval()
    if body is None:
        return gate("HUMAN_APPROVAL", "UNKNOWN",
                    "no plan was supplied, so the approval it must carry cannot be read")
    if approval is None:
        return gate("HUMAN_APPROVAL", "FAIL",
                    "the supplied plan carries no approval object", evidence=inputs.bundle_files)
    # The authority is the authenticated GitHub identity, so the first thing to
    # establish is that the approval names one of the identities this project
    # authorises. GitHub is what authenticates the Request PR's author; the live
    # Bridge refuses an unauthorised author before it reads the plan at all, and
    # this gate fails closed on the same set.
    approver = approval.get("approved_by")
    if approver not in APPROVAL_IDENTITIES:
        return gate("HUMAN_APPROVAL", "FAIL",
                    "the approval names an approver that is not one of the authorised GitHub "
                    "identities: %s" % str(approver),
                    observed={"approved_by": approver,
                              "authorised_identities": list(APPROVAL_IDENTITIES)},
                    evidence=inputs.bundle_files)
    plan_sha = digest(body)
    if approval.get("plan_sha256") != plan_sha:
        return gate("HUMAN_APPROVAL", "FAIL",
                    "the approval binds a different plan than the one supplied",
                    observed={"approval_plan_sha256": approval.get("plan_sha256"),
                              "plan_sha256": plan_sha}, evidence=inputs.bundle_files)
    if approval.get("scope") != APPROVAL_SCOPE:
        return gate("HUMAN_APPROVAL", "FAIL",
                    "the approval's scope is not %s" % APPROVAL_SCOPE,
                    observed={"scope": approval.get("scope")}, evidence=inputs.bundle_files)
    try:
        approved = parse_time(approval["approved_at"], "approval_approved_at")
        expires = parse_time(approval["expires_at"], "approval_expires_at")
    except (Refuse, KeyError) as exc:
        return gate("HUMAN_APPROVAL", "FAIL", "the approval's times are unusable: %s" % exc,
                    evidence=inputs.bundle_files)
    if approved > at or expires <= at + dt.timedelta(seconds=60):
        return gate("HUMAN_APPROVAL", "FAIL", "the approval is not in force at %s" % iso(at),
                    observed={"approved_at": iso(approved), "expires_at": iso(expires)},
                    evidence=inputs.bundle_files)
    if (expires - approved).total_seconds() > APPROVAL_MAX_WINDOW_SECONDS:
        return gate("HUMAN_APPROVAL", "FAIL",
                    "the approval window is longer than the %d s contract allows"
                    % APPROVAL_MAX_WINDOW_SECONDS, evidence=inputs.bundle_files)
    _, detail = inputs.bridge()
    if "approved_at" in detail and detail.get("canary_checked_at"):
        checks = [parse_time(detail["canary_checked_at"], "canary_checked_at")]
        if detail.get("preflight_checked_at"):
            checks.append(parse_time(detail["preflight_checked_at"], "preflight_checked_at"))
        if approved < max(checks):
            return gate("HUMAN_APPROVAL", "FAIL",
                        "the approval predates the evidence it is supposed to cover",
                        observed={"approved_at": iso(approved),
                                  "newest_proof_at": iso(max(checks))},
                        evidence=inputs.bundle_files)
    return gate("HUMAN_APPROVAL", "PASS",
                "an approval from the authorised GitHub identity %s is in force until %s"
                % (approval.get("approved_by"), approval["expires_at"]),
                observed={"approval_id": approval["approval_id"],
                          "approved_by": approval.get("approved_by"),
                          "expires_at": approval["expires_at"],
                          "authorised_identities": list(APPROVAL_IDENTITIES)},
                evidence=inputs.bundle_files)


def gate_test_pr(inputs):
    candidate = inputs.candidate
    if candidate is None:
        return gate("TEST_PR", "FAIL", "no readable candidate, so no commit to look up")
    commit = candidate.get("source_commit")
    task = inputs.test_pr_for(commit)
    if task is None:
        return gate("TEST_PR", "FAIL",
                    "no signed TEST_PR exists for the candidate commit %s, so this candidate has "
                    "never been built and tested on the control bus" % str(commit)[:12],
                    expected={"commit_sha": commit})
    evidence = task.get("evidence") or {}
    lifecycle = task.get("lifecycle")
    if evidence.get("status") != "SUCCESS" or lifecycle not in ("EVIDENCE_VERIFIED", "COMPLETE"):
        return gate("TEST_PR", "FAIL",
                    "the TEST_PR for this commit did not succeed: %s" % lifecycle,
                    observed={"task_id": task.get("task_id"), "lifecycle": lifecycle,
                              "evidence_status": evidence.get("status")},
                    evidence=[evidence.get("source", {}).get("path") or task.get("task_id")])
    return gate("TEST_PR", "PASS",
                "the candidate commit was built and tested by a signed TEST_PR",
                observed={"task_id": task.get("task_id"), "lifecycle": lifecycle},
                evidence=[evidence.get("source", {}).get("path") or task.get("task_id")])


def gate_verify(inputs):
    block = inputs.cs.get("live_verified_runtime") or {}
    verified = inputs.verified_runtime()
    window = inputs.freshness.get("live_verification_window_seconds")
    if verified is None:
        state = "UNKNOWN" if block.get("state") == "UNKNOWN" else "FAIL"
        return gate("VERIFY", state,
                    "no signature-verified VERIFY establishes the live runtime: %s"
                    % str(block.get("reason") or "no VERIFY observation"))
    age = verified.get("age_seconds")
    if isinstance(age, int) and isinstance(window, int) and age > window:
        return gate("VERIFY", "FAIL",
                    "the newest verified VERIFY is %d s old, outside the %d s window"
                    % (age, window),
                    observed={"age_seconds": age}, expected={"max_age_seconds": window})
    declared = (inputs.declared_runtime() or {}).get("image_config_id")
    if declared and declared != verified.get("image_config_id"):
        return gate("VERIFY", "FAIL",
                    "the verified live runtime is not the runtime the repository declares",
                    observed={"verified": verified.get("image_config_id"), "declared": declared})
    if inputs.plan() is not None:
        problems, _detail = inputs.bridge()
        preflight = [p for p in problems if p.startswith("preflight_")]
        if preflight:
            return gate("VERIFY", "FAIL",
                        "the plan's own preflight VERIFY proof would be refused by the live "
                        "Bridge: %s" % ", ".join(preflight), evidence=inputs.bundle_files)
    return gate("VERIFY", "PASS",
                "the live runtime is established by signature-verified Evidence inside its window",
                observed={"image_config_id": verified.get("image_config_id"),
                          "verified_at": verified.get("verified_at")})


def gate_current_runtime(inputs):
    body = inputs.plan_body()
    if body is None:
        return gate("CURRENT_RUNTIME", "UNKNOWN",
                    "no plan was supplied, so the image it expects to be current is unknown")
    state = inputs.cs.get("runtime_verification_state")
    verified = inputs.verified_runtime()
    if verified is None:
        # Nothing was proven about the live runtime, so the plan's expectation
        # cannot be checked against it. That is UNKNOWN, never a mismatch.
        return gate("CURRENT_RUNTIME", "UNKNOWN",
                    "no signature-verified live runtime exists to compare the plan's expected "
                    "image against")
    if state == "DRIFT":
        return gate("CURRENT_RUNTIME", "FAIL", "the live runtime drifted from the declared runtime",
                    observed={"runtime_verification_state": state})
    if state != "MATCH":
        return gate("CURRENT_RUNTIME", "UNKNOWN",
                    "the live runtime cannot be matched to the declared runtime: %s" % state,
                    observed={"runtime_verification_state": state})
    expected = body.get("expected_current_image_id")
    if expected != verified.get("image_config_id"):
        return gate("CURRENT_RUNTIME", "FAIL",
                    "the plan expects a different image to be current than the one verified live",
                    observed={"verified": verified.get("image_config_id")}, expected=expected)
    return gate("CURRENT_RUNTIME", "PASS",
                "the live runtime matches the image the plan expects to be current",
                observed={"image_config_id": expected})


def gate_live_switch(inputs):
    channel = inputs.channel()
    if channel is None or not isinstance(channel, dict):
        return gate("LIVE_SWITCH", "UNKNOWN",
                    "the live Command Center request switch is a live-host fact and no channel "
                    "bundle was supplied")
    if "_unreadable" in channel:
        return gate("LIVE_SWITCH", "FAIL",
                    "the supplied channel bundle is unreadable: %s" % channel["_unreadable"])
    problems = []
    if channel.get("deployment_requests_enabled") is not True:
        problems.append("deployment_requests_disabled")
    if channel.get("publish_enabled") is not True:
        problems.append("publish_disabled")
    if channel.get("allowed_environment") != ENVIRONMENT:
        problems.append("wrong_environment")
    if DEPLOY_ACTION not in (channel.get("allowed_actions") or []):
        problems.append("deploy_not_in_allowed_actions")
    if problems:
        return gate("LIVE_SWITCH", "FAIL",
                    "the live request switch would refuse a DEPLOY request: %s"
                    % ", ".join(problems), observed=channel)
    return gate("LIVE_SWITCH", "PASS", "the live request switch would accept a DEPLOY request",
                observed={"allowed_actions": channel.get("allowed_actions"),
                          "allowed_environment": channel.get("allowed_environment")})


def gate_live_switch_provenance(inputs):
    """A switch that is on is only usable if somebody was entitled to turn it on.

    The record must be signed by the distinct Human Approval authority. A record
    that merely asserts itself, or that was signed by the Task signer, proves
    nothing: the whole point is that the party who can create work is not the
    party who authorised the switch.
    """
    channel = inputs.channel()
    enabled = channel.get("deployment_requests_enabled") if isinstance(channel, dict) else None
    record = inputs.switch_provenance()
    if record is None:
        if enabled is True:
            return gate("LIVE_SWITCH_PROVENANCE", "UNKNOWN",
                        "the DEPLOY request switch is on and no change record was supplied, so "
                        "the authority for the switch being on is not established",
                        observed={"deployment_requests_enabled": True})
        return gate("LIVE_SWITCH_PROVENANCE", "UNKNOWN",
                    "no switch change record was supplied, so the switch's authorisation state "
                    "is not established")
    if isinstance(record, dict) and "_unreadable" in record:
        return gate("LIVE_SWITCH_PROVENANCE", "FAIL",
                    "the supplied switch change record is unreadable: %s" % record["_unreadable"])
    fields = ("schema_version", "field", "value", "changed_at", "change_record",
              "approved_by", "approval_id", "valid_from", "valid_until",
              "before_sha256", "after_sha256")
    try:
        exact_set(record, fields, "switch_provenance_fields")
    except Refuse as exc:
        return gate("LIVE_SWITCH_PROVENANCE", "FAIL",
                    "the switch change record is not well formed: %s" % exc,
                    observed={"fields": sorted(record) if isinstance(record, dict) else None})
    if record["field"] != "deployment_requests_enabled":
        return gate("LIVE_SWITCH_PROVENANCE", "FAIL",
                    "the change record names a different field: %s" % record["field"])
    if record["value"] is not enabled:
        return gate("LIVE_SWITCH_PROVENANCE", "FAIL",
                    "the change record's value disagrees with the live channel configuration",
                    observed={"record": record["value"], "live": enabled})
    for name in ("before_sha256", "after_sha256"):
        if not isinstance(record[name], str) or not SHA64.fullmatch(record[name]):
            return gate("LIVE_SWITCH_PROVENANCE", "FAIL",
                        "the change record's %s is not a sha256" % name)
    if not isinstance(record["change_record"], str) or not record["change_record"]:
        return gate("LIVE_SWITCH_PROVENANCE", "FAIL",
                    "the change record names no change_record to trace it to")
    try:
        changed = parse_time(record["changed_at"], "changed_at")
        valid_from = parse_time(record["valid_from"], "valid_from")
        valid_until = parse_time(record["valid_until"], "valid_until")
    except Refuse as exc:
        return gate("LIVE_SWITCH_PROVENANCE", "FAIL",
                    "the change record's times are unusable: %s" % exc)
    if not valid_from <= changed <= valid_until:
        return gate("LIVE_SWITCH_PROVENANCE", "FAIL",
                    "the switch was changed outside the window the record declares",
                    observed={"changed_at": iso(changed), "valid_from": iso(valid_from),
                              "valid_until": iso(valid_until)})
    if inputs.at > valid_until:
        return gate("LIVE_SWITCH_PROVENANCE", "FAIL",
                    "the window that authorised the switch has closed",
                    observed={"valid_until": iso(valid_until), "as_of": iso(inputs.at)})
    # The authority that may open the switch is the same authority that may
    # approve a deployment: an authorised, authenticated GitHub identity. There
    # is no approval key left to sign this record with, so attribution is the
    # rule rather than a signature.
    if record.get("approved_by") not in APPROVAL_IDENTITIES:
        return gate("LIVE_SWITCH_PROVENANCE", "FAIL",
                    "the change record is not attributed to an authorised GitHub identity: %s"
                    % str(record.get("approved_by")),
                    observed={"approved_by": record.get("approved_by"),
                              "authorised_identities": list(APPROVAL_IDENTITIES)})
    return gate("LIVE_SWITCH_PROVENANCE", "PASS",
                "the switch state is covered by a change record attributed to the authorised "
                "GitHub identity %s" % record["approved_by"],
                observed={"change_record": record["change_record"],
                          "changed_at": iso(changed), "value": record["value"],
                          "approved_by": record["approved_by"]},
                evidence=inputs.bundle_files)


def gate_canary(inputs):
    """The canary is only proven when the proof itself verifies.

    The declaration in the plan is not evidence: the digests it carries are only
    meaningful if the objects they name verify under the published identities,
    bind to this candidate, and completed inside the canary window.
    """
    body = inputs.plan_body()
    if body is None:
        return gate("CANARY", "UNKNOWN", "no plan was supplied, so its canary declaration is unknown")
    problems, _detail = inputs.bridge()
    canary = [p for p in problems if p.startswith("canary_")]
    hash_binding = [p for p in problems if p.startswith("proof_hash_binding_")]
    if canary or hash_binding:
        return gate("CANARY", "FAIL",
                    "the plan's canary proof does not establish a fresh successful canary: %s"
                    % ", ".join(canary + hash_binding), evidence=inputs.bundle_files)
    return gate("CANARY", "PASS",
                "a signature-verified canary proof bound to this candidate is inside its window",
                observed={"canary_task_sha256": body.get("canary_task_sha256"),
                          "canary_evidence_sha256": body.get("canary_evidence_sha256")},
                evidence=inputs.bundle_files)


def gate_release_gates(inputs):
    body = inputs.plan_body()
    if body is None:
        return gate("RELEASE_GATES", "UNKNOWN", "no plan was supplied, so its gates are unknown")
    declared = body.get("gates") or {}
    not_pass = sorted(name for name in REQUIRED_PLAN_GATES if declared.get(name) != "PASS")
    if not_pass:
        return gate("RELEASE_GATES", "FAIL",
                    "the plan does not carry PASS for: %s" % ", ".join(not_pass),
                    observed=declared)
    return gate("RELEASE_GATES", "PASS", "the plan carries PASS for every release gate",
                observed=declared)


def gate_bridge_acceptance(inputs):
    """The invariant: readiness may never say YES while the live gate would refuse.

    This gate re-runs the live Bridge's own bundle rules over the same inputs. It
    is the reason a YES verdict can be read as "the request would be accepted",
    and it names the exact rule that would refuse otherwise.
    """
    if inputs.plan() is None:
        return gate("BRIDGE_ACCEPTANCE", "UNKNOWN",
                    "no plan bundle was supplied, so the live Bridge's acceptance decision "
                    "cannot be re-derived")
    problems, _detail = inputs.bridge()
    if problems:
        return gate("BRIDGE_ACCEPTANCE", "FAIL",
                    "the live Bridge would deterministically refuse this request: %s"
                    % ", ".join(problems), evidence=inputs.bundle_files)
    return gate("BRIDGE_ACCEPTANCE", "PASS",
                "the live Bridge's own bundle rules accept this request as far as this evaluator "
                "can re-derive them offline",
                evidence=inputs.bundle_files)


# --------------------------------------------------------------------------- #
# the document
# --------------------------------------------------------------------------- #
def evaluate(control_state, go_repo, bundle_dir, at, generated_at):
    inputs = Inputs(control_state, go_repo, bundle_dir, at)
    gates = [gate_approved_candidate(inputs), gate_source_binding(inputs),
             gate_package_binding(inputs), gate_deployment_plan(inputs),
             gate_human_approval(inputs, at), gate_test_pr(inputs), gate_verify(inputs),
             gate_current_runtime(inputs), gate_live_switch(inputs),
             gate_live_switch_provenance(inputs), gate_canary(inputs),
             gate_release_gates(inputs), gate_bridge_acceptance(inputs)]
    order = {name: index for index, name in enumerate(MANDATORY_GATES + ADVISORY_GATES)}
    gates.sort(key=lambda g: order[g["gate"]])

    mandatory = [g for g in gates if g["mandatory"]]
    failed = [g["gate"] for g in mandatory if g["state"] == "FAIL"]
    unknown = [g["gate"] for g in mandatory if g["state"] == "UNKNOWN"]
    advisory_failed = [g["gate"] for g in gates
                       if not g["mandatory"] and g["state"] != "PASS"]

    if failed:
        verdict, reason = "NO", ("mandatory gates failed: %s" % ", ".join(failed))
    elif unknown:
        # An unprovable mandatory gate is never an inferred yes.
        verdict, reason = "UNKNOWN", ("mandatory gates could not be established: %s"
                                      % ", ".join(unknown))
    else:
        verdict, reason = "YES", ("every mandatory gate passes; this is an observation about the "
                                  "evidence, not an approval, and it authorises nothing")

    blocking = [{"gate": g["gate"], "state": g["state"], "reason": g["reason"],
                 **({"observed": g["observed"]} if "observed" in g else {}),
                 **({"expected": g["expected"]} if "expected" in g else {})}
                for g in mandatory if g["state"] != "PASS"]
    advisories = [{"gate": g["gate"], "state": g["state"], "reason": g["reason"],
                   **({"observed": g["observed"]} if "observed" in g else {})}
                  for g in gates if not g["mandatory"] and g["state"] != "PASS"]

    return {
        "schema_version": "1",
        "contract": CONTRACT_NAME,
        "scope": "READ_ONLY_DEPLOY_READINESS",
        "authority": "DERIVED_NON_AUTHORITATIVE",
        "generated_at": iso(generated_at),
        "as_of": iso(at),
        "verdict": {"deploy_ready": verdict, "reason": reason,
                    "mandatory_gates": len(mandatory), "failed": failed, "unknown": unknown,
                    "advisory_failed": advisory_failed},
        "inputs": {"control_state": {
                       "repository": ((inputs.state.get("sources") or {}).get("go") or {}).get("repository"),
                       "ref": None,
                       "head_sha": None},
                   "go_repository": None if inputs.go_repo is None else inputs.go_repo.name,
                   "candidate_pointer": inputs.go_source.get("canonical_candidate_pointer"),
                   "runtime_pointer": inputs.go_source.get("canonical_runtime_pointer"),
                   "live_bundle": {"supplied": inputs.bundle is not None,
                                   "files": inputs.bundle_files,
                                   "plan_id": (inputs.plan_body() or {}).get("plan_id"),
                                   "note": ("live Command Center facts are read only from this "
                                            "operator-supplied bundle; the evaluator never contacts "
                                            "a host")}},
        "identity": inputs.identities.report(),
        "gates": gates,
        "blocking_reasons": blocking,
        "advisory_holds": advisories,
        "not_evaluated": {"rollback_readiness": "NOT_IN_SCOPE",
                          "note": ("CC V1-09 / #104 owns rollback eligibility. This evaluator "
                                   "answers deploy readiness only and says so instead of guessing")},
        "authority_boundary": dict(AUTHORITY_BOUNDARY),
        "notes": [
            "YES is not an approval. Human Approval is a separate named gate and it is the only "
            "thing in this document that can carry one.",
            "UNKNOWN is a first-class answer: a mandatory gate nobody could establish keeps the "
            "verdict out of YES rather than being rounded up.",
            "Every gate is mandatory. CANARY and RELEASE_GATES block the verdict because the "
            "live Bridge blocks on them: a readiness verdict that could say YES while the "
            "request would be refused is worse than no verdict.",
            "BRIDGE_ACCEPTANCE re-runs the live Bridge's own bundle rules. It exists so that YES "
            "means 'the request would be accepted', and it names the rule that would refuse "
            "otherwise.",
            "The Human Approval authority must be a different key from the Task signer. If the "
            "published identities express one key in both roles, no approval is reported as "
            "proven.",
            "Nothing here creates, signs or publishes a Task, and nothing here can open the "
            "request switch.",
        ],
    }


