class Refuse(Exception):
    """The evaluator cannot produce a document at all. Nothing is written."""


# --------------------------------------------------------------------------- #
# primitives
# --------------------------------------------------------------------------- #
def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()


def digest(value):
    return hashlib.sha256(canonical(value)).hexdigest()


def iso(value):
    return value.astimezone(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def parse_time(value, what="time"):
    if not isinstance(value, str):
        raise Refuse("%s_not_a_string" % what)
    try:
        parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as exc:
        raise Refuse("%s_unparseable" % what) from exc
    if parsed.tzinfo is None:
        raise Refuse("%s_naive" % what)
    return parsed


def read_json(path, limit=MAX_BUNDLE_BYTES):
    path = pathlib.Path(path)
    if path.is_symlink():
        raise Refuse("symlink_refused")
    raw = path.read_bytes()
    if len(raw) > limit:
        raise Refuse("oversized")
    return json.loads(raw.decode("utf-8"))


def gate(name, state, reason, **extra):
    entry = {"gate": name, "mandatory": name in MANDATORY_GATES, "state": state,
             "reason": reason, "blocking": name in MANDATORY_GATES and state != "PASS"}
    for key in ("observed", "expected", "evidence"):
        if key in extra:
            entry[key] = extra[key]
    return entry


def exact_set(value, fields, reason):
    if not isinstance(value, dict) or set(value) != set(fields):
        raise Refuse(reason)


def matches(value, pattern, reason):
    if not isinstance(value, str) or pattern.fullmatch(value) is None:
        raise Refuse(reason)


def signed_unsigned(value):
    """The bytes a Bridge-signed object's signature covers."""
    if not isinstance(value, dict) or not isinstance(value.get("signature"), str):
        raise Refuse("missing_signature")
    return {k: v for k, v in value.items() if k != "signature"}


# --------------------------------------------------------------------------- #
# published identities
# --------------------------------------------------------------------------- #
class Identities:
    """The two published signing roles the live plan contract distinguishes.

    The Human Approval authority is deliberately not one of them. Since the
    2026-09-16 scope reset it is an authenticated GitHub identity rather than a
    signing key, so there is no approval public key to publish and nothing on an
    approval for anyone to sign. If the published contract hands the same key to
    both remaining roles, every claim that depends on telling a Task from an
    Evidence apart is refused rather than reported as proven -- a collision is a
    real finding, not a formatting problem.
    """

    def __init__(self, go_repo):
        self.available = False
        self.problem = None
        self.contract_path = None
        self.entries = {}          # role -> {identity_id, sha256, ssh_sha256, binding, path}
        self.keys = {}             # role -> loaded public key or None
        if go_repo is None:
            self.problem = "no_go_repository_supplied"
            return
        path = pathlib.Path(go_repo) / IDENTITY_CONTRACT
        self.contract_path = str(path)
        try:
            document = read_json(path)
        except Exception as exc:  # noqa: BLE001 - fail closed and say why
            self.problem = "identity_contract_unreadable:%s" % type(exc).__name__
            return
        if not isinstance(document, dict) or document.get("contract") != "VERIFIER_IDENTITIES_V1":
            self.problem = "not_an_identity_contract"
            return
        listed = document.get("identities")
        if not isinstance(listed, list):
            self.problem = "identity_list_missing"
            return
        root = pathlib.Path(go_repo) / STATE_COMPONENT
        for role in (ROLE_TASK, ROLE_EVIDENCE):
            self.entries[role] = self._load_role(root, listed, role)
        self.available = all(self.entries[r]["binding"] == BINDING_BOUND
                             for r in (ROLE_TASK, ROLE_EVIDENCE))

    @staticmethod
    def _load_role(root, listed, role):
        entry = {"identity_id": None, "binding": BINDING_MISSING_KEY, "sha256": None,
                 "ssh_sha256": None, "role": role, "path": None, "loaded": False,
                 "problem": "no_published_identity_for_this_role"}
        for item in listed:
            if isinstance(item, dict) and item.get("role") == role:
                entry["identity_id"] = item.get("identity_id")
                entry["sha256"] = item.get("public_key_file_sha256")
                entry["ssh_sha256"] = item.get("public_key_ssh_sha256")
                rel = item.get("public_key_path")
                if not isinstance(rel, str):
                    entry["binding"] = BINDING_IDENTITY_UNRESOLVED
                    entry["problem"] = "published_identity_has_no_key_path"
                    return entry
                key_path = root / rel
                entry["path"] = str(key_path)
                raw = None
                try:
                    raw = key_path.read_bytes()
                except OSError:
                    entry["binding"] = BINDING_MISSING_KEY
                    entry["problem"] = "published_key_file_is_absent"
                    return entry
                if hashlib.sha256(raw).hexdigest() != entry["sha256"]:
                    entry["binding"] = BINDING_IDENTITY_MISMATCH
                    entry["problem"] = "published_key_bytes_do_not_match_the_declared_digest"
                    return entry
                try:
                    from cryptography.hazmat.primitives import serialization
                    key = (serialization.load_ssh_public_key(raw) if raw.startswith(b"ssh-")
                           else serialization.load_pem_public_key(raw))
                    raw_public = key.public_bytes(serialization.Encoding.Raw,
                                                  serialization.PublicFormat.Raw)
                except Exception as exc:  # noqa: BLE001 - fail closed
                    entry["binding"] = BINDING_KEY_UNREADABLE
                    entry["problem"] = "key_unloadable:%s" % type(exc).__name__
                    return entry
                prefix = b"ssh-ed25519"
                blob = (len(prefix).to_bytes(4, "big") + prefix
                        + len(raw_public).to_bytes(4, "big") + raw_public)
                observed = "SHA256:" + base64.b64encode(
                    hashlib.sha256(blob).digest()).decode("ascii").rstrip("=")
                entry["ssh_sha256_observed"] = observed
                if observed != entry["ssh_sha256"]:
                    entry["binding"] = BINDING_IDENTITY_MISMATCH
                    entry["problem"] = "key_fingerprint_does_not_match_the_published_pin"
                    return entry
                entry["binding"] = BINDING_BOUND
                entry["problem"] = None
                entry["loaded"] = True
                return entry
        return entry

    def collision(self):
        """Which roles share one key. Empty when every role is a distinct key."""
        seen, clashes = {}, []
        for role in (ROLE_TASK, ROLE_EVIDENCE):
            entry = self.entries.get(role) or {}
            pin = entry.get("ssh_sha256")
            if not pin:
                continue
            if pin in seen:
                clashes.append("%s==%s" % (seen[pin], role))
            else:
                seen[pin] = role
        return clashes

    def usable(self, role):
        return (self.entries.get(role) or {}).get("binding") == BINDING_BOUND

    def public_key(self, role):
        entry = self.entries.get(role) or {}
        if not entry.get("loaded"):
            return None
        from cryptography.hazmat.primitives import serialization
        raw = pathlib.Path(entry["path"]).read_bytes()
        return (serialization.load_ssh_public_key(raw) if raw.startswith(b"ssh-")
                else serialization.load_pem_public_key(raw))

    def report(self):
        roles = {}
        for role in (ROLE_TASK, ROLE_EVIDENCE):
            entry = self.entries.get(role) or {}
            roles[role] = {"identity_id": entry.get("identity_id"),
                           "binding": entry.get("binding"),
                           "public_key_ssh_sha256": entry.get("ssh_sha256"),
                           "problem": entry.get("problem")}
        clashes = self.collision()
        return {
            "contract": "VERIFIER_IDENTITIES_V1",
            "contract_path": IDENTITY_CONTRACT,
            "roles": roles,
            "approval_identities": list(APPROVAL_IDENTITIES),
            "task_and_evidence_distinct": not any("TASK==EVIDENCE" in c for c in clashes),
            "collisions": clashes,
            "problem": self.problem,
            "note": ("The Human Approval authority is an authenticated GitHub identity, not a "
                     "key, so it is carried here as the authorised identity set rather than as "
                     "a published public key: there is nothing on an approval to sign and "
                     "nothing for this evaluator to verify cryptographically."),
        }


def verify_signature(key, value, encoding):
    """True only when the signature is present, well formed and valid."""
    if key is None:
        return False, "no_key"
    try:
        unsigned = signed_unsigned(value)
    except Refuse as exc:
        # A missing or non-string signature is a finding, not a crash: the
        # caller must be able to report it as a refused object.
        return False, str(exc)
    try:
        signature = (bytes.fromhex(value["signature"]) if encoding == "hex"
                     else base64.b64decode(value["signature"], validate=True))
        key.verify(signature, canonical(unsigned))
        return True, None
    except Exception as exc:  # noqa: BLE001 - fail closed, report the class
        return False, type(exc).__name__


# --------------------------------------------------------------------------- #
# the live Bridge's own rules, ported read-only
# --------------------------------------------------------------------------- #
def candidate_remote(value):
    """Port of go_deploy_request.candidate_repository()."""
    if not isinstance(value, str) or not value:
        return False
    trimmed = value[:-4] if value.endswith(".git") else value
    parts = trimmed.replace(":", "/").split("/")
    return len(parts) >= 2 and "%s/%s" % (parts[-2], parts[-1]) == CANDIDATE_REPOSITORY


def derived_plan_id(candidate, canary_task):
    """Port of go_deploy_request.plan_id_for(): the name is a function, not a choice."""
    parameters = canary_task.get("parameters") if isinstance(canary_task, dict) else None
    release = parameters.get("release_id") if isinstance(parameters, dict) else None
    if not isinstance(release, str) or not release:
        return None
    try:
        return "hkstg-%s-%s-%s" % (candidate["source_commit"][:12], candidate["image_id"][7:19],
                                   hashlib.sha256(release.encode()).hexdigest()[:12])
    except (KeyError, TypeError, IndexError):
        return None


def bridge_test_pr_proof_problems(task, evidence, task_key, evidence_key):
    """Port of go_deploy_request.test_pr_proof(): the sealed TEST_PR of this candidate.

    This is what replaced the retired `sealed_node = PASS`. sealed_node's name stood for
    one fact -- the artifact a deployment loads is the sealed product of this exact
    source -- and these bindings establish it: a Task built for a named pull request of
    the candidate repository, and Evidence reporting the commit it built from, the
    artifact it produced, the sealed package that artifact was written into, and that the
    sealing was proven. Unlike the canary and the preflight it carries no freshness
    window, because an immutable candidate does not go stale and its binding is by
    content.
    """
    problems = []
    for label, value, key, encoding in (("task", task, task_key, "hex"),
                                        ("evidence", evidence, evidence_key, "base64")):
        try:
            signed_unsigned(value)
        except Refuse as exc:
            problems.append("%s_%s" % (label, exc))
            continue
        ok, why = verify_signature(key, value, encoding)
        if not ok:
            problems.append("%s_signature_%s" % (label, why or "invalid"))
    if problems:
        return problems
    try:
        exact_set(task, TASK_FIELDS, "task_fields")
    except Refuse as exc:
        return ["%s" % exc]
    if task["schema_version"] != "1" or task["authority"] != TASK_AUTHORITY:
        problems.append("task_authority")
    if task["action_id"] != "HK_STAGING_TEST_PR" or task["environment"] != ENVIRONMENT:
        problems.append("test_pr_scope")
    for field in ("task_id", "nonce", "action_id", "environment"):
        if evidence.get(field) != task[field]:
            problems.append("test_pr_binding_%s" % field)
    parameters = task["parameters"]
    try:
        exact_set(parameters, TEST_PR_PARAMETERS, "test_pr_parameters")
        exact_set(parameters["source"], TEST_PR_SOURCE, "test_pr_source_fields")
    except Refuse as exc:
        return problems + ["%s" % exc]
    except (KeyError, TypeError):
        return problems + ["test_pr_parameters"]
    try:
        matches(parameters["source"]["pr_number"], re.compile(r"^[1-9][0-9]{0,8}$"),
                "test_pr_pr_number")
        matches(parameters["source"]["commit_sha"], SHA40, "test_pr_commit")
    except Refuse as exc:
        problems.append("%s" % exc)
    if not candidate_remote(parameters["source"]["repository"]):
        problems.append("test_pr_repository")
    if not isinstance(parameters.get("builder_profile"), str) or not parameters["builder_profile"]:
        problems.append("test_pr_builder_profile")
    if evidence.get("task_canonical_sha256") != digest(
            {k: v for k, v in task.items() if k != "signature"}):
        problems.append("test_pr_task_digest_binding")
    try:
        issued = parse_time(task["issued_at"], "task_issued_at")
        expires = parse_time(task["expires_at"], "task_expires_at")
        started = parse_time(evidence.get("started_at"), "evidence_started_at")
        completed = parse_time(evidence.get("completed_at"), "evidence_completed_at")
    except Refuse as exc:
        return problems + ["%s" % exc]
    if not (issued <= started <= completed <= expires):
        problems.append("test_pr_stale_or_unbound_time")
    if evidence.get("schema_version") != "1" or evidence.get("status") != "SUCCESS":
        problems.append("test_pr_not_success")
    if evidence.get("executor_result") != "TEST_PR_OK":
        problems.append("test_pr_result")
    if evidence.get("deployment_performed") is not False:
        problems.append("test_pr_deployment_performed")
    if evidence.get("source_commit_sha") != parameters["source"]["commit_sha"]:
        problems.append("test_pr_commit_binding")
    if str(evidence.get("source_pr_number")) != parameters["source"]["pr_number"]:
        problems.append("test_pr_pr_binding")
    if evidence.get("artifact_durability") != "PROVEN":
        problems.append("test_pr_artifact_not_durable")
    package = evidence.get("artifact_package")
    if not isinstance(package, dict):
        problems.append("test_pr_package")
    elif package.get("schema") != "go.sealed-artifact.v1" \
            or package.get("image_id") != evidence.get("artifact_digest"):
        problems.append("test_pr_package_binding")
    gates = evidence.get("gate_results")
    if not isinstance(gates, dict):
        problems.append("test_pr_gate_results_missing")
    else:
        missing = sorted(name for name in TEST_PR_GATES if gates.get(name) != "PASS")
        if missing:
            problems.append("test_pr_gate_failed:%s" % ",".join(missing))
        if any(value != "PASS" and value is not False for value in gates.values()):
            problems.append("test_pr_contains_failed_gate")
    return problems, evidence


def bridge_proof_problems(task, evidence, action, task_key, evidence_key, at, max_age):
    """Port of go_deploy_request.proof(): every reason the Bridge would refuse."""
    problems = []
    for label, value, key, encoding in (("task", task, task_key, "hex"),
                                        ("evidence", evidence, evidence_key, "base64")):
        try:
            signed_unsigned(value)
        except Refuse as exc:
            problems.append("%s_%s" % (label, exc))
            continue
        ok, why = verify_signature(key, value, encoding)
        if not ok:
            problems.append("%s_signature_%s" % (label, why or "invalid"))
    if problems:
        return problems
    try:
        exact_set(task, TASK_FIELDS, "task_fields")
    except Refuse as exc:
        return ["%s" % exc]
    if task["schema_version"] != "1" or task["authority"] != TASK_AUTHORITY:
        problems.append("task_authority")
    if task["action_id"] != action or task["environment"] != ENVIRONMENT:
        problems.append("proof_scope")
    for field in ("task_id", "nonce", "action_id", "environment"):
        if evidence.get(field) != task[field]:
            problems.append("proof_binding_%s" % field)
    try:
        matches(task["task_id"], re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"), "task_id")
        matches(task["nonce"], re.compile(r"^[A-Za-z0-9_-]{1,128}$"), "task_nonce")
    except Refuse as exc:
        problems.append("%s" % exc)
    parameters = task["parameters"]
    expected = {"release_id", "candidate_image_id", "expected_current_image_id"}
    if action == "HK_STAGING_CANARY":
        expected.add("candidate_package_sha256")
    try:
        exact_set(parameters, expected, "proof_parameters")
    except Refuse as exc:
        problems.append("%s" % exc)
    if problems:
        return problems
    for field in ("release_id", "candidate_image_id", "expected_current_image_id"):
        if evidence.get(field) != parameters[field]:
            problems.append("proof_image_or_release_%s" % field)
    try:
        matches(parameters["release_id"], EXECUTOR_IDENT, "proof_release_id")
    except Refuse as exc:
        problems.append("%s" % exc)
    if evidence.get("schema_version") != "1" or evidence.get("status") != "SUCCESS":
        problems.append("proof_not_success")
    if evidence.get("executor_result") != ("CANARY_OK" if action == "HK_STAGING_CANARY"
                                           else "VERIFY_OK"):
        problems.append("proof_result")
    try:
        issued = parse_time(task["issued_at"], "task_issued_at")
        expires = parse_time(task["expires_at"], "task_expires_at")
        started = parse_time(evidence.get("started_at"), "evidence_started_at")
        completed = parse_time(evidence.get("completed_at"), "evidence_completed_at")
    except Refuse as exc:
        return problems + ["%s" % exc]
    if not (issued <= started <= completed <= expires):
        problems.append("proof_stale_or_unbound_time")
    if completed > at + dt.timedelta(seconds=PROOF_COMPLETED_GRACE_SECONDS):
        problems.append("proof_completed_in_the_future")
    if at - completed > dt.timedelta(seconds=max_age):
        problems.append("proof_stale")
    gates = evidence.get("gate_results")
    required = CANARY_GATES if action == "HK_STAGING_CANARY" else VERIFY_GATES
    if not isinstance(gates, dict):
        problems.append("proof_gate_results_missing")
    else:
        missing = sorted(name for name in required if gates.get(name) != "PASS")
        if missing:
            problems.append("proof_gate_failed:%s" % ",".join(missing))
        if any(value != "PASS" and value is not False for value in gates.values()):
            problems.append("proof_contains_failed_gate")
    return problems, completed


def bridge_bundle_problems(bundle, identities, at):
    """Port of go_deploy_request.validate_bundle(). Returns (problems, detail)."""
    problems, detail = [], {}
    try:
        exact_set(bundle, ("plan", "approval") + PROOF_OBJECTS, "bundle_fields")
    except Refuse as exc:
        return ["%s" % exc], detail
    plan, approval = bundle["plan"], bundle["approval"]
    # The two signing roles must stay distinct. They are the only cryptographic
    # identities left, and a contract that gives one key both roles makes a Task
    # indistinguishable from the Evidence that is supposed to prove it, so the
    # proofs below cannot be trusted and every gate that reads them says so.
    if identities.collision():
        problems.append("proof_identities_not_distinct:%s" % ",".join(identities.collision()))
    try:
        exact_set(plan, PLAN_FIELDS, "plan_fields")
    except Refuse as exc:
        return ["%s" % exc], detail
    if (plan["schema_version"] != "1" or plan["environment"] != ENVIRONMENT
            or plan["action_id"] != DEPLOY_ACTION):
        problems.append("plan_scope")
    try:
        matches(plan["plan_id"], IDENT, "plan_id")
    except Refuse as exc:
        problems.append("%s" % exc)
    if list(plan["target_services"]) != list(SERVICES):
        problems.append("fixed_topology_required")
    if list(plan["protected_non_targets"]) != list(PROTECTED_NON_TARGETS):
        problems.append("protected_non_targets_required")
    if any(plan.get(name) is not False for name in FORBIDDEN_OPERATIONS):
        problems.append("forbidden_operation")
    candidate = plan.get("candidate")
    try:
        exact_set(candidate, CANDIDATE_FIELDS, "candidate_fields")
    except Refuse as exc:
        problems.append("%s" % exc)
    else:
        if candidate["repository"] != CANDIDATE_REPOSITORY:
            problems.append("candidate_repository")
        for field, pattern in (("source_commit", SHA40), ("application_git_tree", SHA40),
                               ("source_tree_sha256", SHA64), ("package_sha256", SHA64)):
            if not isinstance(candidate[field], str) or not pattern.fullmatch(candidate[field]):
                problems.append("candidate_%s" % field)
        if not isinstance(candidate["image_id"], str) or not IMAGE_ID.fullmatch(candidate["image_id"]):
            problems.append("candidate_image")
        detail["candidate"] = candidate
    if not isinstance(plan.get("expected_current_image_id"), str) or \
            not IMAGE_ID.fullmatch(str(plan.get("expected_current_image_id"))):
        problems.append("current_image")
    # approval. The authority is an authenticated GitHub identity, so the rule the
    # live gate applies is membership in the authorised identity set: there is no
    # approval signature to verify and no approval key to look up.
    try:
        exact_set(approval, APPROVAL_FIELDS, "approval_fields")
    except Refuse as exc:
        problems.append("%s" % exc)
    else:
        if approval["schema_version"] != "1" or approval["scope"] != APPROVAL_SCOPE \
                or approval["plan_sha256"] != digest(plan):
            problems.append("approval_binding")
        try:
            matches(approval["approval_id"], EXECUTOR_IDENT, "approval_id")
            matches(approval["approved_by"], IDENT, "human_reviewer_id")
        except Refuse as exc:
            problems.append("%s" % exc)
        if approval.get("approved_by") not in APPROVAL_IDENTITIES:
            problems.append("approval_identity_not_authorised")
        # The approval is the DEPLOY Request, so it carries that Request's digest and its
        # id follows from it. An offline evaluator cannot re-read the Request -- the live
        # Bridge remains the enforcement point there -- but it can refuse an approval whose
        # own two fields disagree, and it does.
        request_sha256 = approval.get("request_sha256")
        if not isinstance(request_sha256, str) or not SHA64.fullmatch(request_sha256):
            problems.append("approval_request_sha256")
        elif approval.get("approval_id") != "approval-" + request_sha256[:16]:
            problems.append("approval_id_not_derived")
        try:
            approved = parse_time(approval["approved_at"], "approval_approved_at")
            expires = parse_time(approval["expires_at"], "approval_expires_at")
        except Refuse as exc:
            problems.append("%s" % exc)
        else:
            detail["approved_at"] = iso(approved)
            detail["expires_at"] = iso(expires)
            if approved > at or expires <= at + dt.timedelta(seconds=60) \
                    or (expires - approved).total_seconds() > APPROVAL_MAX_WINDOW_SECONDS:
                problems.append("approval_expired_or_invalid")
    for name in PROOF_OBJECTS:
        declared = plan.get(name + "_sha256")
        if declared != digest(bundle[name]):
            problems.append("proof_hash_binding_%s" % name)
    # The name is a function of the candidate and the canary run, so it is checkable
    # offline: a registered plan whose name does not follow was not derived.
    if detail.get("candidate"):
        if plan.get("plan_id") != derived_plan_id(detail["candidate"], bundle["canary_task"]):
            problems.append("plan_id_not_derived")
    task_key = identities.public_key(ROLE_TASK) if identities.usable(ROLE_TASK) else None
    evidence_key = (identities.public_key(ROLE_EVIDENCE)
                    if identities.usable(ROLE_EVIDENCE) else None)
    canary = bridge_proof_problems(bundle["canary_task"], bundle["canary_evidence"],
                                   "HK_STAGING_CANARY", task_key, evidence_key, at,
                                   CANARY_MAX_AGE_SECONDS)
    preflight = bridge_proof_problems(bundle["preflight_task"], bundle["preflight_evidence"],
                                      "HK_STAGING_VERIFY", task_key, evidence_key, at,
                                      PREFLIGHT_MAX_AGE_SECONDS)
    problem_list, canary_checked = (canary if isinstance(canary, tuple) else (canary, None))
    preflight_list, preflight_checked = (preflight if isinstance(preflight, tuple)
                                         else (preflight, None))
    problems += ["canary_" + p for p in problem_list]
    problems += ["preflight_" + p for p in preflight_list]
    detail["canary_checked_at"] = iso(canary_checked) if canary_checked else None
    detail["preflight_checked_at"] = iso(preflight_checked) if preflight_checked else None
    # The sealed TEST_PR, which is what the retired sealed_node declaration stood for.
    sealed = bridge_test_pr_proof_problems(bundle["test_pr_task"], bundle["test_pr_evidence"],
                                           task_key, evidence_key)
    sealed_problems, sealed_evidence = (sealed if isinstance(sealed, tuple) else (sealed, None))
    problems += ["test_pr_" + p for p in sealed_problems]
    if sealed_evidence and detail.get("candidate"):
        sealed_config = detail["candidate"]
        if sealed_evidence.get("source_commit_sha") != sealed_config.get("source_commit"):
            problems.append("test_pr_candidate_source_binding")
        if sealed_evidence.get("artifact_digest") != sealed_config.get("image_id"):
            problems.append("test_pr_candidate_artifact_binding")
        sealed_package = sealed_evidence.get("artifact_package") or {}
        if sealed_package.get("package_sha256") != sealed_config.get("package_sha256"):
            problems.append("test_pr_candidate_package_binding")
    if "approved_at" in detail and canary_checked and preflight_checked:
        approved = parse_time(detail["approved_at"], "approval_approved_at")
        if approved < max(canary_checked, preflight_checked):
            problems.append("approval_predates_evidence")
    cp = (bundle["canary_task"].get("parameters") or {})
    vp = (bundle["preflight_task"].get("parameters") or {})
    if detail.get("candidate"):
        candidate = detail["candidate"]
        if (cp.get("candidate_image_id"), cp.get("candidate_package_sha256"),
                cp.get("expected_current_image_id")) != (
                candidate.get("image_id"), candidate.get("package_sha256"),
                plan.get("expected_current_image_id")):
            problems.append("canary_candidate_binding")
    if (vp.get("candidate_image_id") != plan.get("expected_current_image_id")
            or vp.get("expected_current_image_id") != plan.get("expected_current_image_id")):
        problems.append("preflight_current_image_binding")
    if preflight_checked:
        deadline = min(parse_time(detail["expires_at"], "approval_expires_at")
                       if "expires_at" in detail else at,
                       preflight_checked + dt.timedelta(seconds=PREFLIGHT_MAX_AGE_SECONDS),
                       at + dt.timedelta(seconds=300))
        detail["deadline"] = iso(deadline)
        if deadline <= at + dt.timedelta(seconds=60):
            problems.append("preflight_near_expiry")
    return problems, detail


