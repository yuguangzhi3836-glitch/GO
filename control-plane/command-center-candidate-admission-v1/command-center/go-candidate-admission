def selftest():
    """Built-in checks on the contract and the pinned constants."""
    checks, failures = [], []

    def check(name, condition, detail=""):
        checks.append(name)
        if not condition:
            failures.append(name)
        print("%s  %s %s" % ("PASS" if condition else "FAIL", name, detail if not condition else ""))

    contract = Contract(pathlib.Path(__file__).resolve().parent.parent / CONTRACT_FILE)
    check("contract_loads_and_closes_its_verdict_set", True)
    check("the_refusal_vocabulary_is_not_empty", len(contract.refusals) > 20,
          "%d reasons" % len(contract.refusals))
    check("a_reason_outside_the_contract_is_refused",
          _raises(lambda: contract.refuses("a_reason_invented_tomorrow")))
    granted = sorted(k for k, v in AUTHORITY_BOUNDARY.items()
                     if v and k != "may_read_the_candidate_and_its_evidence")
    check("no_authority_is_held", granted == [], granted)
    check("every_check_reason_is_in_the_vocabulary",
          not [c.get("reason") for c in _dry_run_checks()
               if c.get("reason") and c["reason"] not in contract.refusals])
    print("\nselftest: %s" % ("PASS" if not failures else "FAIL"))
    return 1 if failures else 0


def _raises(call):
    try:
        call()
    except Refuse:
        return True
    return False


def _dry_run_checks():
    """Admission's own check entries for the synthetic refusals, for the vocabulary test."""
    import tempfile
    root = pathlib.Path(tempfile.mkdtemp(prefix="ccv1-admission-"))
    contract = pathlib.Path(__file__).resolve().parent.parent / CONTRACT_FILE
    document = root / "CURRENT_CANDIDATE.json"
    document.write_text(json.dumps({"source_commit": "a" * 40,
                                    "application_git_tree": "b" * 40,
                                    "source_tree_sha256": "c" * 64,
                                    "release_candidate_v1": {}}), encoding="utf-8")
    return admit(contract, document)["checks"]


def main(argv=None):
    parser = argparse.ArgumentParser(description="RELEASE_CANDIDATE_V1 admission (read-only)")
    parser.add_argument("command", nargs="?", default="admit")
    parser.add_argument("--candidate", default=None)
    parser.add_argument("--test-pr-evidence", dest="evidence", default=None)
    parser.add_argument("--plan", default=None)
    parser.add_argument("--go-repo", dest="go_repo", default=None)
    parser.add_argument("--at", default=None)
    parser.add_argument("--out", default=None)
    args = parser.parse_args(argv)

    root = pathlib.Path(__file__).resolve().parent.parent
    if args.command == "selftest":
        return selftest()
    at = parse_time(args.at, "at") if args.at else None
    candidate = args.candidate
    if candidate is None and args.go_repo:
        candidate = str(pathlib.Path(args.go_repo) / LINEAGE_POINTER)
    document = admit(root / CONTRACT_FILE, candidate, args.evidence, args.plan,
                     args.go_repo, at)
    rendered = json.dumps(document, indent=2, sort_keys=True) + "\n"
    if args.out:
        target = pathlib.Path(args.out)
        target.mkdir(parents=True, exist_ok=True)
        (target / OUTPUT_NAME).write_text(rendered, encoding="utf-8")
    else:
        sys.stdout.write(rendered)
    return 0 if document["verdict"]["accepted"] else 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Refuse as exc:
        print("REFUSED=%s" % exc, file=sys.stderr)
        sys.exit(2)
