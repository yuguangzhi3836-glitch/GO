# The live deploy contract forbids migration outright. A candidate that needs one
# is refused here, by name, instead of being discovered by the executor.
MIGRATION_REQUIRED = False

SHA40 = re.compile(r"^[0-9a-f]{40}$")
SHA64 = re.compile(r"^[0-9a-f]{64}$")
IMAGE_ID = re.compile(r"^sha256:[0-9a-f]{64}$")
IDENT = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{2,79}$")
