# --- ported from the live control plane, and re-read by a test ----------------
# These are the live gate's own constants. A test re-reads those files and fails if
# any of them drift, so this copy cannot silently diverge from the real system.
CANDIDATE_REPOSITORY = "yuguangzhi3836-glitch/GO"
