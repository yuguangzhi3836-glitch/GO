+            svc.ingest_checkin('flight19',checkin(auth,leg,passenger,state='BOARDING_PASS_AVAILABLE',boarding_pass_reference=f'https://airline.example/pass/{leg}/{passenger}'),'admin')
+    result=svc.checkin('u19','flight19')
