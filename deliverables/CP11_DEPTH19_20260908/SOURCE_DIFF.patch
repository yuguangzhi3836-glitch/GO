+def arrival(auth, identity, seq=1):
+    return signed(auth,identity,{'event_type':'DELAYED','verified_arrival_at':identity['departure_date']+'T20:30:00+00:00'},kind='FLIGHT_ARRIVAL',seq=seq)
+
