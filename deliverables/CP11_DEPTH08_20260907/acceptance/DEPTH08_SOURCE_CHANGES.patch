+    status['baseline']['depth07_work_sha256'] = WORK_SHA
+    status['baseline']['depth07_archive_commit'] = '34b80961ee11b282a642e3e3722233dd6bd8120b'
+    status['blocked_gates'].append('DURABLE_POSTGRESQL_RUNTIME_AND_MIGRATION')
+    status['frontend']['evidence_inherited_from'] = 'DEPTH07; frontend bytes unchanged, no new browser or Node certification'
+    status['migrations'] = {'current_head': '0116_autonomy_durable', 'prior_files_unchanged': 115,
+                            'added_this_batch': ['alembic/versions/0116_autonomy_durable.py'],
+                            'new_tables': ['autonomy_task', 'autonomy_step', 'autonomy_event', 'autonomy_cell_control', 'autonomy_qualification'],
+                            'populated_downgrade': 'REFUSED; retain evidence or restore verified backup'}
+    status['durable_execution'] = {
+        'sqlite_reliability_gate': 'PASS', 'postgresql_runtime_gate': 'NOT_RUN_NO_LOCAL_SERVER',
+        'registered_cells': 14, 'application_observation_adapters': 14, 'steps_per_observation': 2,
+        'sigkill_fault_points': ['after_claim', 'inside_transaction', 'after_checkpoint', 'after_external_effect'],
+        'local_effect_semantics': 'Effect + checkpoint + evidence committed in one DB transaction per step and task identity',
+        'external_effect_semantics': 'No automatic resend after ambiguous outcome; receipt must bind original operation key',
+        'qualification_semantics': 'Persistent, expiring, independently validated; checked again before every step',
+        'c13_semantics': 'Deterministic admin-authorized observation; self-qualification remains prohibited',
+        'application_scope': 'Aggregate operational observations; no refunds, provider actions or release approvals executed',
+        'worker': 'Explicit standalone process; drains durable queue; no automatic periodic task producer',
+        'production_autonomy_accepted': False,
+    }
+    status['immutable_depth08'] = {k: {'count': v['count'], 'all_match': v['all_match']} for k, v in immutable.items()}
+    status['engineering_gaps'] = [g for g in status['engineering_gaps'] if g != '14_CELL_DURABLE_EXECUTION_AND_RECOVERY'] + [
+        '14_CELL_POSTGRES_RUNTIME_BUSINESS_ADAPTERS_AND_PRODUCTION_QUALIFICATION']
+    status['source_tree_sha256'] = tree_hash(source_entries(ROOT))
+    status['source_tree_definition'] = 'Canonical sorted path/SHA256 JSON for src, frontend, tests, tests_frontend, scripts, alembic, pyproject.toml and alembic.ini; excludes bytecode'
+    write(EVIDENCE / 'CURRENT_BUILD_STATUS.json', status)
+    write(EVIDENCE / 'SOURCE_TREE_MANIFEST.json', {'sha256': status['source_tree_sha256'], 'files': source_entries(ROOT)})
+    write(ROOT / 'CURRENT_DEPTH_CANDIDATE.json', {'build': status['build'], 'FINAL_RELEASE_GATE': 'HOLD',
+        'deployed': False, 'source_tree_sha256': status['source_tree_sha256'],
+        'current_report': 'verification/current_build/depth08/CURRENT_BUILD_STATUS.json',
+        'start_here': 'GO_DEPTH08_START_HERE.md', 'older_release_documents': 'Historical inherited milestones, not DEPTH08 release evidence'})
+    register = json.loads(baseline['acceptance/MASTER_CLOSURE_REGISTER.json'])
