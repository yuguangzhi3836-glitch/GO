+    register['current_build_report'] = 'verification/current_build/depth08/CURRENT_BUILD_STATUS.json'
+    write(ROOT / 'acceptance/MASTER_CLOSURE_REGISTER.json', register)
+
+    selected_paths = {c['path'] for c in changes} | {
+        'GO_DEPTH08_START_HERE.md', 'CURRENT_DEPTH_CANDIDATE.json', 'acceptance/GO_DEPTH08_REVIEW.md',
+        'acceptance/MASTER_CLOSURE_REGISTER.json', 'acceptance/DEPTH08_SOURCE_CHANGES.json',
+        'acceptance/DEPTH08_SOURCE_CHANGES.patch'}
