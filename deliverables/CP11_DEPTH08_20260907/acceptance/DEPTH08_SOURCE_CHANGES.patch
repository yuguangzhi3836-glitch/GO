+#!/usr/bin/env python3
+"""Seal measured DEPTH08 changes without altering the archived DEPTH07."""
+import argparse
+import copy
+import difflib
+import hashlib
+import json
+from pathlib import Path
+import xml.etree.ElementTree as ET
+import zipfile
+
+from assemble_depth08_candidate import PARENT_SHA, WORK_SHA, ROOTS, sha, source_entries, tree_hash
+
+ROOT = Path(__file__).resolve().parents[1]
+EVIDENCE = ROOT / 'verification/current_build/depth08'
+
+
+def write(path, value):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value, ensure_ascii=False, indent=2) + '\n')
+
+
+def hexdigest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def measured_xml(path):
+    suites = list(ET.parse(path).getroot().iter('testsuite'))
+    counts = {k: sum(int(s.get(k, 0)) for s in suites) for k in ('tests', 'failures', 'errors', 'skipped')}
+    counts['passed'] = counts['tests'] - counts['failures'] - counts['errors'] - counts['skipped']
+    counts['seconds'] = round(sum(float(s.get('time', 0)) for s in suites), 3)
+    return counts
+
+
+def build(parent, work):
+    if sha(parent) != PARENT_SHA or sha(work) != WORK_SHA:
+        raise ValueError('BASELINE_HASH_MISMATCH')
+    with zipfile.ZipFile(parent) as pz, zipfile.ZipFile(work) as wz:
+        # Only content that may be compared or replaced is loaded; Python runtime
+        # bytes stay in the verified original parent and are never repackaged.
+        baseline = {}
+        for z in (pz, wz):
+            for name in z.namelist():
+                if not name.endswith('/') and '__pycache__' not in name and not name.endswith(('.pyc', '.pyo')):
+                    if name.split('/')[0] in ROOTS | {'acceptance', 'verification', 'governance'} or '/' not in name:
+                        baseline[name] = z.read(name)
+    totals = measured_xml(EVIDENCE / 'full_regression.xml')
+    if totals['failures'] or totals['errors'] or totals['tests'] < 1026:
+        raise ValueError('FULL_REGRESSION_NOT_PASSING')
+    full = ET.parse(EVIDENCE / 'full_regression.xml')
+    selected = [copy.deepcopy(c) for c in full.getroot().iter('testcase')
+                if 'test_depth08_durable' in c.get('classname', '') or 'test_depth08_api_and_migration' in c.get('classname', '')]
+    target = ET.Element('testsuites')
+    suite = ET.SubElement(target, 'testsuite', name='DEPTH08 subset of full_regression.xml',
+              tests=str(len(selected)), failures='0', errors='0', skipped='0',
+              time=str(sum(float(c.get('time', 0)) for c in selected)))
+    suite.extend(selected)
+    ET.ElementTree(target).write(EVIDENCE / 'targeted.xml', encoding='utf-8', xml_declaration=True)
+    targeted = measured_xml(EVIDENCE / 'targeted.xml')
+    if targeted['tests'] < 57 or any(c.find('failure') is not None or c.find('error') is not None or c.find('skipped') is not None for c in selected):
+        raise ValueError('DEPTH08_TARGETED_MATRIX_INCOMPLETE')
+
+    current = {f['path']: ROOT / f['path'] for f in source_entries(ROOT)}
+    before = {name: data for name, data in baseline.items()
+              if name.split('/')[0] in ROOTS or name in {'pyproject.toml', 'alembic.ini'}}
+    removed = set(before) - set(current)
+    if removed:
+        raise ValueError('UNSUPPORTED_REMOVAL:' + repr(sorted(removed)))
+    changes, patch = [], []
+    for name, path in sorted(current.items()):
+        data, old = path.read_bytes(), before.get(name)
+        if data == old:
+            continue
+        changes.append({'path': name, 'status': 'ADDED' if old is None else 'MODIFIED',
+                        'before_sha256': hexdigest(old) if old is not None else None, 'after_sha256': hexdigest(data)})
+        patch.extend(difflib.unified_diff((old or b'').decode().splitlines(True), data.decode().splitlines(True),
+                      fromfile='DEPTH07/' + name, tofile='DEPTH08/' + name))
+    write(ROOT / 'acceptance/DEPTH08_SOURCE_CHANGES.json', {'baseline_work_sha256': WORK_SHA, 'changes': changes})
+    (ROOT / 'acceptance/DEPTH08_SOURCE_CHANGES.patch').write_text(''.join(patch))
+
+    groups = {
+        'prior_115_migrations': [n for n in before if n.startswith('alembic/versions/') and n.endswith('.py')],
+        'frontend': [n for n in before if n.startswith('frontend/')],
+        'autonomy_constitution': [n for n in before if n.startswith('src/go_hotel/autonomy/')],
+        'v7_master': ['GO_ULTIMATE_MASTER_PLAN_V7.0_2026-08-31_CONSTITUTIONAL_LEGAL_SYNC_MASTER.pdf'],
+    }
+    immutable = {label: {'count': len(names), 'all_match': all((ROOT / n).read_bytes() == baseline[n] for n in names),
+                        'files': [{'path': n, 'sha256': hexdigest(baseline[n])} for n in sorted(names)]}
+                 for label, names in groups.items()}
+    if not all(g['all_match'] for g in immutable.values()):
+        raise ValueError('IMMUTABLE_BASELINE_CHANGED')
+    write(EVIDENCE / 'immutable_baseline.json', immutable)
+
+    status = json.loads(baseline['verification/current_build/depth07/CURRENT_BUILD_STATUS.json'])
+    status.update(build='CP11_DEPTH_08_DURABLE_EXECUTION', FINAL_RELEASE_GATE='HOLD', engineering_complete=False,
+                  deployed=False, python=totals, new_targeted=targeted,
