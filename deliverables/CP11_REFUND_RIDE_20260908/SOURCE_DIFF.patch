+import React,{useEffect,useMemo,useState} from 'react';
+import {ActivityIndicator,ScrollView,Text,View} from 'react-native';
+import {GO,screen} from '../design';
+import {TopBar,Btn,Price} from '../components/GO';
+import {api} from '../api/client';
+import {idempotencyKey} from '../api/network';
+import {createRefundController} from '../afterSales/refundController';
+import type {RefundVertical,RefundView} from '../afterSales/refundController';
+
+export default function RefundReview({vertical,orderId,navigation}:{vertical:RefundVertical;orderId:string;navigation:any}){
+  const controller=useMemo(()=>createRefundController(api,()=>idempotencyKey('refund'),vertical,orderId),[vertical,orderId]);
+  const [view,setView]=useState<RefundView>({phase:'LOADING'});
+  useEffect(()=>{const detach=controller.subscribe(setView);void controller.load();return detach},[controller]);
+  const amount=view.quote||view.progress;
+  const title=view.phase==='COMPLETE'?'隔离退款处理完成':view.phase==='PENDING'?'原退款正在处理':'核对退款方案';
+  return <ScrollView style={screen.root} contentContainerStyle={screen.content}>
+    <TopBar title={vertical==='RIDE'?'取消接送':'退票'} onBack={()=>navigation.goBack()}/>
+    <Text style={screen.h1}>{title}</Text>
+    <Text style={[screen.sub,{marginTop:8}]}>隔离测试不会产生真实预订或银行卡退款。</Text>
+    {['LOADING','BUSY'].includes(view.phase)&&<ActivityIndicator color={GO.navy} accessibilityLabel="正在核对退款"/>}
+    {amount&&<View style={screen.card}>
+      <View style={screen.row}><Text>保留费用</Text><Price minor={amount.refund_fee_minor} currency={amount.currency}/></View>
+      <View style={[screen.row,{marginTop:12}]}><Text>原路退款金额</Text><Price minor={amount.refund_amount_minor} currency={amount.currency}/></View>
+    </View>}
+    {!!view.message&&<View style={screen.card}><Text accessibilityRole="alert">{view.message}</Text></View>}
+    {view.phase==='QUOTE'&&<Btn title="确认此退款方案" onPress={()=>void controller.submit()}/>}
+    {view.phase==='PENDING'&&<Btn title="继续核对原退款" onPress={()=>void controller.recover()}/>}
+    {!['LOADING','BUSY'].includes(view.phase)&&<Btn title="重新查询进度" secondary onPress={()=>void controller.load()}/>}
+    <Btn title="返回 GO Trips" secondary onPress={()=>navigation.navigate('Main',{screen:'Trips'})}/>
+  </ScrollView>;
+}
