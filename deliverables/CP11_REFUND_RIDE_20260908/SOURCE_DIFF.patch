+from alembic import op
+import sqlalchemy as sa
+revision='0131_ride_refund_operation'
+down_revision='0130_vertical_capacity'
+branch_labels=None
+depends_on=None
+
+
+def _constraint(values):
+    with op.batch_alter_table('vertical_refund_operation') as batch:
+        batch.drop_constraint('ck_refund_operation_vertical',type_='check')
+        batch.create_check_constraint('ck_refund_operation_vertical',values)
+
+
+def upgrade():
+    _constraint("vertical IN ('RAIL','ATTRACTION','RIDE')")
+
+
+def downgrade():
+    if op.get_bind().execute(sa.text("SELECT count(*) FROM vertical_refund_operation WHERE vertical='RIDE'")).scalar():
+        raise RuntimeError('RIDE_REFUND_DATA_PRESENT_DOWNGRADE_BLOCKED')
+    _constraint("vertical IN ('RAIL','ATTRACTION')")
