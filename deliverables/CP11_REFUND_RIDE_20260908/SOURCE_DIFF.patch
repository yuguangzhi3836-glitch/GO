+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createRefundController} from '../mobile/go-app/src/afterSales/refundController.ts';
+function setup(vertical,options={}){
+ const calls=[],id='mobile/order',quote={order_id:id,quote_hash:'b'.repeat(64),refund_amount_minor:900,refund_fee_minor:100,currency:'CNY'};
+ let status=vertical==='RAIL'?'TICKETED':'CONFIRMED',progress='PENDING',n=0;
+ const api=async(path,init)=>{
+  calls.push({path,init});
+  if(init){
+   if(options.reject){throw Error(options.reject)}
+   status='REFUND_PENDING';progress='PENDING';
+   if(!options.pending){status='REFUNDED';progress='COMPLETED'}
+   if(options.lost)throw Error('NETWORK_REQUEST_FAILED');
+   return {data:{status:'REFUND_COMPLETED'}};
+  }
+  if(path.endsWith('/refund-quote'))return {data:quote};
+  if(path.endsWith('/refund-progress'))return {data:{...quote,status:progress}};
+  return {data:{order_id:id,status}};
+ };
+ const c=createRefundController(api,()=>`key-${++n}`,vertical,id);
+ return {c,calls,quote,setStatus:value=>{status=value},complete:()=>{status='REFUNDED';progress='COMPLETED'}};
+}
+for(const vertical of ['RAIL','ATTRACTION','RIDE']){
+ test(`mobile ${vertical}: opening is read-only and confirm carries the displayed identity`,async()=>{
+  const s=setup(vertical);await s.c.load();assert.equal(s.c.get().phase,'QUOTE');
+  assert.equal(s.calls.filter(x=>x.init).length,0);
+  await s.c.submit();const post=s.calls.find(x=>x.init);
+  assert.match(post.path,/mobile%2Forder\/(refund|cancel)$/);
+  assert.equal(JSON.parse(post.init.body).expected_quote_hash,s.quote.quote_hash);
+  assert.equal(post.init.headers['Idempotency-Key'],'key-1');
+  assert.equal(s.c.get().phase,'COMPLETE');
+  await s.c.submit();assert.equal(s.calls.filter(x=>x.init).length,1);
+ });
