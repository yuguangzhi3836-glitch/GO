+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import vm from 'node:vm';
+const code=fs.readFileSync('frontend/consumer/app.js','utf8');
+const helper=code.slice(code.indexOf('async function submitVerticalRefund('),code.indexOf('async function railRefund('));
+function setup(vertical,config={}){
+ const group=vertical==='RAIL'?'rail':vertical==='RIDE'?'mobility':'attractions',field=vertical==='RAIL'?'railOrder':vertical==='RIDE'?'rideOrder':'attractionOrder';
+ const calls=[],order={order_id:'order/consent',status:vertical==='RAIL'?'TICKETED':'CONFIRMED'};
+ const quote={order_id:order.order_id,quote_hash:'a'.repeat(64),refund_amount_minor:900,refund_fee_minor:100,currency:'CNY',...config.quote};
+ let keys=0;
+ const c={state:{[field]:order},crypto:{randomUUID:()=>`request-${++keys}`},Error,encodeURIComponent,
+  money:(a,c)=>`${c} ${a}`,toast:x=>calls.push({toast:x}),uxConfirm:x=>x,
+  api:async(path,options)=>{calls.push({path,options});if(options&&config.fail)throw Error(config.fail);return path.endsWith('refund-quote')?quote:options?{status:'REFUND_COMPLETED'}:{...order,status:'REFUNDED'}},
+  renderMobilityOrder:kind=>calls.push({render:kind}),renderRailOrder:()=>calls.push({render:'RAIL'}),renderAttractionOrder:()=>calls.push({render:'ATTRACTION'})};
+ vm.createContext(c);vm.runInContext(helper,c);return {c,calls,field,group,quote};
+}
+for(const vertical of ['RAIL','ATTRACTION','RIDE']){
+ test(`${vertical}: confirmation captures displayed quote and order with one stable key`,async()=>{
+  const s=setup(vertical),dialog=await s.c.openVerticalRefund(vertical);
+  assert.equal(s.calls.filter(x=>x.options).length,0);
+  assert.match(dialog.summary,/900/);assert.match(dialog.summary,/100/);
+  s.c.state[s.field]={order_id:'different-order',status:'CONFIRMED'};
+  await dialog.onConfirm();await dialog.onConfirm();
+  const posts=s.calls.filter(x=>x.options);
+  assert.equal(posts.length,2);
+  assert.ok(posts.every(x=>x.path.endsWith('/order%2Fconsent/'+(vertical==='RIDE'?'cancel':'refund'))));
+  assert.ok(posts.every(x=>JSON.parse(x.options.body).expected_quote_hash==='a'.repeat(64)));
+  assert.equal(posts[0].options.headers['Idempotency-Key'],posts[1].options.headers['Idempotency-Key']);
+  assert.equal(s.c.state[s.field].order_id,'different-order');
+  assert.equal(s.calls.filter(x=>x.render).length,0);
+ });
+ test(`${vertical}: stale quote does not trigger a replacement refund or automatic reconsent`,async()=>{
+  const s=setup(vertical,{fail:'REFUND_QUOTE_CHANGED'}),dialog=await s.c.openVerticalRefund(vertical);
+  await assert.rejects(dialog.onConfirm(),/重新查看退款金额并确认/);
+  assert.equal(s.calls.filter(x=>x.options).length,1);
+  assert.equal(s.calls.filter(x=>x.path?.endsWith('refund-quote')).length,1);
