+    names.update(p.relative_to(ROOT).as_posix() for p in evidence.rglob('*') if allowed(p) and p.suffix!='.log')
+    names.update({'GO_DEPTH24_START_HERE.md','CURRENT_DEPTH_CANDIDATE.json'})
