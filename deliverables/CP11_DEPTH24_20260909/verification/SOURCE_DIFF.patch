+             'baseline_work_sha256':BASE_SHA,'release_gate':'HOLD','engineering_complete':False}
+    (out/'GO_DEPTH24_DELIVERY.json').write_text(json.dumps(receipt,indent=2)+'\n')
+    (out/'GO_DEPTH24_SHA256SUMS.txt').write_text(f"{digest(path)}  {path.name}\n")
+    print(json.dumps(receipt,indent=2))
+
+
+if __name__=='__main__':main()
