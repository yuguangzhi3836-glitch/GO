+              'result_manifest_sha256':hashlib.sha256(result_bytes).hexdigest(),
+              'FINAL_RELEASE_GATE':'HOLD','removed':[],'files':changes}
+    path=out/(STEM+'_DELTA_20260909.zip');temporary=path.with_suffix('.building')
