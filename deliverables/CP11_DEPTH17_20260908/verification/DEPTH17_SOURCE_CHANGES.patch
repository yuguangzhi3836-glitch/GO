+    route = PREFIX + '/tasks/' + task['task_id']
+    assert client.post(route + '/resume', headers=headers).json()['data']['status'] == 'QUEUED'
+    assert client.post(route + '/cancel', headers=headers).json()['data']['status'] == 'CANCELLED'
