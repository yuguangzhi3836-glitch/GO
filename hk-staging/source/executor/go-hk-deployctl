    executable_dir=os.path.dirname(os.path.abspath(__file__))
    path=os.path.join(executable_dir,"go-hk-deployctl-runtime","artifact_runtime.py")
    try:
        if not stat.S_ISREG(os.lstat(path).st_mode): raise ValueError("artifact path")
        with open(path,"rb") as handle:
