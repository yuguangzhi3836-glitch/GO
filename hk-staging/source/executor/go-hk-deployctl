#!/usr/bin/env python3
"""Fixed HK-STAGING VERIFY plus isolated candidate-image CANARY executor.

One environment, one mutation at a time
---------------------------------------
`deploy` and `rollback` mutate the same eight business containers, so they share
one environment-scoped lock: `/var/lib/go-hk-deployctl/deploy-<environment>.lock`,
taken with an exclusive non-blocking lock before the runtime is entered.  The lock
is deliberately taken HERE rather than inside the runtime, so it is already held
before `deploy_runtime._precheck()` reads the host: a second executor that passes
`_precheck` concurrently with the first is exactly the race this closes.  The lock
is released by the kernel when the process exits, so a crash cannot leave the
environment locked.

A second executor does not wait, queue or retry -- it fails immediately with
`E_ENVIRONMENT_DEPLOYMENT_BUSY`, because by the time the first one finishes the
second one's own preconditions (`expected_current_image_id` above all) describe a
host that no longer exists.  `CANARY` and `VERIFY` take no lock: they mutate no
business runtime.

This is the second door, not the first: the Command Center already refuses a second
mutating Request for a busy environment.  Neither replaces the other, and neither
claims to stop a process that already has root on this host.
"""
import contextlib
import errno
import json
import hashlib
import importlib
import importlib.util
import os
import re
import stat
import sys

VERSION = "0.7.0-environment-lock"
ENVIRONMENT = "HK-STAGING-01"
ENVIRONMENT_RE = re.compile(r"^[A-Z0-9][A-Z0-9-]{0,31}$")
LOCK_DIR = "/var/lib/go-hk-deployctl"
LOCK_TEMPLATE = "deploy-%s.lock"
_IMAGE = re.compile(r"^sha256:[0-9a-f]{64}$")
_RELEASE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$")
# The content address of the candidate this deployment is about.  It is an argument
# rather than something the launcher derives: the value is the Command Center's, the
# verification is the runtime's, and the launcher's job is to refuse a Task that does not
# carry a well-formed one.
_CONTRACT = re.compile(r"^[0-9a-f]{64}$")
_COLLECTOR_SHA256 = "a7f55a7c1133a6cae17075d76b91ac6c894d41bbf619feab02af894bbed82b5a"
_CANARY_SHA256 = "50284e007947730feeec57e1bcbebabb80b7ac4766524214d8da6424c606181a"
# Updated by CCV1-85 (WP-4A), again by WP-9's product decision of 2026-09-19, and again
# by the 2026-09-19 convergence that carried the rollback channel onto this main line:
# deploy_runtime.py resolves the candidate the Task names, applies the migration rule, and
# recreates the containers through the shared media-mount builder; rollback_runtime.py
# recreates them through that same builder, pins the images it restores and waits for the
# api it restored to answer.  The deploy pin is untouched by the convergence -- those bytes
# are unchanged -- and the rollback pin is recomputed from the merged file.
#
# 2026-10-07: the deploy pin is recomputed.  deploy_runtime.py's `_task_binding` no longer
# compares the binding's `authority` against one inline string: it consults a declared
# `TASK_AUTHORITIES` list, so a second issuing authority can be named instead of every
# operator having to write `GO-COMMAND-CENTER` into its own record.  Nothing else in the
# deploy path changes -- the candidate digest, the artifact identity, the migration rule
# and the container binding are the same code they were, and the remaining four pins are
# unchanged.  This pin moves because the deploy module's bytes moved, which is exactly
# what it is for.
_DEPLOY_SHA256 = "06a3eebc8257a4dfa2cc519aedd60888a2b6b0975f1dccce6bbcfa9854a82b2b"
_ROLLBACK_SHA256 = "8467c240f7e3f7a096515f6e47a6760033d3c5ab20fbb452cfb504133bf8db1f"
_ARTIFACT_SHA256 = "736b557167fd641aaf59ef66c4380d0d7902aa91b562aee2a5c3688918687e7b"


def _load_collector():
    """Load only the immutable sibling runtime after validating its bytes."""
    executable_dir = os.path.dirname(os.path.abspath(__file__))
    runtime_dir = os.path.join(executable_dir, "go-hk-deployctl-runtime")
    collector_path = os.path.join(runtime_dir, "collector_runtime.py")
    try:
        if not stat.S_ISDIR(os.lstat(runtime_dir).st_mode):
            raise ValueError("runtime directory")
        mode = os.lstat(collector_path).st_mode
        if not stat.S_ISREG(mode):
            raise ValueError("collector path")
        with open(collector_path, "rb") as handle:
            if hashlib.sha256(handle.read()).hexdigest() != _COLLECTOR_SHA256:
                raise ValueError("collector integrity")
    except (OSError, ValueError):
        raise ValueError("collector runtime rejected")
    spec = importlib.util.spec_from_file_location("_go_hk_collector_runtime", collector_path)
    if spec is None or spec.loader is None:
        raise ValueError("collector loader")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    if os.path.abspath(getattr(module, "__file__", "")) != os.path.abspath(collector_path):
        raise ValueError("collector import source")
    return module


def _document(status, release_id, candidate_image_id, expected_current_image_id,
              gates, result, installed_identity=None):
    """The one shape every action's output has.

    `installed_identity` is present on an action that ran under a verified installation and
    absent from a refusal, which is the honest distinction: a document that reports a
    refusal did not necessarily get far enough to know what it was installed as.  The agent
    requires one exact key set per action, so an absence is refused rather than ignored.
    """
    document = {
        "schema_version": "1",
        "executor_version": VERSION,
        "action_id": "HK_STAGING_VERIFY",
        "status": status,
        "release_id": release_id,
        "candidate_image_id": candidate_image_id,
        "expected_current_image_id": expected_current_image_id,
        "result": result,
        "gate_results": gates,
    }
    if installed_identity is not None:
        document["installed_identity"] = installed_identity
    return document

