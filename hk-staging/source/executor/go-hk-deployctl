import sys

VERSION = "0.5.1-same-revision"
_CONTRACT_SHA256 = "3b5897e734749df5be1ca6befa2da88d7c7b58bf02683838341b46b519e8f618"
_SAME_REVISION_SHA256 = "d984b5716add576079e25509d48abe9bc21f4338e8efdf928e54cfe473881efe"
_MIGRATION_SHA256 = "be60700cc8dd10d402e2d0e7ddcab3269d93a5acf7ebfd6cd5ba6840ecc8fd0d"
_IMAGE = re.compile(r"^sha256:[0-9a-f]{64}$")
_RELEASE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$")
_COLLECTOR_SHA256 = "fb3d966d8736bcb49a76ff52db01a417bc745f7b5ad47addf9d576e8bf4fa1a6"
_CANARY_SHA256 = "c3c74678d640150380af572899c303c18f4c62c0333e4e766af0b963bd0dcefb"
_DEPLOY_SHA256 = "79e5b840c14601bf8d720e1300df2fb98838bfd9ec48af881c483588cb788f6b"
_ROLLBACK_SHA256 = "274c39f7e430805fb2355bc302b8d559452c0d0b11b1a92461bb8e09a0aab1bd"
_ARTIFACT_SHA256 = "736b557167fd641aaf59ef66c4380d0d7902aa91b562aee2a5c3688918687e7b"


def _load_extra(name,pin):
    path=os.path.join(os.path.dirname(os.path.abspath(__file__)),"go-hk-deployctl-runtime",name+".py")
    if not stat.S_ISREG(os.lstat(path).st_mode): raise ValueError("runtime path")
    with open(path,"rb") as handle:
        if hashlib.sha256(handle.read()).hexdigest()!=pin: raise ValueError("runtime integrity")
    spec=importlib.util.spec_from_file_location("_go_hk_"+name,path)
    module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
    return module

def _contract(identity,candidate,expected,package=None,verify=False):
    if identity is None: return None
    module=_load_extra('hk_candidate_contract',_CONTRACT_SHA256)
    value=module.load(identity,module.HK_STORE)
    if verify: module.verify_profile(value,candidate)
    else: module.bind(value,candidate,expected,package)
    return value

def _migration(): return _load_extra('migration_runtime',_MIGRATION_SHA256)
def _same_revision(): return _load_extra('same_revision_runtime',_SAME_REVISION_SHA256)

def _load_collector():
    """Load only the immutable sibling runtime after validating its bytes."""
    executable_dir = os.path.dirname(os.path.abspath(__file__))
    runtime_dir = os.path.join(executable_dir, "go-hk-deployctl-runtime")
    collector_path = os.path.join(runtime_dir, "collector_runtime.py")
    try:
        if not stat.S_ISDIR(os.lstat(runtime_dir).st_mode):
            raise ValueError("runtime directory")
        mode = os.lstat(collector_path).st_mode
        if not stat.S_ISREG(mode):
            raise ValueError("collector path")
        with open(collector_path, "rb") as handle:
            if hashlib.sha256(handle.read()).hexdigest() != _COLLECTOR_SHA256:
                raise ValueError("collector integrity")
    except (OSError, ValueError):
        raise ValueError("collector runtime rejected")
    spec = importlib.util.spec_from_file_location("_go_hk_collector_runtime", collector_path)
    if spec is None or spec.loader is None:
        raise ValueError("collector loader")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    if os.path.abspath(getattr(module, "__file__", "")) != os.path.abspath(collector_path):
        raise ValueError("collector import source")
    return module


def _document(status, release_id, candidate_image_id, expected_current_image_id,
              gates, result):
    return {
        "schema_version": "1",
        "executor_version": VERSION,
        "action_id": "HK_STAGING_VERIFY",
        "status": status,
        "release_id": release_id,
        "candidate_image_id": candidate_image_id,
        "expected_current_image_id": expected_current_image_id,
        "result": result,
        "gate_results": gates,
    }

