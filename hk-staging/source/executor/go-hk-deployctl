def _load_install_fact():
    """Load the verifier for the installation fact.

    Deliberately *not* guarded by a SHA256 constant compiled into this file. A constant
    here would be the verifier checking the verifier, and it would reintroduce exactly the
    coupling this replaces: updating any module would mean editing this launcher. What
    protects `install_fact.py` is what protects this file -- the runtime directory is
    root-owned and neither the executor nor the agent account can write it -- and the fact
    lists `install_fact` among the modules it describes, so a fact that disagrees with the
    verifier's own bytes is refused by the verifier itself.
    """
    executable_dir=os.path.dirname(os.path.abspath(__file__))
    path=os.path.join(executable_dir,"go-hk-deployctl-runtime","install_fact.py")
    try:
        if not stat.S_ISREG(os.lstat(path).st_mode): raise ValueError("install fact path")
    except (OSError,ValueError): raise ValueError("E_INSTALL_FACT_MODULE")
    spec=importlib.util.spec_from_file_location("_go_hk_install_fact",path)
    if spec is None or spec.loader is None: raise ValueError("E_INSTALL_FACT_MODULE")
    module=importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
    if os.path.abspath(getattr(module,"__file__",""))!=os.path.abspath(path): raise ValueError("E_INSTALL_FACT_MODULE")
    return module


def _verify_installation():
    """The trust root, checked before any action runs.

    Dual verification while the switch is being made (CCV1-82 T5). The five per-module
    pins above still apply to the modules they cover, and the signed installation fact is
    checked as well; the two must agree, which a test pins. The pins are not removed here:
    that is a later, separately reviewed step. The fact is what makes "which bytes are
    installed, and since when" answerable; the pins are what made this launcher refuse to
    start with the wrong ones, and both properties are worth having during a transition.

    This is also where the launcher's own bytes are checked -- against a number that came
    from outside, in a signed document. The launcher does not attest itself.
    """
    executable_dir=os.path.dirname(os.path.abspath(__file__))
    runtime_dir=os.path.join(executable_dir,"go-hk-deployctl-runtime")
    return _load_install_fact().load_installation(os.path.abspath(__file__),runtime_dir)


def _installed_identity():
    """The block an Evidence carries: which bytes were installed when this action ran.

    It is derived from the document `_verify_installation()` has just returned, by the
    module that defines the block, so the answer comes from the verification that already
    gates every action rather than from something assembled beside it.  An identity a
    caller could produce without that check would be a claim; this one is a reading.
    """
    fact=_verify_installation()
    return _load_install_fact().installed_identity(fact)


try:
    import fcntl
except ImportError:                      # this host has no flock; see _lock_exclusive
    fcntl = None


def _lock_exclusive(descriptor):
    """Take the environment's exclusive lock without waiting, or raise OSError.

    `fcntl.flock` is the shipped primitive, and the kernel releases it when the
    descriptor closes -- including when the process dies -- so a crash cannot leave the
    environment locked and no marker has to be cleared by hand.

    The indirection is deliberate and has two purposes. A host without `fcntl` must be
    *shown* to refuse rather than assumed to proceed unlocked, which `_environment_lock`
    does by turning a missing primitive into E_ENVIRONMENT_DEPLOYMENT_LOCK. And the
    concurrency regression can exercise the same discipline with its own host's kernel
    primitive, so the assertions run everywhere instead of being skipped on whichever
    platform the reviewer happens to use.
    """
    if fcntl is None: raise OSError(errno.ENOSYS, "no file locking primitive on this host")
    fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)


def _unlock(descriptor):
    if fcntl is None: return
    try: fcntl.flock(descriptor, fcntl.LOCK_UN)
    except OSError: pass


@contextlib.contextmanager
def _environment_lock(environment=ENVIRONMENT):
    """The environment's one mutation slot, held for the whole critical section.

    `LOCK_EX|LOCK_NB`: exclusive, and never blocking.  A second executor must fail
    at once rather than wait, because it already read the host's expected state and
    that reading is invalidated by the first executor's success.

    `O_NOFOLLOW` on open so a planted symlink cannot redirect the lock; the kernel
    drops the lock when the descriptor closes, including on a crash, so no marker
    file has to be cleared by hand.
    """
    if not isinstance(environment,str) or not ENVIRONMENT_RE.fullmatch(environment):
        raise ValueError("E_ENVIRONMENT_DEPLOYMENT_LOCK")
    path=os.path.join(LOCK_DIR,LOCK_TEMPLATE % environment)
    try:
        fd=os.open(path,os.O_WRONLY|os.O_CREAT|getattr(os,"O_NOFOLLOW",0),0o600)
    except OSError as exc:
        raise ValueError("E_ENVIRONMENT_DEPLOYMENT_LOCK") from exc
    try:
        try:
            _lock_exclusive(fd)
        except OSError as exc:
            if exc.errno in (errno.EACCES,errno.EAGAIN,errno.EWOULDBLOCK):
                # Contention is its own answer: another executor holds the environment.
                raise ValueError("E_ENVIRONMENT_DEPLOYMENT_BUSY") from exc
            raise ValueError("E_ENVIRONMENT_DEPLOYMENT_LOCK") from exc
        yield
    finally:
        _unlock(fd)
        os.close(fd)

def _deploy(release,candidate,package,expected,approval,canary_evidence,candidate_contract_sha256,binding,runner=None):
    """The DEPLOY entry.  The candidate digest is required, and required to be well formed.

    An absent or malformed digest is refused here, before the runtime is even loaded, so
    a Task that carries no candidate identity never reaches the code that could replace a
    container.  The digest the document reports on success is the one the runtime
    recomputed from the fact it loaded -- popped from the runtime's own result rather
    than echoed from this argument, because a value that echoes itself proves nothing.
    """
    gates={}
    try:
        identity=_installed_identity()
        if not isinstance(approval,str) or not _RELEASE.fullmatch(approval): raise ValueError("approval")
        if not isinstance(canary_evidence,str) or not _RELEASE.fullmatch(canary_evidence): raise ValueError("canary evidence")
        if not isinstance(candidate_contract_sha256,str) or not _CONTRACT.fullmatch(candidate_contract_sha256): raise ValueError("candidate_digest_absent")
        # The lock is taken before the runtime is loaded, so it is already held when
        # `deploy_runtime._precheck()` reads the eight containers: a second executor
        # cannot pass its own precondition check while this one is mutating them, and
        # it fails before it has spent anything on the attempt.
        with _environment_lock():
            runtime=_load_deploy(); collector=_load_collector(); artifact=_load_artifact()
            gates=runtime.run_deploy(release,candidate,package,expected,binding,runner or collector.ProductionRunner(),collector,artifact,candidate_contract_sha256)
        record={key:gates.pop(key) for key in ("deploy_record_schema_version","deploy_record_id","deploy_record_sha256")}
        verified_digest=gates.pop("candidate_contract_sha256",None)
        if not isinstance(verified_digest,str) or not _CONTRACT.fullmatch(verified_digest): raise ValueError("candidate_digest_unverified")
        out=_document("SUCCESS",release,candidate,expected,gates,"DEPLOY_OK",identity); out["action_id"]="HK_STAGING_DEPLOY"; out.update(record); out["candidate_contract_sha256"]=verified_digest; return out,0
    except (OSError,ValueError,TypeError) as exc:
        # A refusal that already knows its gate results reports them.  `MEDIA_MOUNT=FAILED`
        # and its reason are findings about the operation rather than sentences to be read
        # out of an error string, and keeping them here is what makes
        # `DEPLOY=SUCCESS` with `MEDIA_MOUNT=FAILED` unrepresentable.
        gates=getattr(exc,"gate_results",None) or gates
        out=_document("REJECTED",release,candidate,expected,gates,"DEPLOY_REJECTED"); out["action_id"]="HK_STAGING_DEPLOY"; out["error_code"]=str(exc)[:80]; return out,2

def _canary(release_id,candidate_image_id,candidate_package_sha256,expected_current_image_id,runner=None,inputs=None):
    gates={}
    try:
        identity=_installed_identity()
        runtime=_load_canary(); artifact=_load_artifact()
        gates=runtime.run_canary(release_id,candidate_image_id,candidate_package_sha256,expected_current_image_id,runner,inputs,artifact)
        output=_document("SUCCESS",release_id,candidate_image_id,expected_current_image_id,gates,"CANARY_OK",identity)
        output["action_id"]="HK_STAGING_CANARY"
        return output,0
    except (OSError,ValueError,TypeError) as exc:
        output=_document("REJECTED",release_id,candidate_image_id,expected_current_image_id,gates,"CANARY_REJECTED")
        output["action_id"]="HK_STAGING_CANARY"; output["error_code"]=str(exc)[:80]
        return output,2

def _rollback(release,source_task_id,binding,runner=None):
    gates={}
    try:
        identity=_installed_identity()
        # A rollback mutates the same eight containers as a deployment, so it takes the
        # same environment lock: `deploy` and `rollback` share one slot, and a rollback
        # cannot start while a deployment is mid-flight (nor the reverse).
        with _environment_lock():
            runtime=_load_rollback(); collector=_load_collector()
            gates=runtime.run_rollback(release,source_task_id,binding,runner or collector.ProductionRunner(),collector)
        out=_document("SUCCESS",release,"","",gates,"ROLLBACK_OK",identity); out["action_id"]="HK_STAGING_ROLLBACK"
        out.update({key:gates[key] for key in ("source_deploy_task_id","source_deploy_record_id","source_deploy_record_sha256","rollback_record_id","rollback_record_sha256")})
        return out,0
    except (OSError,ValueError,TypeError) as exc:
        gates=getattr(exc,"gate_results",None) or gates
        out=_document("REJECTED",release,"","",gates,"ROLLBACK_REJECTED"); out["action_id"]="HK_STAGING_ROLLBACK"; out["error_code"]=str(exc)[:80]
        return out,2


def _verify(release_id, candidate_image_id, expected_current_image_id,
            runner=None, inputs=None, sleeper=None):
    gates = {}
    try:
        identity = _installed_identity()
        if not isinstance(release_id, str) or not _RELEASE.fullmatch(release_id):
            raise ValueError("release id")
        if not isinstance(candidate_image_id, str) or not _IMAGE.fullmatch(candidate_image_id):
            raise ValueError("candidate image")
        if not isinstance(expected_current_image_id, str) or not _IMAGE.fullmatch(expected_current_image_id):
            raise ValueError("expected image")
        collector = _load_collector()
        result = collector._collect_verify(
            runner or collector.ProductionRunner(),
            candidate_image_id,
            expected_current_image_id,
            inputs or collector._PRODUCTION_VERIFY_INPUTS,
            sleeper or __import__("time").sleep,
        )
        gates = {
            "compose_baseline": "PASS",
            "env_baseline": "PASS",
            "candidate_image": "PASS",
            "expected_current_image": "PASS",
            "api_health": "PASS",
            "worker_process_liveness": "PASS",
            "application_health_proven": False,
            "alembic_current": "PASS",
            "alembic_head": "PASS",
        }
        if result["target_service_count"] != 8 or result["application_health_proven_count"] != 0:
            raise ValueError("collector result")
        return _document("SUCCESS", release_id, candidate_image_id,
                         expected_current_image_id, gates, "VERIFY_OK",
                         identity), 0
    except (OSError, ValueError, TypeError):
        return _document("REJECTED", release_id, candidate_image_id,
                         expected_current_image_id, gates, "VERIFY_REJECTED"), 2


def main(argv=None, runner=None, inputs=None, sleeper=None):
    values = list(sys.argv[1:] if argv is None else argv)
    canary = values[:1] == ["canary"]
    deploy = values[:1] == ["deploy"]
    rollback=values[:1]==["rollback"]
    expected_flags = ["--release-id","--candidate-image-id","--candidate-package-sha256","--expected-current-image-id","--canary-evidence-id","--approval-id","--candidate-contract-sha256","--task-id","--task-nonce","--task-authority","--task-canonical-sha256"] if deploy else (["--release-id","--source-deploy-task-id","--approval-id","--task-id","--task-nonce","--task-authority","--task-canonical-sha256"] if rollback else (["--release-id","--candidate-image-id","--candidate-package-sha256","--expected-current-image-id"] if canary else ["--release-id","--candidate-image-id","--expected-current-image-id"]))
    if (values[0:1] not in (["verify"],["canary"],["deploy"],["rollback"]) or len(values) != 1+2*len(expected_flags) or values[1::2] != expected_flags):
        release = values[2] if len(values) > 2 and values[1] == "--release-id" else ""
        output = _document("REJECTED", release, "", "", {}, "VERIFY_REJECTED")
        print(json.dumps(output, separators=(",", ":")))
        return 2
    if values[0]=="canary": output, code = _canary(values[2], values[4], values[6], values[8], runner, inputs)
    elif values[0]=="deploy": output, code = _deploy(values[2],values[4],values[6],values[8],values[12],values[10],values[14],{"task_id":values[16],"nonce":values[18],"authority":values[20],"canonical_sha256":values[22]},runner)
    elif values[0]=="rollback": output, code = _rollback(values[2],values[4],{"task_id":values[8],"nonce":values[10],"authority":values[12],"canonical_sha256":values[14]},runner)
    else: output, code = _verify(values[2], values[4], values[6], runner, inputs, sleeper)
    print(json.dumps(output, separators=(",", ":")))
    return code


if __name__ == "__main__":
    raise SystemExit(main())
